import {Head, Link} from "velar/web"
import {CodeBlock, Callout, DocsShell, PageHeader, Prose} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {docsNav} from "../content.vel"

const stateCode = "component Counter(start: number = 0):\n    state count = start\n    computed doubled = count * 2\n\n    def increment():\n        count += 1\n\n    return <button on:click={increment}>\n        {count} / {doubled}\n    </button>"
const watchCode = "watch query as current, previous:\n    print(f\"{previous} -> {current}\")\n\nasync def updateAndMeasure():\n    expanded = true\n    await tick()\n    const bounds = measure(panel)"
const lifecycleCode = "import {environment, watchOnline} from \"velar/browser\"\nimport {announce} from \"velar/web\"\n\ncomponent OnlineStatus:\n    state online = environment().online\n\n    def updateOnline(value: bool):\n        online = value\n\n    const stopOnline = watchOnline(updateOnline)\n\n    mounted:\n        announce(\"Status ready\")\n\n    cleanup:\n        stopOnline()\n\n    return <output>{online ? \"Online\" : \"Offline\"}</output>"
const resourceCode = "component TicketList:\n    resource catalog: List<Ticket> = loadTickets()\n    computed failure = catalog.error\n\n    def content() -> WebNode:\n        if catalog.loading:\n            return <p aria-busy=\"true\">Loading…</p>\n        if failure:\n            return <p role=\"alert\">{failure.message}</p>\n        if catalog.value:\n            return <TicketTable tickets={catalog.value} />\n        return <p>No tickets</p>\n\n    return <main>\n        {content()}\n        <button type=\"button\" on:click={catalog.reload}>Reload</button>\n    </main>"
const actionCode = "import {announce} from \"velar/web\"\n\ncomponent SaveButton(draft: Draft):\n    action save() -> Receipt:\n        return await submit(draft)\n\n    async def saveWithRecovery():\n        try:\n            await save()\n        catch error:\n            announce(error.message, \"assertive\")\n\n    return <button disabled={save.pending} on:click={saveWithRecovery}>\n        {save.pending ? \"Saving…\" : \"Save\"}\n    </button>"

export component WebReactivity:
    const locale = useLocale()
    return <main>
        <Head title={locale.text("State and lifecycle · VelarScript", "状态与生命周期 · VelarScript")} description={locale.text("VelarScript Web state, computed values, watches, DOM scheduling, mounted, cleanup, resources, actions, and application error ownership.", "VelarScript Web 的状态、计算值、监听、DOM 调度、mounted、cleanup、资源、动作与应用错误所有权。")} themeColor="#f7f5f0" />
        <DocsShell items={docsNav}>
            <PageHeader kicker={locale.text("Web framework / 02", "Web 框架 / 02")} title={locale.text("Updates are direct; ownership stays visible.", "更新直接发生，所有权始终可见。")} summary={locale.text("Setup runs once. State drives precise DOM work. Resources and actions model common asynchronous UI work, and cleanup remains a sibling lifecycle block.", "初始化只运行一次。状态驱动精确 DOM 工作；resource 与 action 建模常见异步界面工作；cleanup 保持为并列生命周期块。")} tags={["state", "computed", "resource", "action"]} />
            <Prose>
                <h2 id="state">{locale.text("State and computed values", "状态与计算值")}</h2>
                <CodeBlock code={stateCode} />
                <p><code>state</code>{locale.text(" declares mutable reactive data. ", " 声明可变响应式数据；")}<code>computed</code>{locale.text(" declares a cached pure value derived from reactive reads. State is not a deep Proxy: assigning the state binding publishes an update, while mutating a nested record, List, Set, or Map does not. Mutable state references cannot be aliased, returned, passed to ordinary helpers, or supplied as component props; use a derived value or copy() at that boundary. Changing state does not rerun component setup.", " 声明从响应式读取派生的缓存纯值。状态不是深层 Proxy：给 state 绑定赋值会发布更新，修改嵌套记录、List、Set 或 Map 则不会。可变状态引用不能被起别名、返回、传给普通辅助函数或作为组件属性继续传递；应在边界处使用派生值或 copy()。状态变化不会重新运行组件初始化。")}</p>

                <h2 id="scheduling">{locale.text("Watch and DOM scheduling", "监听与 DOM 调度")}</h2>
                <CodeBlock code={watchCode} />
                <p>{locale.text("A ", "")}<code>watch expression</code>{locale.text(" observes exactly that expression, not an implicit deep traversal. It skips initial setup, coalesces synchronous changes, and runs after related DOM commit by default. Optional ", " 只观察该表达式，不做隐式深层遍历。它跳过首次初始化、合并同步变化，并默认在相关 DOM 提交后运行。可选 ")}<code>as current, previous</code>{locale.text(" makes change values explicit.", " 让变化值明确可见。")}</p>
                <p>{locale.text("State writes are visible to source immediately; DOM commits batch until the synchronous task ends. ", "状态写入对源码立即可见；DOM 提交会批处理到当前同步任务结束。")}<code>await tick()</code>{locale.text(" waits for managed DOM to reflect current state.", " 等待受管理 DOM 反映当前状态。")}</p>

                <h2 id="lifecycle">{locale.text("Mounted and cleanup", "Mounted 与 cleanup")}</h2>
                <CodeBlock code={lifecycleCode} />
                <ul>
                    <li><code>mounted</code>{locale.text(" runs once after managed DOM insertion and may await initialization.", " 在受管理 DOM 插入后运行一次，并可等待初始化。")}</li>
                    <li><code>cleanup</code>{locale.text(" runs synchronously once before destruction.", " 在销毁前同步运行一次。")}</li>
                    <li>{locale.text("They are sibling blocks. Cleanup is never returned from or nested inside mounted/watch.", "两者是并列代码块。cleanup 不会从 mounted/watch 返回，也不嵌套在其中。")}</li>
                    <li>{locale.text("Acquire explicit stop/close handles during setup or mounted and release each in cleanup.", "在初始化或 mounted 中获取显式 stop/close 句柄，并在 cleanup 中逐一释放。")}</li>
                    <li>{locale.text("Cleanup steps continue independently after one fails, and every failure enters the application error channel.", "某一步清理失败后，其他步骤仍独立继续；每个失败都会进入应用错误通道。")}</li>
                </ul>
                <Callout title={locale.text("No source-level effect", "源码层没有 effect")}><p>{locale.text("The compiler uses internal reactive effects, but ", "编译器内部使用响应式 effect，但 ")}<code>effect</code>{locale.text(" is not an application API. Visible ", " 不是应用 API。可见的 ")}<code>watch</code>, <code>mounted</code>, <code>cleanup</code>, <code>resource</code>{locale.text(", and ", " 与 ")}<code>action</code>{locale.text(" each own one clear job.", " 各自只负责一个明确任务。")}</p></Callout>

                <h2 id="resource">{locale.text("Resources for component data", "组件数据资源")}</h2>
                <CodeBlock code={resourceCode} />
                <p>{locale.text("A resource initializer returns ", "resource 初始化器返回 ")}<code>Promise&lt;T&gt;</code>{locale.text("; its annotation names ", "，标注写 ")}<code>T</code>{locale.text(". It exposes ", "。绑定暴露 ")}<code>value: T?</code>, <code>loading</code>, <code>ready</code>, <code>error: Error?</code>{locale.text(", and ", " 与 ")}<code>reload()</code>{locale.text(". It starts after mount, tracks no dependencies implicitly, retains the last good value while reloading, publishes only the newest generation, and ignores completion after destruction.", "。它在挂载后启动，不隐式跟踪依赖；重载时保留最后可用值，只发布最新代结果，并忽略销毁后的完成。")}</p>
                <p>{locale.text("Failures normalize to Error and report through ", "失败会规范化为 Error，并通过 ")}<code>velar/app</code>{locale.text(" phase ", " 的 ")}<code>resource</code>{locale.text(". Runtime does not pretend to cancel arbitrary Promises; it prevents obsolete completion from publishing.", " 阶段报告。运行时不会假装能取消任意 Promise，而是阻止过时完成结果发布。")}</p>

                <h2 id="action">{locale.text("Actions for user operations", "用户操作 action")}</h2>
                <CodeBlock code={actionCode} />
                <p>{locale.text("An ", "")}<code>action</code>{locale.text(" is an implicitly async component function with typed parameters/defaults/rest/result and reactive ", " 是隐式异步组件函数，拥有类型化参数、默认值、剩余参数、结果，以及响应式 ")}<code>pending</code>{locale.text(" and ", " 与 ")}<code>error</code>{locale.text(" fields. Pending remains true while any call runs, a new call clears old error, and only the newest call publishes failure.", " 字段。任意调用运行时 pending 保持 true，新调用会清除旧错误，只有最新调用能发布失败。")}</p>
                <p>{locale.text("Success resolves to the declared value. Failure is normalized to ", "成功会解析为声明值。失败会规范化为 ")}<code>Error</code>{locale.text(", published through the action's reactive ", "，发布到 action 的响应式 ")}<code>error</code>{locale.text(" field, reported through ", " 字段并通过 ")}<code>velar/app</code>{locale.text(", and still rejects the call. Nothing turns a failed operation into a successful empty result. Wrap ", " 报告，同时调用仍然拒绝。失败操作绝不会被转换成成功空结果；当调用方拥有恢复逻辑时，用 ")}<code>await action()</code>{locale.text(" in ordinary ", " 配合普通 ")}<code>try</code>/<code>catch</code>{locale.text(" when the caller owns recovery.", "。")}</p>

                <h2 id="errors">{locale.text("Transactional recovery", "事务式恢复")}</h2>
                <p>{locale.text("Component setup and initial JSX construction are transactional. If construction fails after acquiring a timer, watcher, or connection, sibling cleanup runs before the error continues. Branch and keyed updates build replacements before commit, so failures retain last valid DOM. Mount, render, watch, event, mounted, cleanup, timer, storage, and realtime failures share ", "组件初始化与首次 JSX 构造是事务性的。如果获取定时器、监听器或连接后构造失败，并列 cleanup 会在原错误继续前运行。分支与带键更新先构建替代内容再提交，因此失败会保留最后有效 DOM。mount、render、watch、event、mounted、cleanup、timer、storage 与 realtime 失败共享 ")}<code>velar/app</code>{locale.text(".", "。")}</p>

                <div class="next-links"><Link to="/docs/web/routing"><strong>{locale.text("Next: Routing and metadata", "下一步：路由与元数据")}</strong><span>{locale.text("Give component lifetimes an application structure.", "为组件生命周期赋予应用结构。")}</span></Link><Link to="/docs/web/data"><strong>{locale.text("Forms, HTTP and storage", "表单、HTTP 与存储")}</strong><span>{locale.text("Connect state to trusted external boundaries.", "把状态连接到可信外部边界。")}</span></Link></div>
            </Prose>
        </DocsShell>
    </main>
