import {Head, Link} from "velar/web"
import {CodeBlock, Callout, DocsShell, PageHeader, Prose} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {docsNav} from "../content.vel"

const treeCode = "my-app/\n├── src/\n│   ├── main.vel\n│   ├── app.vel\n│   ├── app.test.vel\n│   └── app.browser.test.vel\n├── public/\n├── velar.json\n├── package.json\n└── package-lock.json"
const manifestCode = "{\n  \"formatVersion\": 2,\n  \"entry\": \"src/main.vel\",\n  \"outDir\": \"dist\",\n  \"publicDir\": \"public\",\n  \"extensions\": [\"@velarscript/web\"],\n  \"web\": {\n    \"title\": \"My App\",\n    \"base\": \"/\",\n    \"publicConfig\": {\"apiBase\": \"/api\"},\n    \"build\": {\"sourceMaps\": false},\n    \"security\": {\"contentSecurityPolicy\": true},\n    \"deployment\": {\"spaFallback\": true, \"adapter\": \"neutral\"}\n  }\n}"
const packageCode = "velar install\nvelar add chart-library\nvelar add test-helper --dev\nvelar update\nvelar remove chart-library"
const commandsCode = "velar dev\nvelar format --check\nvelar check\nvelar test\nvelar test --browser all\nvelar build\nvelar verify\nvelar preview\nvelar verify-deployment --url https://app.example.com"
const libraryCode = "{\n  \"name\": \"my-velar-library\",\n  \"version\": \"1.0.0\",\n  \"velar\": {\"entry\": \"src/index.vel\"},\n  \"files\": [\"src\"]\n}"

export component DocsProject:
    const locale = useLocale()
    return <main>
        <Head title={locale.text("Project and CLI · VelarScript", "项目与 CLI · VelarScript")} description={locale.text("VelarScript project structure, manifest, package workflow, templates, CLI commands, and source packages.", "VelarScript 的项目结构、清单、包工作流、模板、CLI 命令与源码包。")} themeColor="#f7f5f0" />
        <DocsShell items={docsNav}>
            <PageHeader kicker={locale.text("Start / 02", "开始 / 02")} title={locale.text("One project contract, from editor to production.", "从编辑器到生产环境，共用一份项目契约。")} summary={locale.text("The manifest selects language extensions and production behavior; npm owns dependencies; the local VelarScript CLI owns checking, testing, building, and verification.", "清单选择语言扩展与生产行为，npm 管理依赖，本地 VelarScript CLI 负责检查、测试、构建与验证。")} tags={["format 2", "local toolchain", "npm packages", "verified builds"]} />
            <Prose>
                <h2 id="structure">{locale.text("Project structure", "项目结构")}</h2>
                <CodeBlock code={treeCode} />
                <p>{locale.text("Keep authored VelarScript in ", "把编写的 VelarScript 放在 ")}<code>src</code>{locale.text(", browser-served static files in ", "，浏览器静态文件放在 ")}<code>public</code>{locale.text(", and generated output in ", "，生成产物放在 ")}<code>dist</code>{locale.text(". Tests live beside the modules they exercise and are discovered recursively by suffix.", "。测试与被测模块放在一起，并按文件后缀递归发现。")}</p>

                <h2 id="manifest">{locale.text("The velar.json manifest", "velar.json 清单")}</h2>
                <CodeBlock code={manifestCode} />
                <ul>
                    <li><code>formatVersion</code>{locale.text(" is exactly 2. Legacy and unknown future formats fail closed.", " 必须等于 2；旧格式和未知未来格式都会封闭失败。")}</li>
                    <li><code>entry</code>, <code>outDir</code>{locale.text(", and ", " 与 ")}<code>publicDir</code>{locale.text(" are project-confined paths.", " 都必须限制在项目内。")}</li>
                    <li><code>extensions</code>{locale.text(" activates compiler/framework contracts. Core projects use an empty list; Web projects declare ", " 激活编译器/框架契约。Core 项目使用空列表；Web 项目声明 ")}<code>@velarscript/web</code>{locale.text(".", "。")}</li>
                    <li><code>web.base</code>{locale.text(" is the canonical application path shared by routing, assets, development, preview, and deployment.", " 是路由、资源、开发、预览与部署共用的规范应用路径。")}</li>
                    <li><code>publicConfig</code>{locale.text(" contains public build-time values only. It never reads secrets or environment variables implicitly.", " 只包含公开的构建期值，绝不会隐式读取密钥或环境变量。")}</li>
                    <li><code>sourceMaps</code>{locale.text(" is intentionally opt-in for production.", " 在生产环境中必须显式开启。")}</li>
                    <li><code>contentSecurityPolicy</code>{locale.text(" and ", " 与 ")}<code>spaFallback</code>{locale.text(" become verifiable deployment contracts.", " 会成为可验证的部署契约。")}</li>
                </ul>
                <Callout title={locale.text("Unknown fields are errors", "未知字段会报错")}><p>{locale.text("A misspelled manifest option never silently falls back to a default. The project contract is small enough to validate completely.", "拼错的清单选项不会悄悄回退到默认值。项目契约足够小，因此可以完整验证。")}</p></Callout>

                <h2 id="packages">{locale.text("Package workflow", "包工作流")}</h2>
                <CodeBlock code={packageCode} />
                <p>{locale.text("These commands delegate registry resolution and lockfile changes to npm, then synchronize extension activation from package metadata. They accept registry package names and versions, not arbitrary shell flags, Git URLs, aliases, or local paths. Initial project installation remains the explicit ", "这些命令把注册表解析和锁文件修改交给 npm，再根据包元数据同步扩展激活状态。它们接受注册表包名与版本，不接受任意 shell 参数、Git URL、别名或本地路径。首次安装仍然是显式的 ")}<code>npm install</code>{locale.text(" step.", " 步骤。")}</p>

                <h2 id="commands">{locale.text("Everyday commands", "日常命令")}</h2>
                <CodeBlock code={commandsCode} />
                <ul>
                    <li><code>dev</code>{locale.text(" runs the extension-provided development host and last-good-build overlay.", " 运行扩展提供的开发宿主与最后可用构建覆盖层。")}</li>
                    <li><code>format</code>{locale.text(" owns project-wide ", " 负责整个项目的 ")}<code>.vel</code>{locale.text(" formatting.", " 格式化。")}</li>
                    <li><code>check</code>{locale.text(" runs the compiler semantics also used by the language server.", " 运行语言服务器同样使用的编译器语义。")}</li>
                    <li><code>test</code>{locale.text(" runs ", " 运行 ")}<code>.test.vel</code>; <code>--browser</code>{locale.text(" runs ", " 运行 ")}<code>.browser.test.vel</code>{locale.text(".", "。")}</li>
                    <li><code>build</code>{locale.text(" creates deterministic hashed output and manifests in an isolated staging directory.", " 在隔离暂存目录中创建确定性的哈希产物与清单。")}</li>
                    <li><code>verify</code>{locale.text(" refuses modified, missing, extra, or contract-incompatible build files.", " 拒绝被修改、缺失、多余或契约不兼容的构建文件。")}</li>
                    <li><code>preview</code>{locale.text(" serves only verified output with declared base, headers, MIME types, and fallback.", " 只按声明的 base、响应头、MIME 类型与回退规则提供已经验证的产物。")}</li>
                    <li><code>verify-deployment</code>{locale.text(" compares the verified local build with an HTTPS deployment byte-for-byte.", " 逐字节比较已验证的本地构建与 HTTPS 部署。")}</li>
                    <li><code>lsp</code>{locale.text(" exposes diagnostics, completion, hover, definition, references, rename, semantic tokens, and checked fixes to any editor host.", " 向任意编辑器宿主提供诊断、补全、悬停、定义、引用、重命名、语义令牌与受检查修复。")}</li>
                </ul>

                <h2 id="templates">{locale.text("Templates", "模板")}</h2>
                <p><code>web</code>{locale.text(" creates a routing-ready browser application. ", " 创建支持路由的浏览器应用；")}<code>docs</code>{locale.text(" creates a documentation-oriented Web project. ", " 创建面向文档的 Web 项目；")}<code>library</code>{locale.text(" creates a Core source package. ", " 创建 Core 源码包；")}<code>component</code>{locale.text(" creates a Web component package with a separate preview app and explicit Web peer contract. The future ", " 创建带独立预览应用和明确 Web peer 契约的组件包。未来的 ")}<code>game</code>{locale.text(" name is reserved and intentionally unavailable.", " 名称已保留，目前有意不开放。")}</p>

                <h2 id="source-packages">{locale.text("VelarScript source packages", "VelarScript 源码包")}</h2>
                <CodeBlock code={libraryCode} />
                <p>{locale.text("A reusable package publishes ", "可复用包通过 ")}<code>velar.entry</code>{locale.text(" to expose ", " 发布 ")}<code>.vel</code>{locale.text(" source. The consumer's compiler resolves, checks, and bundles it inside the project graph. Relative imports cannot escape the package root. VelarScript does not invent a private registry or second declaration format.", " 源码。消费方编译器会在项目图中解析、检查并打包它。相对导入不能逃出包根目录。VelarScript 不发明私有注册表或第二套声明格式。")}</p>

                <div class="next-links"><Link to="/docs/language"><strong>{locale.text("Next: Syntax and values", "下一步：语法与值")}</strong><span>{locale.text("Read the source language from its smallest pieces.", "从最小组成部分开始理解源码语言。")}</span></Link><Link to="/docs/testing"><strong>{locale.text("Testing and deployment", "测试与部署")}</strong><span>{locale.text("Follow the complete production path.", "走完整条生产交付路径。")}</span></Link></div>
            </Prose>
        </DocsShell>
    </main>
