import {Head, Link} from "velar/web"
import {CodeBlock, Callout, DocsShell, PageHeader, Prose} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {docsNav} from "../content.vel"

const firstRunCode = "npm create velar@latest my-app\ncd my-app\nnpm install\nnpm run dev"
const stackCode = "VelarScript source (.vel)\n        ↓\nVelar Compiler + @velarscript/web\n        ↓\nModern JavaScript + extracted CSS + Web assets\n        ↓\nExisting browser JavaScript engine"

export component DocsOverview:
    const locale = useLocale()
    return <main data-docs-page>
        <Head title={locale.text("Documentation · VelarScript", "文档 · VelarScript")} description={locale.text("Complete VelarScript documentation: start a project, learn the language, use every Core and Web module, test, build, and deploy.", "完整的 VelarScript 文档：创建项目、学习语言、使用 Core 与 Web 模块，并完成测试、构建和部署。")} themeColor="#f7f5f0" />
        <DocsShell items={docsNav}>
            <PageHeader kicker={locale.text("Documentation", "文档")} title={locale.text("Learn the whole stack, from first value to verified deployment.", "从第一个值开始，学到经过验证的部署。")} summary={locale.text("These guides describe the implemented language and framework contract—not a conceptual mockup. Every chapter uses the syntax and modules exercised by real VelarScript applications.", "这些指南描述的是已经实现的语言与框架契约，而不是概念模型。每一章都使用真实 VelarScript 应用正在验证的语法与模块。")} tags={["Language 0.9", "Core API 0.4", "Web API 0.9", "Node 24+"]} />
            <Prose>
                <h2 id="start">{locale.text("Start here", "从这里开始")}</h2>
                <CodeBlock code={firstRunCode} />
                <p>{locale.text("The ", "")}<Link to="/docs/getting-started">{locale.text("getting-started guide", "快速开始指南")}</Link>{locale.text(" creates a Web project, explains every generated file, builds a component, and walks through development, tests, build, verification, and preview. ", "会创建 Web 项目、解释每个生成文件、构建组件，并贯穿开发、测试、构建、验证与预览。随后，")}<Link to="/docs/project">{locale.text("Project and CLI", "项目与 CLI")}</Link>{locale.text(" then covers the complete manifest, npm-backed package workflow, templates, commands, and source packages.", "会讲解完整清单、由 npm 支撑的包工作流、模板、命令与源码包。")}</p>

                <h2 id="language">{locale.text("Learn the language in order", "按顺序学习语言")}</h2>
                <ol>
                    <li><Link to="/docs/language">{locale.text("Syntax and values", "语法与值")}</Link> — {locale.text("runtime facts, const/let, primitives, none, optional chains, strict conditions, operators, conversion, and objects.", "运行时事实、const/let、基础值、none、可选链、严格条件、运算符、转换与对象。")}</li>
                    <li><Link to="/docs/language/types">{locale.text("Types and data", "类型与数据")}</Link> — {locale.text("records, aliases, functions, optionals, recursive types, unions, enums, inference, and runtime parse/is.", "记录、别名、函数、可选类型、递归类型、联合、枚举、推断与运行时 parse/is。")}</li>
                    <li><Link to="/docs/language/functions">{locale.text("Functions and flow", "函数与控制流")}</Link> — {locale.text("def, arrows, async/await, rest parameters, if/else if, loops, match, Error, try/catch/finally, and assert.", "def、箭头函数、async/await、剩余参数、if/else if、循环、match、Error、try/catch/finally 与 assert。")}</li>
                    <li><Link to="/docs/language/collections">{locale.text("Collections", "集合")}</Link> — {locale.text("List, Map, Set, mutation, snapshots, iteration, functional transforms, and velar/collections.", "List、Map、Set、修改、快照、迭代、函数式变换与 velar/collections。")}</li>
                    <li><Link to="/docs/language/classes">{locale.text("Classes", "类")}</Link> — {locale.text("construction, fields, init, methods, getters, private/static members, inheritance, abstract contracts, override, super, and Error subclasses.", "构造、字段、init、方法、getter、私有/静态成员、继承、抽象契约、override、super 与 Error 子类。")}</li>
                    <li><Link to="/docs/language/modules">{locale.text("Modules and JavaScript", "模块与 JavaScript")}</Link> — {locale.text("static/dynamic VelarScript modules, npm source packages, declaration bridging, extern modules, safe unknown, and explicit unsafe adapters.", "静态/动态 VelarScript 模块、npm 源码包、声明桥接、extern 模块、安全的 unknown 与显式 unsafe 适配器。")}</li>
                </ol>

                <h2 id="web">{locale.text("Build Web applications", "构建 Web 应用")}</h2>
                <ol>
                    <li><Link to="/docs/web">{locale.text("Web overview", "Web 概览")}</Link> — {locale.text("extension boundary, runtime model, capability modules, and deliberate platform scope.", "扩展边界、运行时模型、能力模块与明确的平台范围。")}</li>
                    <li><Link to="/docs/web/components">{locale.text("Components and JSX", "组件与 JSX")}</Link> — {locale.text("checked props/children, native HTML/SVG, conditional views, keyed lists, events, bindings, refs, and Look.", "受检查的属性/子内容、原生 HTML/SVG、条件视图、带键列表、事件、绑定、引用与 Look。")}</li>
                    <li><Link to="/docs/web/reactivity">{locale.text("State and lifecycle", "状态与生命周期")}</Link> — {locale.text("state, computed, watch, tick, mounted, cleanup, resources, actions, and transactional recovery.", "state、computed、watch、tick、mounted、cleanup、资源、动作与事务恢复。")}</li>
                    <li><Link to="/docs/web/routing">{locale.text("Routing and metadata", "路由与元数据")}</Link> — {locale.text("patterns, RouteContext, Router, Link/NavLink, navigation, Head, lazy chunks, live announcements, and DOM IDs.", "模式、RouteContext、Router、Link/NavLink、导航、Head、懒加载分块、实时播报与 DOM ID。")}</li>
                    <li><Link to="/docs/web/data">{locale.text("Forms, HTTP and storage", "表单、HTTP 与存储")}</Link> — {locale.text("public config, bounded requests, strict JSON, multipart uploads, typed form decoding, accessible errors, local/session storage, and IndexedDB.", "公开配置、有界请求、严格 JSON、多段上传、类型化表单解码、无障碍错误、本地/会话存储与 IndexedDB。")}</li>
                    <li><Link to="/docs/web/browser">{locale.text("Browser capabilities", "浏览器能力")}</Link> — {locale.text("snapshots, timers, watchers, clipboard, layout, focus, dialogs, files, WebSocket/SSE, and application error ownership.", "快照、定时器、监听器、剪贴板、布局、焦点、对话框、文件、WebSocket/SSE 与应用错误所有权。")}</li>
                </ol>

                <h2 id="reference">{locale.text("Use every official module", "使用每个官方模块")}</h2>
                <p>{locale.text("The ", "")}<Link to="/docs/core">{locale.text("Core module reference", "Core 模块参考")}</Link>{locale.text(" lists every public group in ", "列出并解释 ")}<code>velar/collections</code>, <code>velar/text</code>, <code>velar/math</code>, <code>velar/json</code>, <code>velar/async</code>, <code>velar/url</code>, <code>velar/time</code>, <code>velar/id</code>{locale.text(", and ", " 与 ")}<code>velar/log</code>{locale.text(". Web modules are explained by ownership across six Web chapters instead of as disconnected function names.", " 中的全部公开分组。Web 模块则按所有权分布在六个 Web 章节中，而不是被列成互不相干的函数名。")}</p>
                <p><Link to="/docs/testing">{locale.text("Testing and deployment", "测试与部署")}</Link>{locale.text(" completes the path with Core/browser matchers, the typed browser controller, three-engine runs, deterministic builds, local verification, preview, deployment manifests, and byte-for-byte remote verification.", "用 Core/浏览器 matcher、类型化浏览器控制器、三引擎运行、确定性构建、本地验证、预览、部署清单与逐字节远端验证补全交付路径。")}</p>

                <h2 id="runtime">{locale.text("Understand the boundary", "理解边界")}</h2>
                <CodeBlock code={stackCode} />
                <p>{locale.text("VelarScript does not replace browser memory, object identity, garbage collection, promises, the event loop, or JavaScript Number. It replaces the source surface and adds checked compiler/framework contracts around the platform.", "VelarScript 不替换浏览器的内存、对象身份、垃圾回收、Promise、事件循环或 JavaScript Number。它替换的是源码表面，并在平台周围增加受检查的编译器与框架契约。")}</p>
                <Callout title={locale.text("Language and framework are separate", "语言与框架彼此独立")}><p>{locale.text("Core projects contain no JSX, lifecycle, or browser surface. A format-2 project opts into ", "Core 项目不包含 JSX、生命周期或浏览器表面。format-2 项目显式启用 ")}<code>@velarscript/web</code>{locale.text(", which contributes those semantics and its own host behavior. The generic CLI remains independent.", "，由它注入这些语义及自己的宿主行为；通用 CLI 仍保持独立。")}</p></Callout>

                <h2 id="packages">{locale.text("Package ownership", "包的所有权")}</h2>
                <ul>
                    <li><strong>@velarscript/compiler</strong>{locale.text(" parses, resolves, checks, indexes, and compiles Core source.", " 负责解析、名称解析、检查、索引与编译 Core 源码。")}</li>
                    <li><strong>@velarscript/web</strong>{locale.text(" owns the Web compiler extension, browser runtime, host, JSX, components, Look, capability modules, and editor contribution.", " 拥有 Web 编译器扩展、浏览器运行时、宿主、JSX、组件、Look、能力模块与编辑器贡献。")}</li>
                    <li><strong>@velarscript/cli</strong>{locale.text(" owns generic command routing, filesystem/bundling mechanics, tests, verification, and language-server transport.", " 拥有通用命令路由、文件系统/打包机制、测试、验证与语言服务器传输。")}</li>
                    <li><strong>create-velar</strong>{locale.text(" creates transactional web/docs/library/component starters.", " 以事务方式创建 web/docs/library/component 起步项目。")}</li>
                    <li><strong>@velarscript/ui</strong>, <strong>@velarscript/site-ui</strong>{locale.text(", and ", " 与 ")}<strong>@velarscript/docs-kit</strong>{locale.text(" are this website's dogfood layers, not hidden compiler implementation.", " 是本官网真实自用的分层库，不是隐藏的编译器实现。")}</li>
                </ul>

                <div class="next-links"><Link to="/docs/getting-started"><strong>{locale.text("Begin the tutorial", "开始教程")}</strong><span>{locale.text("Create and understand your first complete project.", "创建并理解第一个完整项目。")}</span></Link><Link to="/docs/language"><strong>{locale.text("Read the language", "阅读语言文档")}</strong><span>{locale.text("Start with source syntax and runtime behavior.", "从源码语法与运行时行为开始。")}</span></Link></div>
            </Prose>
        </DocsShell>
    </main>
