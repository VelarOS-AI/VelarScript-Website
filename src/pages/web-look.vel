import {Head} from "velar/web"
import {BulletList, Callout, CodeBlock, DocsPager, DocsShell, MemberRow, MemberTable, PageHeader, Paragraph, Prose, SectionHeading, SectionList} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {guideNav, guideNext, guidePrevious, headTitle} from "../content.vel"

const buildersCode = `import {alpha, asset, border, clamp, color, darken, hsl, lighten, linearGradient, max, min, minmax, repeat, rgb, rgba, shadow, spacing, tracks, transition} from "velar/look"\nimport {Border, Color, Image, Length, Shadow, Spacing, Track, TrackList, Transition} from "velar/look"\n\n// Colour: five constructors and three adjustments.\nconst ink: Color = rgb(24, 31, 46)\nconst brand: Color = color("rebeccapurple")\nconst veiled: Color = rgba(24, 31, 46, 0.55)\nconst sky: Color = hsl(210, 70, 45)\nconst faded: Color = alpha(ink, 0.4)\nconst lifted: Color = lighten(ink, 0.2)\nconst sunk: Color = darken(ink, 0.2)\n\n// Composites: borders, shadows, images, and one transition.\nconst hairline: Border = border(1px, faded)\nconst dashedEdge: Border = border(2px, ink, "dashed")\nconst raised: Shadow = shadow(0px, 12px, 32px, veiled)\nconst pressed: Shadow = shadow(0px, 1px, 2px, veiled, spread=0px, inset=true)\nconst wash: Image = linearGradient(180deg, lifted, sunk)\nconst mark: Image = asset("/tour-mark.svg")\nconst fade: Transition = transition("opacity", 200ms, "ease-in-out", 50ms)\n\n// Layout: track lists, spacing in one to four steps, and the three length\n// functions.\nconst flexibleTrack: Track = minmax(120px, 1fr)\nconst threeUp: TrackList = repeat(3, flexibleTrack)\nconst explicitTracks: TrackList = tracks(200px, 1fr, minmax(80px, 240px))\nconst inset: Spacing = spacing(16px, 20px)\nconst narrow: Length = min(16px, 2rem)\nconst wide: Length = max(16px, 2rem)\nconst fluid: Length = clamp(1rem, 4vw, 3rem)\n\n// A builder is an ordinary value: it may be aliased, passed to another\n// function, returned, and called outside a Look block.\nconst makeColor = rgb\n\ndef buildRamp(build: (number, number, number) -> Color) -> List<Color>:\n    return [build(45, 79, 190), build(90, 120, 220)]\n\nconst ramp: Color = makeColor(45, 79, 190)\nconst rampColors: List<Color> = buildRamp(rgb)\n\nexport const panelLook = look:\n    display = "grid"\n    gridTemplateColumns = threeUp\n    gridTemplateRows = explicitTracks\n    gap = narrow\n    width = fluid\n    maxWidth = wide\n    padding = inset\n    color = ink\n    background = wash\n    backgroundImage = mark\n    backgroundColor = brand\n    border = hairline\n    outline = dashedEdge\n    boxShadow = raised\n    textShadow = pressed\n    accentColor = ramp\n    fill = sky\n    transition = fade\n    caretColor = rampColors[0]`
const unitsCode = `import {tracks} from "velar/look"\nimport {Angle, Duration, Length, LengthPercentage, Percentage, TrackFraction} from "velar/look"\n\n// All thirteen unit suffixes. They belong to the language and need no import,\n// and they are ordinary reusable values outside a Look block.\nconst gutter: Length = 16px\nconst rootScale: Length = 1rem\nconst localScale: Length = 2em\nconst viewportPart: Length = 25vw\nconst viewportTall: Length = 40vh\nconst smallSide: Length = 10vmin\nconst largeSide: Length = 10vmax\nconst share: Percentage = 75%\nconst fraction: TrackFraction = 2fr\nconst quick: Duration = 200ms\nconst slow: Duration = 1s\nconst quarterTurn: Angle = 90deg\nconst halfTurn: Angle = 0.5turn\n\n// Unit arithmetic: addition and subtraction require the same visual dimension,\n// mixing Length and Percentage yields LengthPercentage, and a visual value may\n// be multiplied or divided by a finite number in either order.\nconst mixedMetric: LengthPercentage = share - gutter * 2\nconst doubled: Length = gutter * 2\nconst preDoubled: Length = 2 * gutter\nconst halved: Length = gutter / 2\nconst settle: Duration = slow + quick\nconst swept: Angle = halfTurn + quarterTurn\nconst shrunk: Percentage = share - 25%\n\nexport const measuredLook = look:\n    width = mixedMetric\n    minWidth = viewportPart\n    maxHeight = viewportTall\n    padding = doubled\n    paddingInline = preDoubled\n    gap = halved\n    fontSize = rootScale\n    letterSpacing = localScale / 32\n    marginInline = smallSide\n    marginBlock = largeSide\n    gridTemplateColumns = tracks(fraction, gutter)\n    rotate = swept\n    transitionDuration = settle\n    scrollMarginTop = shrunk`
const familiesCode = `import {border, minmax, repeat, rgb, shadow, spacing} from "velar/look"\n\nconst ink = rgb(24, 31, 46)\nconst veiled = rgb(200, 205, 215)\n\n// One property from each of the fourteen published families. CSS keyword values\n// are strings, because a bare identifier is a real VelarScript variable.\nexport const vocabularyLook = look:\n    // layout and containment\n    display = "grid"\n    position = "relative"\n    overflow = "hidden"\n    zIndex = 2\n\n    // grid\n    gridTemplateColumns = repeat(3, minmax(120px, 1fr))\n    gridAutoFlow = "row"\n\n    // flex and alignment\n    gap = 16px\n    alignItems = "center"\n    justifyContent = "space-between"\n\n    // size and inset\n    width = 100%\n    minWidth = 240px\n    top = 8px\n\n    // spacing\n    padding = spacing(16px, 20px)\n    marginBlock = 12px\n\n    // background\n    backgroundColor = veiled\n    backgroundRepeat = "no-repeat"\n\n    // border and outline\n    border = border(1px, veiled)\n    borderRadius = 14px\n    outlineOffset = 2px\n\n    // effects\n    boxShadow = shadow(0px, 12px, 32px, veiled)\n    opacity = 1\n\n    // typography and international text\n    color = ink\n    fontSize = 1rem\n    fontWeight = 600\n    lineHeight = 1.5\n    textAlign = "start"\n\n    // lists\n    listStyle = "none"\n\n    // SVG paint\n    fill = ink\n    strokeWidth = 2px\n\n    // transform and transition\n    rotate = 0deg\n    transitionDuration = 200ms\n\n    // interaction and form theme\n    cursor = "pointer"\n    userSelect = "none"\n\n    // scroll\n    scrollBehavior = "smooth"\n    scrollSnapAlign = "start"`
const propertyErrorCode = `const panelLook = look:\n    backgroundColour = "white"\n    padding = 8\n\nexport component Panel:\n    return <p look={panelLook}>a panel</p>`
const propertyErrorOutput = `main.vel:2:5 error VEL5038: Unknown Look property 'backgroundColour'; did you mean 'backgroundColor'?\n    backgroundColour = "white"\n    ^^^^^^^^^^^^^^^^^^^^^^^^^^\n\nmain.vel:3:15 error VEL5038: Look property 'padding' is a CSS length and requires a unit; write a unit value such as 16px, 1rem, or 50%\n    padding = 8\n              ^`
const conditionsCode = `import {darken, lighten, rgb, spacing} from "velar/look"\n\nconst ink = rgb(24, 31, 46)\nconst brand = rgb(45, 79, 190)\nconst sky = rgb(90, 140, 220)\nconst faded = lighten(ink, 0.4)\nconst sunk = darken(ink, 0.2)\nconst lifted = lighten(ink, 0.5)\n\n// The nine element states and the seven pseudo-element targets. Conditions may\n// appear inside a target and a target may appear inside a condition; a target\n// may not appear inside another target.\nexport const statefulLook = look:\n    background = brand\n    borderColor = ink\n\n    if @hover:\n        background = lighten(brand, 0.2)\n    if @focus:\n        outlineColor = sky\n    if @focusVisible:\n        outlineOffset = 3px\n    if @active:\n        opacity = 0.8\n    if @current:\n        fontWeight = 700\n    if @disabled:\n        opacity = 0.5\n    if @checked:\n        borderColor = sky\n    if @invalid:\n        borderColor = sunk\n    if @open:\n        maxHeight = "none"\n\n    @before:\n        content = "-"\n\n        if @hover:\n            content = ">"\n\n    @after:\n        content = ""\n        display = "block"\n    @backdrop:\n        background = faded\n    @placeholder:\n        color = faded\n    @selection:\n        background = faded\n    @marker:\n        color = ink\n    @fileSelectorButton:\n        cursor = "pointer"\n\n// Thresholds compare against compile-time px, rem, or em values, which may be a\n// local or imported const unit token or a field of a const token record.\nconst compact: Length = 720px\nconst breakpoints = {wide: 1200px}\n\n// The whole media vocabulary: viewport.width, viewport.height, scheme.dark,\n// scheme.light, and motion.reduced. Media subjects compose with element states\n// and with each other, and "not scheme.dark" is the same condition as\n// "scheme.light".\nexport const responsiveLook = look:\n    padding = spacing(16px, 20px)\n\n    if viewport.width <= compact:\n        padding = 12px\n    if viewport.height >= 600px:\n        marginBlock = 8px\n    if viewport.width > breakpoints.wide:\n        gap = 24px\n    if scheme.dark:\n        color = lifted\n        background = sunk\n    if scheme.light:\n        color = sunk\n    if motion.reduced:\n        transition = null\n    else if scheme.dark and viewport.width <= compact:\n        padding = 10px\n    else:\n        padding = 14px\n\n    @before:\n        if viewport.width <= compact:\n            content = "compact"`
const compositionCode = `import {rgb, spacing} from "velar/look"\n\nconst ramp = rgb(45, 79, 190)\n\n// Composition happens once, at the outer level, and later declarations follow\n// normal CSS cascade order. A Look value has reference identity, so two\n// separately written literals with identical bodies are not equal even though\n// they compile to one shared rule.\nexport const controlLook = look:\n    padding = spacing(10px, 14px)\n    borderRadius = 10px\n\nexport const primaryControlLook = look:\n    ...controlLook\n    color = rgb(255, 255, 255)\n    background = ramp\n\nexport component Controls:\n    return <div data-controls>\n        <button type="button" data-control look={controlLook}>base control</button>\n        <button type="button" data-primary look={primaryControlLook}>composed control</button>\n    </div>`
const reactiveCode = `import {rgb, spacing} from "velar/look"\n\nconst ink = rgb(24, 31, 46)\nconst brand = rgb(45, 79, 190)\nconst sky = rgb(90, 140, 220)\n\nconst controlLook = look:\n    padding = spacing(10px, 14px)\n    borderRadius = 10px\n\nconst primaryControlLook = look:\n    ...controlLook\n    color = rgb(255, 255, 255)\n    background = brand\n\n// A look literal is built once, where it is written, so it cannot read reactive\n// state. Reactive visuals live on the element instead: look={...} chooses a\n// whole Look and look:property={...} sets one property, and a null value\n// removes the controlled property rather than emitting the text "null".\nexport component ReactiveVisuals:\n    state hot = false\n\n    def toggle():\n        hot = not hot\n\n    return <div data-reactive-visuals>\n        <p\n            data-reactive-look\n            look={hot ? primaryControlLook : controlLook}\n            look:color={hot ? brand : ink}\n            look:borderColor={hot ? sky : null}\n        >\n            reactive visuals\n        </p>\n        <button type="button" data-toggle-hot on:click={toggle}>Toggle</button>\n    </div>`
const snapshotErrorCode = "state hot = false\n\nconst panelLook = look:\n    opacity = hot ? 1 : 0.5\n\nexport component Panel:\n    return <p look={panelLook}>a panel</p>"
const snapshotErrorOutput = "main.vel:4:15 error VEL5058: A Look literal is built once where it is written, so 'hot' is read as a snapshot and the visual never follows it. Put the reactive decision on the element instead: 'look={hot ? oneLook : otherLook}' chooses a whole Look, and 'look:property={...}' sets one property\n    opacity = hot ? 1 : 0.5\n              ^^^"

const sections = [
    {id: "builders", label: "Builders are ordinary values", labelZh: "构建器是普通的值"},
    {id: "units", label: "Unit literals and their arithmetic", labelZh: "单位字面量与它们的算术"},
    {id: "properties", label: "Closed property families", labelZh: "封闭的属性家族"},
    {id: "conditions", label: "States, targets, and media", labelZh: "状态、目标与媒体"},
    {id: "composition", label: "Composition and identity", labelZh: "合成与身份"},
    {id: "reactive", label: "Reactive visuals live on the element", labelZh: "响应式视觉在元素上"},
]

const builderRows: List<MemberRow> = [
    {name: "color rgb rgba hsl", signature: "rgb(24, 31, 46)", summary: "The four colour constructors.", summaryZh: "四个颜色构造器。"},
    {name: "alpha lighten darken", signature: "lighten(ink, 0.2)", summary: "The three adjustments over an existing colour.", summaryZh: "对已有颜色的三种调整。"},
    {name: "border shadow", signature: `border(1px, ink, "dashed")`, summary: "The two composite edge and depth values.", summaryZh: "两个复合的边与深度取值。"},
    {name: "linearGradient asset", signature: `asset("/mark.svg")`, summary: "The two Image values.", summaryZh: "两个 Image 取值。"},
    {name: "minmax repeat tracks", signature: "repeat(3, minmax(120px, 1fr))", summary: "The grid track vocabulary.", summaryZh: "网格轨道词汇。"},
    {name: "spacing", signature: "spacing(16px, 20px)", summary: "One to four steps of edge spacing.", summaryZh: "一到四段的边距。"},
    {name: "min max clamp", signature: "clamp(1rem, 4vw, 3rem)", summary: "The three length functions.", summaryZh: "三个长度函数。"},
    {name: "transition animate", signature: `transition("opacity", 200ms)`, summary: "The two motion values; the motion chapter spends them.", summaryZh: "两个动效取值；动效那一章会使用它们。"},
]

export component WebLook:
    const locale = useLocale()
    return <main>
        <Head
            title={headTitle("/guide/web/look", locale.isChinese())}
            description={locale.text("How a look block is written and checked, and why its builders, units, and properties are closed sets.", "look 块如何书写与受检，以及它的构建器、单位与属性为何是封闭集合。")}
            themeColor="#f7f5f0"
        />
        <DocsShell items={guideNav}>
            <PageHeader
                kicker={locale.text("Web extension / 07", "Web 扩展 / 07")}
                title={locale.text("Look", "Look")}
                summary={locale.text("The Look literal: builders as ordinary values, unit literals, closed property families, element states, pseudo-element targets, and media conditions.", "Look 字面量：作为普通值的构建器、单位字面量、封闭的属性家族、元素状态、伪元素目标，以及媒体条件。")}
            />
            <SectionList items={sections} />
            <Prose>
                <SectionHeading id="builders">{locale.text("Builders are ordinary values", "构建器是普通的值")}</SectionHeading>
                <Paragraph>
                    {locale.text("A look block is a checked literal. Every value inside it comes either from a unit literal or from a builder imported by name from velar/look, so the import list at the top of a file names the visual vocabulary that file uses. A builder is an ordinary value: it may be aliased, passed to another function, returned, and called outside a Look block, with the same checked signature.", "look 块是一个受检的字面量。其中的每个取值要么来自单位字面量，要么来自从 velar/look 按名导入的构建器，因此文件顶部的导入列表就写明了该文件使用的视觉词汇。构建器是普通的值：它可以被起别名、传给另一个函数、被返回，也可以在 Look 块之外调用，签名同样受检。")}
                </Paragraph>
                <MemberTable
                    rows={builderRows}
                    caption={locale.text("The builders velar/look publishes", "velar/look 发布的构建器")}
                />
                <CodeBlock code={buildersCode} />

                <SectionHeading id="units">
                    {locale.text("Unit literals and their arithmetic", "单位字面量与它们的算术")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("Visual unit suffixes are language syntax and need no import. Seven of them are Length, one is Percentage, one is TrackFraction, two are Duration, and two are Angle. They are ordinary values, so they can be bound, exported, imported, and calculated outside any Look block.", "视觉单位后缀属于语言语法，无需导入。其中七个是 Length，一个是 Percentage，一个是 TrackFraction，两个是 Duration，两个是 Angle。它们是普通的值，因此可以在任何 Look 块之外被绑定、导出、导入与参与计算。")}
                </Paragraph>
                <CodeBlock code={unitsCode} />
                <BulletList>
                    <li>
                        {locale.text("Addition and subtraction require compatible dimensions; Length mixed with Percentage produces LengthPercentage, and mixed units lower to a calc expression.", "加法与减法要求维度相容；Length 与 Percentage 混合得到 LengthPercentage，混合单位下降为 calc 表达式。")}
                    </li>
                    <li>
                        {locale.text("Multiplication and division accept a unit value and a finite scalar, in either order. Unit by unit multiplication, division by a unit, and arithmetic over colours or composite builders are rejected.", "乘法与除法接受一个单位值与一个有限标量，两种顺序都可以。单位乘单位、除以单位，以及对颜色或复合构建器做算术，都会被拒绝。")}
                    </li>
                    <li>
                        {locale.text("A viewport threshold must resolve at compile time to a local or imported const px, rem, or em token.", "viewport 阈值必须在编译期解析为本地或导入的 const px、rem 或 em 记号。")}
                    </li>
                </BulletList>

                <SectionHeading id="properties">{locale.text("Closed property families", "封闭的属性家族")}</SectionHeading>
                <Paragraph>
                    {locale.text("The published property table is grouped into fourteen families, and each property has a declared value kind. CSS keyword values are written as strings, because a bare identifier is a real VelarScript variable. The sample below takes one property from each family rather than the whole table.", "已发布的属性表分为十四个家族，每个属性都有声明好的取值种类。CSS 关键字取值写成字符串，因为裸标识符是真实的 VelarScript 变量。下面的样本从每个家族各取一个属性，而不是整张表。")}
                </Paragraph>
                <CodeBlock code={familiesCode} />
                <Paragraph>
                    {locale.text("Because the table is closed, a misspelled property is a diagnostic with a suggestion rather than a declaration the browser silently discards, and a length written without a unit is refused at the value.", "由于这张表是封闭的，拼错的属性会得到一条带建议的诊断，而不是被浏览器静默丢弃的声明；缺少单位的长度会在取值处被拒绝。")}
                </Paragraph>
                <CodeBlock code={propertyErrorCode} />
                <CodeBlock code={propertyErrorOutput} />

                <SectionHeading id="conditions">{locale.text("States, targets, and media", "状态、目标与媒体")}</SectionHeading>
                <Paragraph>
                    {locale.text("A Look condition covers nine element states, seven pseudo-element targets, and five media conditions. Conditions may appear inside a target and a target may appear inside a condition; a target may not appear inside another target. Media subjects compose with element states and with each other, and the negation of one scheme is the other.", "Look 条件覆盖九种元素状态、七个伪元素目标与五种媒体条件。条件可以出现在目标内部，目标也可以出现在条件内部；但目标不能出现在另一个目标内部。媒体主语可以与元素状态、以及彼此组合，并且对一种配色方案取否定就是另一种。")}
                </Paragraph>
                <CodeBlock code={conditionsCode} />
                <BulletList>
                    <li>
                        {locale.text("motion.reduced lowers to the reduced-motion preference, so a reduced-motion variant is expressible without leaving Look.", "motion.reduced 下降为降低动效偏好，因此降低动效的变体无需离开 Look 就能表达。")}
                    </li>
                    <li>
                        {locale.text("Container queries, print, and orientation have no Look spelling in this version; they are reached through the unsafe CSS boundary.", "容器查询、print 与 orientation 在本版本中没有 Look 拼写；它们经由 unsafe CSS 边界抵达。")}
                    </li>
                    <li>
                        {locale.text("content is written as CSS text: a string value is emitted quoted, and only the bare keywords none and normal pass through unquoted.", "content 写作 CSS 文本：字符串取值带引号发出，只有裸关键字 none 与 normal 不带引号透传。")}
                    </li>
                </BulletList>

                <SectionHeading id="composition">{locale.text("Composition and identity", "合成与身份")}</SectionHeading>
                <Paragraph>
                    {locale.text("A spread composes another Look once, at the outer level, and the declarations that follow it obey ordinary CSS cascade order. A Look is an ordinary value with reference identity, so comparing two Looks compares identity rather than declarations: two identical literals are not equal even though they compile to one shared rule. Choose between named Look values, or compare the inputs that produced them.", "展开在外层把另一个 Look 合成进来一次，其后的声明遵循普通的 CSS 层叠顺序。Look 是带引用身份的普通值，因此比较两个 Look 比较的是身份而不是声明：两个写法相同的字面量并不相等，尽管它们编译成同一条共享规则。要么在具名的 Look 值之间选择，要么比较产生它们的输入。")}
                </Paragraph>
                <CodeBlock code={compositionCode} />

                <SectionHeading id="reactive">
                    {locale.text("Reactive visuals live on the element", "响应式视觉在元素上")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("A look literal is built once, where it is written, and the compiler extracts it into the build's stylesheet. That is why it cannot read reactive state: the read would be a snapshot that never updates. A reactive visual belongs on the element, where look={...} chooses a whole Look and look:property={...} sets one property, and a null value removes the controlled property rather than emitting the text null.", "look 字面量在它被书写的位置构建一次，编译器把它提取进构建的样式表。这正是它不能读取响应式状态的原因：那样的读取会是一份永不更新的快照。响应式视觉属于元素：look={...} 选择一整个 Look，look:property={...} 设置单个属性，取值为 null 时移除被控制的属性，而不是发出文本 null。")}
                </Paragraph>
                <CodeBlock code={reactiveCode} />
                <Paragraph>
                    {locale.text("Reading state inside a literal is refused at the read, and the diagnostic names both element spellings.", "在字面量内部读取 state 会在读取处被拒绝，诊断会同时指出两种元素上的拼写。")}
                </Paragraph>
                <CodeBlock code={snapshotErrorCode} />
                <CodeBlock code={snapshotErrorOutput} />
                <Callout title={locale.text("What the emitted CSS looks like", "发出的 CSS 是什么样子")}>
                    <Paragraph>
                        {locale.text("Look emits readable tokens on a data attribute and readable custom properties rather than random generated class names, and an author's own stable class and data attributes remain public hooks. That is what lets an external stylesheet target the markup at all — the subject of the next-but-one chapter.", "Look 在一个 data 属性上发出可读的记号，并发出可读的自定义属性，而不是随机生成的类名；作者自己稳定的 class 与 data 属性仍然是公开的挂钩点。这正是外部样式表能够选中这些标记的原因——也是再往后一章的主题。")}
                    </Paragraph>
                </Callout>
            </Prose>
            <DocsPager previous={guidePrevious("/guide/web/look")} next={guideNext("/guide/web/look")} />
        </DocsShell>
    </main>
