import {Head, Link} from "velar/web"
import {CodeBlock, Callout, DocsShell, PageHeader, Prose} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {docsNav} from "../content.vel"

const createCode = "npm create velar@latest my-app\ncd my-app\nnpm install\nnpm run dev"
const appCode = "import {App} from \"./app.vel\"\n\nmount(<App />, \"#app\")"
const componentCode = "const counterLook = look:\n    display = \"grid\"\n    gap = 12px\n    maxWidth = 320px\n\nconst buttonLook = look:\n    justifySelf = \"start\"\n    padding = spacing(10px, 16px)\n    border = border(0px, color(\"transparent\"))\n    borderRadius = 9999px\n    color = rgb(255, 255, 255)\n    background = rgb(17, 18, 22)\n    cursor = \"pointer\"\n\nexport component App:\n    state count = 0\n\n    def increment():\n        count += 1\n\n    return <main class=\"counter\" look={counterLook}>\n        <h1>Hello, VelarScript</h1>\n        <button look={buttonLook} type=\"button\" on:click={increment}>\n            Count: {count}\n        </button>\n    </main>"
const scriptsCode = "npm run format\nnpm run check\nnpm test\nnpm run test:browser\nnpm run build\nnpm run verify\nnpm run preview"

export component DocsGettingStarted:
    const locale = useLocale()
    return <main data-getting-started>
        <Head title={locale.text("Getting started · VelarScript", "快速开始 · VelarScript")} description={locale.text("Install VelarScript, create a Web project, understand its files, and run the first checked component.", "安装 VelarScript，创建 Web 项目，理解项目文件并运行第一个受检查的组件。")} themeColor="#f7f5f0" />
        <DocsShell items={docsNav}>
            <PageHeader kicker={locale.text("Start / 01", "开始 / 01")} title={locale.text("From an empty folder to a real Web app.", "从空文件夹开始，构建真正的 Web 应用。")} summary={locale.text("Create a project, understand every generated file, change a component, test it, and produce a verified static build.", "创建项目，理解每个生成文件，修改组件、运行测试，并产出可验证的静态构建。")} tags={["Node 24+", "npm", ".vel", "Web API 0.10"]} />
            <Prose>
                <h2 id="requirements">{locale.text("Before you begin", "开始之前")}</h2>
                <p>{locale.text("VelarScript currently requires Node.js 24 or later. npm remains the package registry, dependency resolver, installer, and lockfile authority. The toolchain is installed into each project, so development, CI, and production use the compiler version recorded by that project's lockfile.", "VelarScript 当前需要 Node.js 24 或更高版本。npm 继续负责包注册、依赖解析、安装和锁文件。工具链安装在每个项目中，因此开发、CI 与生产使用的编译器版本都由该项目的锁文件确定。")}</p>
                <Callout title={locale.text("No hidden global install", "不需要隐式全局安装")}><p>{locale.text("You do not need a system-wide compiler. Project scripts call the local ", "无需安装系统级编译器。项目脚本会调用安装在 ")}<code>node_modules</code>{locale.text(" copy of the ", " 中的本地 ")}<code>velar</code>{locale.text(" executable.", " 可执行文件。")}</p></Callout>

                <h2 id="create">{locale.text("Create the application", "创建应用")}</h2>
                <CodeBlock code={createCode} />
                <p>{locale.text("The default ", "默认的 ")}<code>web</code>{locale.text(" template creates the project transactionally and refuses to overwrite a non-empty directory. Creation does not install packages, initialize Git, download browsers, or contact a hosting service; every external action remains visible.", " 模板以事务方式创建项目，并拒绝覆盖非空目录。创建过程不会自动安装依赖、初始化 Git、下载浏览器或连接托管服务；所有外部动作都保持明确可见。")}</p>
                <p>{locale.text("Other starting points are ", "其他起点包括：用于文档站的 ")}<code>-- --template docs</code>{locale.text(" for documentation sites, ", "、用于 Core 源码包的 ")}<code>-- --template library</code>{locale.text(" for Core source packages, and ", "，以及用于可复用 Web 组件包的 ")}<code>-- --template component</code>{locale.text(" for reusable Web component packages.", "。")}</p>

                <h2 id="files">{locale.text("Know the generated files", "理解生成的文件")}</h2>
                <ul>
                    <li><code>src/main.vel</code>{locale.text(" is the browser entry and mounts the root component.", " 是浏览器入口，负责挂载根组件。")}</li>
                    <li><code>src/app.vel</code>{locale.text(" owns the first component and its UI.", " 定义第一个组件及其界面。")}</li>
                    <li><code>src/app.test.vel</code>{locale.text(" contains fast Core tests.", " 包含快速的 Core 测试。")}</li>
                    <li><code>src/app.browser.test.vel</code>{locale.text(" checks the delivered application in a real browser.", " 在真实浏览器中检查最终交付的应用。")}</li>
                    <li><code>public/</code>{locale.text(" contains static files copied without becoming source modules.", " 保存原样复制、但不会成为源码模块的静态文件。")}</li>
                    <li><code>velar.json</code>{locale.text(" declares the entry, output, Web extension, base path, public configuration, and production policy.", " 声明入口、输出目录、Web 扩展、基础路径、公开配置与生产策略。")}</li>
                    <li><code>package.json</code>{locale.text(" and ", " 与 ")}<code>package-lock.json</code>{locale.text(" remain the dependency authority.", " 仍然是依赖关系的权威来源。")}</li>
                </ul>
                <CodeBlock code={appCode} />

                <h2 id="first-component">{locale.text("Write the first component", "编写第一个组件")}</h2>
                <CodeBlock code={componentCode} />
                <p>{locale.text("A component runs its setup once. ", "组件的初始化代码只运行一次。")}<code>state</code>{locale.text(" declares reactive data, assignment updates only the dependent DOM region, JSX creates native DOM, and a checked ", " 声明响应式数据，赋值只更新依赖它的 DOM 区域，JSX 创建原生 DOM，而受检查的 ")}<code>Look</code>{locale.text(" value describes presentation. There is no virtual DOM and no React-style effect surface.", " 值负责描述视觉表现。这里没有虚拟 DOM，也没有 React 风格的 effect 接口。")}</p>
                <p>{locale.text("Use ", "不需要重新赋值时使用 ")}<code>const</code>{locale.text(" for bindings that are not reassigned and ", "；当重新赋值本身属于设计时使用 ")}<code>let</code>{locale.text(" when reassignment is part of the design. Component ", "。组件中的 ")}<code>state</code>{locale.text(" is reserved for values that participate in rendering or watchers.", " 只用于参与渲染或监听的数据。")}</p>

                <h2 id="development">{locale.text("Development loop", "开发循环")}</h2>
                <p><code>npm run dev</code>{locale.text(" checks the project, starts the Web development host, and recompiles changed modules. A failed edit keeps the last working application visible and reports the diagnostic in the browser. Module state is recreated after hot replacement; persistence exists only when you use an explicit storage module.", " 会检查项目、启动 Web 开发宿主，并重新编译发生变化的模块。一次失败的编辑不会盖掉最后可用的应用，诊断信息会显示在浏览器中。热替换后模块状态会重新创建；只有显式使用存储模块时数据才会持久化。")}</p>

                <h2 id="quality">{locale.text("Check and ship", "检查与交付")}</h2>
                <CodeBlock code={scriptsCode} />
                <p><code>check</code>{locale.text(" performs semantic analysis. Core tests run without a browser. Browser tests build and open the real CSP application through a restricted typed controller. ", " 执行语义分析。Core 测试无需浏览器；浏览器测试会构建并通过受限的类型化控制器打开真实 CSP 应用。")}<code>build</code>{locale.text(" writes hashed assets and deployment manifests; ", " 生成带哈希的资源与部署清单；")}<code>verify</code>{locale.text(" checks the exact file inventory, sizes, hashes, API versions, CSP, cache policy, and SPA fallback before ", " 会检查精确文件清单、大小、哈希、API 版本、CSP、缓存策略与 SPA 回退，全部通过后 ")}<code>preview</code>{locale.text(" will serve them.", " 才会提供预览。")}</p>

                <div class="next-links"><Link to="/docs/project"><strong>{locale.text("Next: Project and CLI", "下一步：项目与 CLI")}</strong><span>{locale.text("Understand the manifest, commands, packages, and templates.", "理解清单、命令、包与模板。")}</span></Link><Link to="/docs/language"><strong>{locale.text("Start the language", "开始学习语言")}</strong><span>{locale.text("Learn bindings, values, expressions, and readable blocks.", "学习绑定、值、表达式与易读的代码块。")}</span></Link></div>
            </Prose>
        </DocsShell>
    </main>
