import {Head, Link} from "velar/web"
import {border, clamp, minmax, spacing, tracks} from "velar/look"
import {Callout, CodeBlock, PageHeader, Paragraph, Prose, SectionHeading, SectionList} from "@velarscript/docs-kit"
import {Container, Section, foundationInk as ink, foundationInkSoft as inkSoft, foundationPaperPure as paperPure, foundationRule as rule, foundationSea as sea, useLocale} from "@velarscript/site-ui"
import {headTitle} from "../content.vel"

const coreTourCode = `type Config:\n    retries: number\n\nasync def save():\n    print("saved")\n\ndef close():\n    print("closed")\n\nexport async def tryCatchFinally() -> string:\n    try:\n        await save()\n    catch error:\n        return error.message\n    finally:\n        close()\n    return "ok"\n\n// The Error contract's own members. Discrimination is the class; \`code\` is that\n// same identity in string form.\nexport def errorContract(error: Error) -> string:\n    return f"{error.message} {error.name} {error.code} {error.cause == null}"\n\nexport def compilerRaised(untrusted: unknown, values: List<number>) -> string:\n    try:\n        const config = Config.parse(untrusted)\n        return str(values[config.retries])\n    catch error:\n        if error is ValidationError:\n            return f"invalid: {error.message}"\n        if error is IndexError:\n            return "out of range"\n        throw error`
const webTourCode = `export type Task:\n    id: string\n    title: string\n    done: bool\n\n// A module \`state\` lives for the life of the page and every importer sees the\n// same cell. Assigning an imported binding is forbidden; mutating the value\n// inside one is legal and publishes to everyone.\nexport state visits = 0\nexport state tasks: List<Task> = [\n    {id: "read", title: "Read the chapter", done: false},\n    {id: "write", title: "Write a module", done: false},\n]\n\n// An exported \`computed\` declares its public accessor result at the export\n// site. \`computed\` is a function, not a declaration keyword: there is no\n// \`computed name = expression\` spelling.\nexport const openTasks: () -> number = computed(() => tasks.filter(task => not task.done).size)\n\n// A module-scope watch is never disposed, so it is for application-wide facts\n// rather than anything a component owns.\nwatch visits:\n    print(f"visit {visits}")\n\nexport def recordVisit():\n    visits += 1`
const desktopTourDesktopCode = `import {languageServer, openTerminal} from "velar/desktop"\n\n// openTerminal(options?) answers a TerminalSession: a real PTY with pid, write,\n// resize, next, wait, and close. It requires the manifest's\n// desktop.permissions.terminal to be enabled.\nexport async def terminalSession() -> string:\n    using session = await openTerminal({columns: 100, rows: 30})\n    await session.write("velar --version\\n")\n    await session.resize(120, 40)\n    async for chunk in session:\n        print(chunk)\n    const result = await session.wait()\n    return f"{session.pid}|{result.code}"\n\n// languageServer() answers a LanguageServer speaking the Language Server\n// Protocol as framed text: send writes one message, next reads the next one,\n// and close ends the session.\nexport async def languageServerRound() -> string:\n    using server = await languageServer()\n    await server.send(\`{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}\`)\n    const reply = await server.next()\n    return reply ?? "no reply"`
const domainCode = `export enum Stage:\n    planned\n    building\n    verifying\n    released\n\nexport type Check:\n    id: string\n    title: string\n    owner: string\n    done: bool\n\nexport type Release:\n    id: string\n    name: string\n    version: string\n    stage: Stage\n    target: string\n    checks: List<Check>\n\n// Percent of a release's checklist that is done. An empty checklist is 0 rather\n// than a division by zero, because "nothing planned" is not "ready to ship".\nexport def readiness(release: readonly Release) -> number:\n    if release.checks.size == 0:\n        return 0\n    const done = release.checks.filter(check => check.done).size\n    return (done / release.checks.size * 100).round()\n\nexport def isBlocked(release: readonly Release) -> bool:\n    return release.stage != Stage.released and release.checks.some(check => not check.done)\n\n// A release may only leave \`verifying\` once its checklist is clear. The rule\n// lives here rather than in the store so that a test can state it in one line\n// and the store keeps exactly one job: applying decisions to state.\nexport def mayAdvance(release: readonly Release) -> bool:\n    if release.stage == Stage.released:\n        return false\n    if release.stage == Stage.verifying:\n        return not isBlocked(release)\n    return true`

const sections = [
    {id: "two", label: "Two kinds of knowledge", labelZh: "两种知识"},
    {id: "core", label: "tour/core", labelZh: "tour/core"},
    {id: "web", label: "tour/web", labelZh: "tour/web"},
    {id: "desktop", label: "tour/desktop", labelZh: "tour/desktop"},
    {id: "release-studio", label: "app — Release Studio", labelZh: "app —— Release Studio"},
    {id: "run", label: "Running them", labelZh: "运行它们"},
]

// A list of example cards rather than a run of bullets, so it is not a
// BulletList. Its own margin stays at zero: Prose owns the space around it.
const listLook = look:
    display = "grid"
    gap = 16px
    margin = 0
    padding = 0
    listStyle = "none"

const entryLook = look:
    display = "grid"
    gridTemplateColumns = tracks(minmax(0px, 0.34fr), minmax(0px, 1fr))
    gap = clamp(12px, 2vw, 28px)
    padding = spacing(18px, 20px)
    border = border(1px, rule)
    borderRadius = 10px
    background = paperPure

    if viewport.width <= 700px:
        gridTemplateColumns = tracks(minmax(0px, 1fr))

const entryNameLook = look:
    color = ink
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.86rem
    fontWeight = 700

const entryTextLook = look:
    margin = 0
    color = inkSoft
    lineHeight = 1.65

const entryLinkLook = look:
    color = sea
    fontSize = 0.86rem

export component Examples:
    const locale = useLocale()
    return <main data-examples>
        <Head
            title={headTitle("/examples", locale.isChinese())}
            description={locale.text("The two example corpora kept in the language repository: a tour that shows every spelling once, and one complete application.", "语言仓中保存的两套示例语料：一份把每种拼写各展示一次的巡览，以及一个完整的应用。")}
            themeColor="#f7f5f0"
        />
        <Section>
            <Container narrow={true}>
                <PageHeader
                    kicker={locale.text("Examples", "示例")}
                    title={locale.text("Examples", "示例")}
                    summary={locale.text("Two things live in the language repository, and they teach different halves of writing VelarScript. Both are compiled and tested by that repository's gate, and the code on this page is taken from those files.", "语言仓里有两样东西，它们讲授的是「写 VelarScript」的不同一半。两者都由该仓的门禁编译与测试，本页的代码取自这些文件。")}
                />
                <SectionList items={sections} />
                <Prose>
                    <SectionHeading id="two">{locale.text("Two kinds of knowledge", "两种知识")}</SectionHeading>
                    <Paragraph>
                        {locale.text(`The tour teaches every spelling, exactly once — it answers "how do I say this in Vel?". The application teaches how a real codebase is put together: module division, state ownership, routing, tests — it answers "what does Vel at real size look like?".`, "巡览讲授每一种拼写，且每种恰好一次——它回答「这件事在 Vel 里怎么写？」。应用讲授一份真实代码库是如何组织起来的：模块划分、状态归属、路由、测试——它回答「真实规模的 Vel 长什么样？」。")}
                    </Paragraph>
                    <Paragraph>
                        {locale.text("These are two kinds of knowledge rather than two sizes of the same one. Knowing that resource exists does not tell you whether a feed belongs in a resource, in a module store, or in a component; knowing how one application is laid out does not tell you the syntax for a keyframes block. So the tour puts nearly identical spellings side by side on purpose, and the application never does — it shows one choice and says why.", "这是两类知识，而不是同一类知识的两种规模。知道存在 resource，并不能告诉你某个数据流应该放在 resource、模块 store 还是组件里；知道一个应用如何布局，也不能告诉你 keyframes 块的语法。因此巡览有意把几乎相同的拼写并排放置，而应用从不这样做——它只给出一个选择，并说明理由。")}
                    </Paragraph>
                    <Paragraph>
                        {locale.text("Read them in that order: the tour first, skimmed rather than studied, because it is a reference you come back to; then the application, start to finish, because structure only makes sense whole.", "按这个顺序读：先读巡览，略读而不是精读，因为它是一份你会反复回来查的参考；然后从头到尾读那个应用，因为结构只有整体看才讲得通。")}
                    </Paragraph>

                    <SectionHeading id="core">{locale.text("tour/core", "tour/core")}</SectionHeading>
                    <Paragraph>
                        {locale.text("Seventeen chapters on the Core target, which activates no extension: values, operators, types and optionals, records and enums, functions and calls, text and numbers, collections, control flow, classes, errors, modules, the JavaScript boundary, files, processes, contextual names, and testing. Everything Core can compile lives here, even when a Web application is where you would meet it — List, Map, match, try, classes, and modules are language rather than Web, so a Node service and a desktop application use them identically.", "Core 目标上的十七章，该目标不激活任何扩展：值、运算符、类型与可选值、记录与枚举、函数与调用、文本与数字、集合、控制流、类、错误、模块、JavaScript 边界、文件、进程、上下文名字与测试。凡是 Core 能编译的都放在这里，即使你通常是在 Web 应用中遇到它们——List、Map、match、try、类与模块属于语言而不属于 Web，因此 Node 服务与桌面应用对它们的用法完全相同。")}
                    </Paragraph>
                    <Paragraph>
                        {locale.text("The excerpt below is chapter 11, on errors and assertions. Discrimination is the class; code is that same identity in string form.", "下面的节选来自第 11 章，讲错误与断言。区分靠的是类；code 是同一身份的字符串形式。")}
                    </Paragraph>
                    <CodeBlock code={coreTourCode} />
                    <ul look={listLook}>
                        <li look={entryLook}>
                            <span look={entryNameLook}>examples/tour/core</span>
                            <div>
                                <p look={entryTextLook}>
                                    {locale.text("Run it with velar run examples/tour/core. Every chapter exports at least one name and main.vel imports each of them, one line per chapter, written out rather than globbed — because velar check does not check a file the entry cannot reach.", "用 velar run examples/tour/core 运行。每一章都至少导出一个名字，main.vel 逐行导入它们，一章一行，写出来而不用通配——因为 velar check 不会检查入口无法到达的文件。")}
                                </p>
                                <a look={entryLinkLook} href="https://github.com/VelarOS-AI/VelarScript/tree/main/examples/tour/core">
                                    examples/tour/core
                                </a>
                            </div>
                        </li>
                    </ul>

                    <SectionHeading id="web">{locale.text("tour/web", "tour/web")}</SectionHeading>
                    <Paragraph>
                        {locale.text(`Thirteen chapters on the Web target: components and JSX, directives, state and derived values, resources and actions, lifecycle and mount, Look, motion, the escape hatches beyond Look, routing, browser capabilities, storage and connections, and both kinds of test. It covers only what the extension adds on top of Core, which is what makes "is this part of the language or part of the Web extension?" answerable by which directory a chapter is in.`, "Web 目标上的十三章：组件与 JSX、指令、状态与派生值、resource 与 action、生命周期与挂载、Look、动效、Look 之外的逃生通道、路由、浏览器能力、存储与连接，以及两种测试。它只覆盖该扩展在 Core 之上新增的部分——这正是让「这属于语言还是属于 Web 扩展？」可以靠章节所在目录来回答的原因。")}
                    </Paragraph>
                    <Paragraph>
                        {locale.text("The excerpt below is the opening of chapter 03, on synchronous reactivity.", "下面的节选是第 03 章的开头，讲同步响应式。")}
                    </Paragraph>
                    <CodeBlock code={webTourCode} />
                    <ul look={listLook}>
                        <li look={entryLook}>
                            <span look={entryNameLook}>examples/tour/web</span>
                            <div>
                                <p look={entryTextLook}>
                                    {locale.text("Run it with velar dev examples/tour/web. Chapters 12 and 13 are the two test kinds: a unit test module and a browser test module that drives the real page.", "用 velar dev examples/tour/web 运行。第 12 与 13 章是两种测试：一个单元测试模块，以及一个驱动真实页面的浏览器测试模块。")}
                                </p>
                                <a look={entryLinkLook} href="https://github.com/VelarOS-AI/VelarScript/tree/main/examples/tour/web">
                                    examples/tour/web
                                </a>
                            </div>
                        </li>
                    </ul>

                    <SectionHeading id="desktop">{locale.text("tour/desktop", "tour/desktop")}</SectionHeading>
                    <Paragraph>
                        {locale.text("Four chapters on the Desktop target: the host surface, the three long-lived handles, the desktop test module, and a desktop browser test. The Desktop extension composes the Web extension, so every Web spelling is available unchanged and this tour walks only what Desktop adds.", "桌面目标上的四章：宿主表面、三种长期存活的句柄、桌面测试模块，以及一个桌面浏览器测试。桌面扩展组合了 Web 扩展，因此每一种 Web 拼写都原样可用，这份巡览只走桌面新增的部分。")}
                    </Paragraph>
                    <CodeBlock code={desktopTourDesktopCode} />
                    <ul look={listLook}>
                        <li look={entryLook}>
                            <span look={entryNameLook}>examples/tour/desktop</span>
                            <div>
                                <p look={entryTextLook}>
                                    {locale.text("velar dev examples/tour/desktop previews the renderer; velar package builds the native application. Every call that would really open a PTY or start a child process sits in a function nothing calls.", "velar dev examples/tour/desktop 预览渲染层；velar package 构建原生应用。每一处真的会打开 PTY 或启动子进程的调用，都放在没有任何东西调用的函数里。")}
                                </p>
                                <a look={entryLinkLook} href="https://github.com/VelarOS-AI/VelarScript/tree/main/examples/tour/desktop">
                                    examples/tour/desktop
                                </a>
                            </div>
                        </li>
                    </ul>
                    <Callout title={locale.text("The tour is also gate corpus", "巡览同时也是门禁语料")}>
                        <Paragraph>
                            {locale.text("The formatter walks every .vel file under examples/, CI checks and builds every project there, and a coverage gate reverse-queries the compiler's own vocabulary tables and fails by name when a spelling is missing from the tour. A formatter or analyzer defect in a corner nothing else exercises used to have somewhere to hide; this is the corner, and it is now walked on every run.", "格式化器遍历 examples/ 下的每一个 .vel 文件，CI 检查并构建其中每一个项目，还有一道覆盖率门禁会反向查询编译器自己的词汇表，并在某种拼写缺席巡览时按名字报错。过去，格式化器或分析器在无人问津的角落里的缺陷是有地方藏身的；那个角落就是这里，而现在每次运行都会走一遍。")}
                        </Paragraph>
                    </Callout>

                    <SectionHeading id="release-studio">
                        {locale.text("app — Release Studio", "app —— Release Studio")}
                    </SectionHeading>
                    <Paragraph>
                        {locale.text("One complete Web application: a release-readiness console with four routes, one shared store, persisted reader preferences, a form, a checklist, and two kinds of test. The board tracks releases; each release has a stage — planned, building, verifying, released — a target date, and a checklist. One rule holds the application together: a release may leave verifying only once its checklist is clear. Everything else is arithmetic over that.", "一个完整的 Web 应用：发布就绪度控制台，四条路由、一个共享 store、被持久化的阅读者偏好、一个表单、一份清单，以及两种测试。看板跟踪的是发布；每个发布有一个阶段——planned、building、verifying、released——一个目标日期与一份清单。有一条规则把整个应用维系在一起：只有清单清空之后，发布才能离开 verifying。其余的一切都是围绕它的算术。")}
                    </Paragraph>
                    <Paragraph>
                        {locale.text("What this example teaches is structure — how to divide modules, where state belongs, how routing is declared, and which tests belong in a browser. It does not try to show every spelling; that is the tour's job. The excerpt below is the whole domain layer's core: nothing in it is reactive and nothing touches a document, which is what lets its unit tests exercise all of it with no page and no browser.", "这个示例讲授的是结构——如何划分模块、状态归属何处、路由如何声明，以及哪些测试属于浏览器。它不试图展示每一种拼写，那是巡览的工作。下面的节选是整个领域层的核心：其中没有任何响应式的东西，也不触碰文档，这正是让它的单元测试可以在没有页面、没有浏览器的情况下把它全部跑一遍的原因。")}
                    </Paragraph>
                    <CodeBlock code={domainCode} />
                    <ul look={listLook}>
                        <li look={entryLook}>
                            <span look={entryNameLook}>examples/app</span>
                            <div>
                                <p look={entryTextLook}>
                                    {locale.text("The layering is one-way: model, look, and config are leaves that import only standard modules; state reads them; components and pages read state; app.vel composes the pages and main.vel starts everything. Nothing imports upwards, which is what makes the model testable in milliseconds.", "分层是单向的：model、look 与 config 是叶子，只导入标准模块；state 读取它们；components 与 pages 读取 state；app.vel 组合各个页面，main.vel 启动一切。没有任何模块向上导入，这正是让 model 能在毫秒级被测试的原因。")}
                                </p>
                                <a look={entryLinkLook} href="https://github.com/VelarOS-AI/VelarScript/tree/main/examples/app">
                                    examples/app
                                </a>
                            </div>
                        </li>
                    </ul>
                    <Paragraph>
                        {locale.text(`Four decisions in it are worth copying. State lives at the scope of the question it answers: the board is a fact about the application, so it is module state; a half-typed check title is a fact about one form, so it is state inside that component; server data that is only interesting while a panel is on screen is a resource inside that panel. A component prop is a transitive readonly view, so a view asks for a change by identifier through the store rather than writing to the data it was given. Routing is declared in one module, so "what URLs does this application answer?" has a short answer. And the two test kinds answer different questions: arithmetic and store transitions run in the ordinary test process in milliseconds, while routing, rendering, form validation, and whether a preference survives a reload need a real engine.`, "其中有四个决定值得照搬。状态位于它所回答的那个问题的尺度上：看板是关于整个应用的事实，因此它是模块级 state；一个只打了一半的清单标题是关于某个表单的事实，因此它是那个组件内部的 state；只有当面板在屏幕上时才有意义的服务端数据，是那个面板内部的 resource。组件属性是可传递的只读视图，因此视图通过 store、按标识符请求变更，而不是直接写它拿到的数据。路由在一个模块里声明，于是「这个应用响应哪些 URL？」有一个简短的答案。两种测试回答不同的问题：算术与 store 状态迁移在普通测试进程里以毫秒计运行，而路由、渲染、表单验证，以及某项偏好是否能在重载后存活，都需要真正的引擎。")}
                    </Paragraph>

                    <SectionHeading id="run">{locale.text("Running them", "运行它们")}</SectionHeading>
                    <Paragraph>
                        {locale.text("Both corpora are ordinary VelarScript projects, so the ordinary commands apply: velar check for the whole module graph, velar test for the unit tests, velar test --browser all for the same application in Chromium, Firefox, and WebKit, velar dev for a dev server, and velar build for a production build. Where a page here and a file there disagree, the file is the one the compiler checked.", "两套语料都是普通的 VelarScript 项目，因此普通命令同样适用：velar check 检查整张模块图，velar test 运行单元测试，velar test --browser all 在 Chromium、Firefox 与 WebKit 中运行同一个应用，velar dev 启动开发服务器，velar build 做生产构建。当本页与那边的文件不一致时，以经过编译器检查的文件为准。")} <Link
                            to="/guide"
                        >
                            {locale.text("Read the guide", "阅读指南")}
                        </Link></Paragraph>
                </Prose>
            </Container>
        </Section>
    </main>
