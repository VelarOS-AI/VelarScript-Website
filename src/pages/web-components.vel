import {Head} from "velar/web"
import {BulletList, Callout, CodeBlock, DocsPager, DocsShell, PageHeader, Paragraph, Prose, SectionHeading, SectionList} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {guideNav, guideNext, guidePrevious, headTitle} from "../content.vel"

const declaringCode = `export type Task:\n    id: string\n    title: string\n    done: bool\n\n// A prop with no default is required; a prop with one is optional.\nexport component TaskRow(task: Task, compact: bool = false):\n    return <li data-task={task.id} data-compact={compact}>{task.title}</li>\n\n// The same contract, spelled with one more optional prop. A constructor may\n// accept more than the contract permits its caller to pass.\ncomponent DetailedTaskRow(task: Task, compact: bool = false, tracking: string = "row"):\n    return <li data-task={task.id} data-tracking={tracking}>{task.title}{compact ? "" : " (detailed)"}</li>\n\n// A component that takes children renders them wherever it likes. children is\n// an ordinary prop with an ordinary type.\ncomponent Framed(title: string, children: WebNode):\n    return <section data-framed><h3>{title}</h3>{children}</section>\n\nexport component ComponentsPanel:\n    const tasks: List<Task> = [{id: "parse", title: "Parse the module", done: true}]\n\n    return <section data-components>\n        <ul>{tasks.map(task => <TaskRow key={task.id} task={task} compact />)}</ul>\n        <ul>{tasks.map(task => <DetailedTaskRow key={task.id} task={task} />)}</ul>\n        <Framed title="Framed"><p data-framed-child>a child node</p></Framed>\n    </section>`
const contractsCode = `export type Task:\n    id: string\n    title: string\n    done: bool\n\nexport type PanelHandle:\n    focus: () -> null\n    label: () -> string\n\n// Component<Props> is the zero-Handle contract: the signature describes JSX\n// props and its result must be WebNode. compact?: bool means the prop may be\n// omitted; compact: bool? would stay required and accept null.\ntype TaskView = Component<(task: Task, compact?: bool) -> WebNode>\n\n// The two-argument form adds the Handle a ref on the invocation may claim.\ntype PanelView = Component<(title: string) -> WebNode, PanelHandle>\n\nexport component TaskRow(task: Task, compact: bool = false):\n    return <li data-task={task.id} data-compact={compact}>{task.title}</li>\n\nconst tourTasks: List<Task> = [\n    {id: "parse", title: "Parse the module", done: true},\n    {id: "check", title: "Check the module", done: false},\n]\n\n// A component value renders only as a PascalCase tag. Calling View(...) would\n// bypass JSX ownership and is rejected.\ncomponent TaskList(View: TaskView, variant: string):\n    return <ul data-task-list={variant}>{tourTasks.map(task => <View key={task.id} task={task} compact />)}</ul>\n\n// Bare Component and one-argument Component<Props> do not authorize a ref.\ncomponent Slot(View: Component):\n    return <div data-slot><View /></div>\n\nexport component ContractsPanel:\n    return <div data-contracts>\n        <TaskList View={TaskRow} variant="plain" />\n        <Slot View={EmptyView} />\n    </div>\n\ncomponent EmptyView:\n    return <span data-empty>empty</span>`
const readonlyCode = `export type Task:\n    id: string\n    title: string\n    done: bool\n\n// Record and collection props enter as transitive readonly views, so a helper\n// that only reads them declares readonly. A bare class prop is a behavioral\n// value and passes through as-is.\nexport class TaskClock:\n    constructor(private const started: number):\n        pass\n\n    def elapsed(now: number) -> number:\n        return now - self.started\n\ncomponent TaskSummary(tasks: readonly List<Task>, index: Map<string, Task>, clock: TaskClock):\n    return <p data-summary>{f"{tasks.size} tasks, {index.size} indexed, {clock.elapsed(10)} elapsed"}</p>\n\nconst tourTasks: List<Task> = [\n    {id: "parse", title: "Parse the module", done: true},\n    {id: "check", title: "Check the module", done: false},\n]\n\nconst taskIndex: Map<string, Task> = Map([["parse", tourTasks[0]], ["check", tourTasks[1]]])\n\nexport component SummaryPanel:\n    return <TaskSummary tasks={tourTasks} index={taskIndex} clock={TaskClock(0)} />`
const hostCode = `// A multi-root component returns a fragment and marks exactly one native\n// element with the valueless host directive; host receives what the invocation\n// attaches — class, class:*, look, look:*, and style:*.\ncomponent Field(label: string, value: string):\n    return <>\n        <label data-field-label for="tour-field">{label}</label>\n        <input host id="tour-field" type="text" value={value} readonly />\n    </>\n\n// A component whose root is a single element needs no marker: that root is the\n// host, and a component root forwards to its own host in turn.\ncomponent FieldRow(label: string, value: string):\n    return <Field label={label} value={value} />\n\nexport component HostPanel:\n    return <div data-host-panel>\n        <FieldRow label="Name" value="Ada" />\n        <Field label="Team" value="Compiler" class="field" look:marginBlock={8px} />\n    </div>`
const handleCode = `// A component Handle is a concrete record type. Its members are written in a\n// type expression, which is one of the positions where -> null is required\n// rather than inferred.\nexport type PanelHandle:\n    focus: () -> null\n    label: () -> string\n\ntype PanelView = Component<(title: string) -> WebNode, PanelHandle>\n\n// exposes names the Handle; exactly one expose provides it. The conventional\n// order puts expose immediately before the single return.\nexport component LabelledPanel(title: string) exposes PanelHandle:\n    let heading: Element? = null\n\n    def focus():\n        if heading != null:\n            heading.focus()\n\n    def label() -> string:\n        return title\n\n    expose {focus, label}\n    return <article data-panel><h3 ref={heading} tabindex="-1">{title}</h3></article>\n\n// A contract that carries a Handle authorizes a ref on the invocation; a\n// constructor may expose more than the contract requires, but one with no\n// compatible Handle cannot satisfy it.\ncomponent PanelSlot(View: PanelView, title: string):\n    let handle: PanelHandle? = null\n\n    def focusPanel():\n        if handle != null:\n            handle.focus()\n\n    return <div data-panel-slot>\n        <View ref={handle} title={title} />\n        <button type="button" data-focus-slot on:click={focusPanel}>Focus the slotted panel</button>\n    </div>\n\nexport component HandlePanel:\n    return <PanelSlot View={LabelledPanel} title="Panel through a contract" />`
const refErrorCode = `type PanelHandle:\n    focus: () -> null\n\n// Plain has no exposes clause, so it publishes no Handle.\ncomponent Plain(title: string):\n    return <p>{title}</p>\n\ncomponent Page:\n    let handle: PanelHandle? = null\n\n    return <Plain ref={handle} title="No handle here" />`
const refErrorOutput = `main.vel:11:19 error VEL5057: Component 'Plain' does not expose a Handle\n    return <Plain ref={handle} title="No handle here" />\n                  ^^^^^^^^^^^^`
const nativeCode = `// Native element vocabulary: ordinary elements, void elements, a custom element\n// under the platform convention (lowercase, one hyphen), SVG, and MathML. An\n// unknown native spelling is a compile error with a suggestion.\nexport component NativeVocabulary:\n    return <div data-native>\n        <p>ordinary</p>\n        <br />\n        <hr />\n        <img src="/tour-mark.svg" alt="VelarScript tour mark" width="24" height="24" />\n        <tour-badge data-label="custom element"></tour-badge>\n        <svg data-svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">\n            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>\n        </svg>\n        <math data-math aria-label="x plus one"><mi>x</mi><mo>+</mo><mn>1</mn></math>\n    </div>`

const sections = [
    {id: "declaring", label: "Declaring a component", labelZh: "声明组件"},
    {id: "contracts", label: "Component as a written contract", labelZh: "作为书面契约的 Component"},
    {id: "readonly", label: "What a prop carries", labelZh: "prop 携带什么"},
    {id: "host", label: "Hosts and fragments", labelZh: "host 与 fragment"},
    {id: "handles", label: "One exposed handle", labelZh: "唯一暴露的句柄"},
    {id: "native", label: "The native element vocabulary", labelZh: "原生元素词汇表"},
]

export component WebComponents:
    const locale = useLocale()
    return <main>
        <Head
            title={headTitle("/guide/web/components", locale.isChinese())}
            description={locale.text("How a component declares props and children, what Component<Props> describes, and how exposes names a handle.", "组件如何声明 props 与 children、Component<Props> 描述了什么，以及 exposes 如何命名一个句柄。")}
            themeColor="#f7f5f0"
        />
        <DocsShell items={guideNav}>
            <PageHeader
                kicker={locale.text("Web extension / 02", "Web 扩展 / 02")}
                title={locale.text("Components", "组件")}
                summary={locale.text("Declaring a component, typing its props, and the one handle a component may expose.", "声明组件、为 props 标注类型，以及组件可以暴露的唯一句柄。")}
            />
            <SectionList items={sections} />
            <Prose>
                <SectionHeading id="declaring">{locale.text("Declaring a component", "声明组件")}</SectionHeading>
                <Paragraph>
                    {locale.text("component names the unit and its parameter list is its props. A prop with no default is required and a prop with a default is optional, which is the ordinary function rule rather than a second convention. A component has exactly one top-level return, and component names are PascalCase while native elements keep their lowercase HTML and SVG spellings.", "component 命名这个单元，它的参数列表就是 props。没有默认值的 prop 是必需的，有默认值的是可选的——这就是普通函数的规则，不是第二套约定。组件有且只有一个顶层 return；组件名用 PascalCase，原生元素保留小写的 HTML 与 SVG 拼写。")}
                </Paragraph>
                <CodeBlock code={declaringCode} />
                <BulletList>
                    <li>
                        {locale.text("children: WebNode receives the nodes written between the tags. It is an ordinary prop with an ordinary type, so a component may name it anything a WebNode prop can be named.", "children: WebNode 接收写在标签之间的节点。它是普通 prop，带普通类型，因此组件可以用任何 WebNode prop 能用的名字命名它。")}
                    </li>
                    <li>
                        {locale.text("Props evaluate from left to right, then JSX children, then the component function — the same order JavaScript already has.", "props 从左到右求值，然后是 JSX children，最后是组件函数——与 JavaScript 已有的顺序一致。")}
                    </li>
                    <li>
                        {locale.text("A boolean prop written with no value, as compact above, passes true.", "写成无值形式的布尔 prop（如上面的 compact）传入 true。")}
                    </li>
                </BulletList>

                <SectionHeading id="contracts">
                    {locale.text("Component as a written contract", "作为书面契约的 Component")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("Component is the structural type of a component constructor. Bare Component says a host will pass no application props; Component<Props> writes the prop signature; the optional second argument names the Handle a ref may claim. Optional markers govern omission: compact?: bool may be absent, whereas compact: bool? is required and may contain null.", "Component 是组件构造器的结构化类型。裸 Component 表示宿主不会传入应用 prop；Component<Props> 写出 prop 签名；可选的第二个实参命名 ref 可以索取的 Handle。可选标记决定能否省略：compact?: bool 可以缺席，而 compact: bool? 是必需的、可以为 null。")}
                </Paragraph>
                <CodeBlock code={contractsCode} />
                <BulletList>
                    <li>
                        {locale.text("A compatible constructor accepts every prop the contract permits and adds no new required prop; additional optional props are allowed.", "兼容的构造器接受契约允许的每个 prop，且不新增必需 prop；额外的可选 prop 是允许的。")}
                    </li>
                    <li>
                        {locale.text("A received constructor renders as a PascalCase tag. It is not an ordinary callable, and it is distinct from an already-rendered WebNode.", "接收到的构造器以 PascalCase 标签的形式渲染。它不是普通可调用值，也与已经渲染出的 WebNode 不同。")}
                    </li>
                    <li>
                        {locale.text("The selected constructor keeps its instance while its identity is unchanged, including across live prop updates. Replacing it with a different constructor runs cleanup for the old instance and mounts the new one.", "只要构造器的标识不变，被选中的构造器就保持它的实例，包括在 prop 实时更新期间。换成另一个构造器会为旧实例运行清理并挂载新实例。")}
                    </li>
                </BulletList>

                <SectionHeading id="readonly">{locale.text("What a prop carries", "prop 携带什么")}</SectionHeading>
                <Paragraph>
                    {locale.text("Record and collection props enter as transitive readonly views, so a component that only reads them says so in its signature. A class instance is a behavioral value and passes through as it is, because its methods are the interface rather than its fields.", "记录与集合 prop 以传递性只读视图的形式进入，因此只读取它们的组件在签名里如实写明。类实例是行为值，原样传入，因为它的接口是方法而不是字段。")}
                </Paragraph>
                <CodeBlock code={readonlyCode} />

                <SectionHeading id="host">{locale.text("Hosts and fragments", "host 与 fragment")}</SectionHeading>
                <Paragraph>
                    {locale.text("A component invocation may attach class, class:*, look, look:*, and style:* without knowing the component's internals. Those land on the component's host element. A single native root is the host by default, a component root forwards to its own host in turn, and a fragment has nothing to infer from — so exactly one native element in it carries the valueless host marker.", "组件调用处可以在不了解组件内部的情况下附加 class、class:*、look、look:* 与 style:*。它们落在组件的 host 元素上。单个原生根默认就是 host，组件根则继续转发到它自己的 host，而 fragment 没有可推断的对象——因此其中恰好一个原生元素带上无值的 host 标记。")}
                </Paragraph>
                <CodeBlock code={hostCode} />
                <BulletList>
                    <li>
                        {locale.text("Two markers in one component, a marker with a value, and a multi-root component with no marker are each a compile error.", "一个组件里有两个标记、带值的标记，以及没有标记的多根组件，都是编译错误。")}
                    </li>
                    <li>
                        {locale.text("host also belongs on a single-root component whose root is not the element that should receive host styling; marking the intended element stops the root from being the default.", "当单根组件的根并不是应该接收 host 样式的那个元素时，也要写 host；标出目标元素后，根就不再是默认值。")}
                    </li>
                    <li>
                        {locale.text("Across a component boundary the caller wins: a look written on the invocation is composed after the look the component put on its host, so a property both of them set takes the caller's value.", "跨组件边界时调用方胜出：写在调用处的 look 在组件放到自己 host 上的 look 之后合成，因此两边都设置的属性取调用方的值。")}
                    </li>
                </BulletList>

                <SectionHeading id="handles">{locale.text("One exposed handle", "唯一暴露的句柄")}</SectionHeading>
                <Paragraph>
                    {locale.text("A component may publish a narrow imperative Handle without publishing its internal scope, its state cells, or its runtime object. exposes names one concrete record contract and exactly one expose provides a matching value, so a parent has one documented way in. Use Handle functions for imperative commands such as focus, reset, open, and close, and prefer getter functions over publishing mutable state.", "组件可以发布一个窄的命令式 Handle，而不发布它的内部作用域、state 单元或运行时对象。exposes 命名一个具体的记录契约，恰好一个 expose 提供匹配的值，因此父组件只有一条有文档的入口。Handle 函数用于 focus、reset、open、close 这类命令式操作，并且优先提供读取函数，而不是发布可变状态。")}
                </Paragraph>
                <CodeBlock code={handleCode} />
                <BulletList>
                    <li>
                        {locale.text("ref is a compiler-owned directive rather than a prop. It requires a mutable optional let binding because cleanup restores null, and a component prop cannot be named ref.", "ref 是编译器拥有的指令，而不是 prop。它要求一个可变的可选 let 绑定，因为清理会把它恢复为 null；组件 prop 也不能命名为 ref。")}
                    </li>
                    <li>
                        {locale.text("expose may be written before or after the single return but not inside a branch, a function, or a lifecycle block. The root is constructed before the Handle value is evaluated, so exposed element refs already refer to their constructed elements.", "expose 可以写在唯一的 return 之前或之后，但不能写在分支、函数或生命周期块内部。根先于 Handle 值构造，因此被暴露的元素 ref 已经指向它们构造好的元素。")}
                    </li>
                    <li>
                        {locale.text("The runtime creates one shallow-frozen Handle per instance, and its callable fields are guarded: after the instance is destroyed, a saved old Handle throws instead of reaching destroyed state or DOM.", "运行时为每个实例创建一个浅冻结的 Handle，其可调用字段带守卫：实例销毁后，保存下来的旧 Handle 会抛错，而不是触及已销毁的状态或 DOM。")}
                    </li>
                </BulletList>
                <Paragraph>
                    {locale.text("A component with no exposes clause publishes no Handle, and asking for one on the invocation is refused at the ref rather than at the call that would have used it.", "没有 exposes 子句的组件不发布 Handle；在调用处索取 Handle 会在 ref 处被拒绝，而不是留到之后使用它的调用才失败。")}
                </Paragraph>
                <CodeBlock code={refErrorCode} />
                <CodeBlock code={refErrorOutput} />

                <SectionHeading id="native">{locale.text("The native element vocabulary", "原生元素词汇表")}</SectionHeading>
                <Paragraph>
                    {locale.text("Ordinary elements, void elements, a custom element under the platform convention, SVG, and MathML are all native spellings the compiler knows. An unknown one is a diagnostic with a suggestion rather than an element quietly rendered as-is. Inline SVG is part of native JSX: namespace ownership crosses nested elements, reactive branches, keyed lists, fragments, and user components.", "普通元素、void 元素、符合平台约定的自定义元素、SVG 与 MathML，都是编译器认识的原生拼写。未知拼写会得到一条带建议的诊断，而不是被静默地原样渲染。内联 SVG 属于原生 JSX：命名空间的归属会跨越嵌套元素、响应式分支、带 key 的列表、fragment 与用户组件。")}
                </Paragraph>
                <CodeBlock code={nativeCode} />
                <Callout title={locale.text("Styling stays declarative", "样式保持声明式")}>
                    <Paragraph>
                        {locale.text("A Handle is for commands, not for styling. Every component already accepts class, look, and look:* on its stable host, and a component that wants its internal parts styled exposes named Look props instead of leaking DOM through its Handle.", "Handle 用于命令，不用于样式。每个组件的稳定 host 本来就接受 class、look 与 look:*；需要让内部部件可被设定样式的组件，应当暴露具名的 Look prop，而不是通过 Handle 泄漏 DOM。")}
                    </Paragraph>
                </Callout>
            </Prose>
            <DocsPager previous={guidePrevious("/guide/web/components")} next={guideNext("/guide/web/components")} />
        </DocsShell>
    </main>
