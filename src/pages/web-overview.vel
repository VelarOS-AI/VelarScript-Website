import {Head} from "velar/web"
import {BulletList, Callout, CodeBlock, DocsPager, DocsShell, MemberRow, MemberTable, PageHeader, Paragraph, Prose, SectionHeading, SectionList} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {guideNav, guideNext, guidePrevious, headTitle} from "../content.vel"

const manifestJsonCode = `{\n  "formatVersion": 2,\n  "entry": "src/main.vel",\n  "outDir": "dist",\n  "extensions": ["@velarscript/web"]\n}`
const entryAppCode = `import {rgb, spacing} from "velar/look"\n\ntype Task:\n    id: string\n    title: string\n    done: bool\n\nconst panelLook = look:\n    display = "grid"\n    gap = 8px\n    padding = spacing(16px, 20px)\n    color = rgb(24, 31, 46)\n\ncomponent TaskPanel(title: string):\n    state tasks: List<Task> = [{id: "read", title: "Read the chapter", done: false}]\n\n    const open = computed(() => tasks.filter(task => not task.done).size)\n\n    def complete():\n        tasks[0].done = true\n\n    return <section look={panelLook}>\n        <h1>{title}</h1>\n        <p>{f"{open()} of {tasks.size} open"}</p>\n        <button type="button" on:click={complete}>Complete the first task</button>\n    </section>\n\nmount(<TaskPanel title="Tasks" />, "#app")`
const vocabularyCode = `import {after} from "velar/browser"\nimport {animate, rgb} from "velar/look"\n\ntype BadgeHandle:\n    refresh: () -> null\n\nconst spin = keyframes:\n    from:\n        rotate = 0deg\n    to:\n        rotate = 1turn\n\nconst badgeLook = look:\n    color = rgb(24, 31, 46)\n    padding = 8px\n    animation = animate(spin, 1s, easing="linear", loop=true)\n\nasync def loadLabel() -> string:\n    await Promise.sleep(10ms)\n    return "ready"\n\ncomponent Badge(title: string) exposes BadgeHandle:\n    state opened = false\n    resource label: string = loadLabel()\n    let stop: (() -> null)? = null\n\n    const heading = computed(() => f"{title}: {label.value ?? "loading"}")\n\n    watch opened:\n        print(f"opened is now {opened}")\n\n    action reload():\n        await label.reload()\n\n    def refresh():\n        async label.reload()\n\n    def open():\n        opened = true\n\n    @mounted:\n        stop = after(120ms, open)\n\n    @cleanup:\n        if stop != null:\n            stop()\n\n    expose {refresh}\n    return <button type="button" look={badgeLook} on:click={reload}>{heading()}</button>`
const contextualCode = `// Each contextual keyword declares only in its own shape, so every one of them\n// is still an ordinary name in every other position.\nconst state = "ready"\nconst action = "save"\nconst look = "plain"\n\ncomponent Status:\n    state phase = state\n\n    def promote():\n        phase = action\n\n    return <p data-status={look} on:dblclick={promote}>{phase}</p>`
const mountCode = `component Secondary:\n    return <p data-secondary>a second root</p>\n\n// mount(node, target) attaches one root and answers null. The target is a CSS\n// selector string or an element, and one component instance mounts exactly\n// once: a repeated mount fails explicitly rather than moving DOM silently.\nexport def mountSpellings(target: Element):\n    mount(<Secondary />, "#tour-secondary")\n    mount(<Secondary />, target)\n\n// The root is constructed synchronously, so a direct await inside the argument\n// is rejected. Module-level preload work is awaited into a binding first.\nexport async def mountAfterPreload() -> string:\n    await Promise.sleep(1ms)\n    const label = "preloaded"\n    mount(<Secondary />, "#tour-secondary")\n    return label`
const reservedErrorCode = "component Panel:\n    const computed = 1\n    const tick = 2\n    return <p>{computed + tick}</p>"
const reservedErrorOutput = "main.vel:2:11 error VEL3007: 'computed' is a reserved extension binding\n    const computed = 1\n          ^^^^^^^^\n\nmain.vel:3:11 error VEL3007: 'tick' is a reserved extension binding\n    const tick = 2\n          ^^^^"

const sections = [
    {id: "activation", label: "Activation is declared", labelZh: "激活是声明出来的"},
    {id: "entry", label: "One entry, one root", labelZh: "一个入口，一个根"},
    {id: "vocabulary", label: "What the extension owns", labelZh: "扩展拥有什么"},
    {id: "reserved", label: "Six words a module refuses", labelZh: "模块拒绝的六个词"},
    {id: "mount", label: "mount attaches one root", labelZh: "mount 挂载唯一的根"},
    {id: "modules", label: "The module surface", labelZh: "模块表面"},
]

const moduleRows: List<MemberRow> = [
    {name: "velar/web", signature: "route, Router, Link, NavLink, lazy, navigate, currentRoute, Head, announce, domId", summary: "Routing, navigation, document metadata, and the live region.", summaryZh: "路由、导航、文档元数据与 live region。"},
    {name: "velar/app", signature: "onError, reportError", summary: "The application error chain every managed failure reports through.", summaryZh: "每个受管失败都经由其上报的应用错误链。"},
    {name: "velar/config", signature: "publicConfig, has, keys", summary: "The manifest's public configuration block, validated against a type.", summaryZh: "清单的公开配置块，按类型验证。"},
    {name: "velar/look", signature: "border, rgb, spacing, tracks, animate, transition, and the rest", summary: "The visual builders and the published visual type names.", summaryZh: "视觉构建器与已发布的视觉类型名。"},
    {name: "velar/browser", signature: "after, every, focus, measure, environment, watchMedia, showDialog", summary: "Timers, environment reads, layout readouts, and element controls.", summaryZh: "定时器、环境读取、布局读数与元素控制。"},
    {name: "velar/forms", signature: "read, values, textValue, setError, focusFirstError, setPending", summary: "Reading a native form and owning its accessible error surface.", summaryZh: "读取原生表单并拥有其无障碍错误表面。"},
    {name: "velar/files", signature: "pick, readText, readDataUrl, download", summary: "The file picker, bounded reads, and text downloads.", summaryZh: "文件选择器、有界读取与文本下载。"},
    {name: "velar/http", signature: "http, formBody, HttpError, HttpTransportError, HttpAbortError", summary: "Lazy requests, multipart bodies, and the discriminated failure classes.", summaryZh: "惰性请求、multipart 请求体，以及被区分的失败类。"},
    {name: "velar/storage", signature: "storage, session, database", summary: "Typed local, session, and IndexedDB stores.", summaryZh: "带类型的 local、session 与 IndexedDB 存储。"},
    {name: "velar/realtime", signature: "socket, eventStream", summary: "Text WebSockets and server-sent events as owned handles.", summaryZh: "作为受拥有句柄的文本 WebSocket 与服务器推送事件。"},
    {name: "velar/web-test", signature: "browser, localStorage, sessionStorage, network", summary: "The browser-test controllers, available only under velar test --browser.", summaryZh: "浏览器测试控制器，仅在 velar test --browser 下可用。"},
]

export component WebOverview:
    const locale = useLocale()
    return <main>
        <Head
            title={headTitle("/guide/web", locale.isChinese())}
            description={locale.text("Activating @velarscript/web in velar.json, the vocabulary the extension adds, and how one root is mounted.", "在 velar.json 中激活 @velarscript/web、扩展加入的词汇表，以及如何挂载唯一的根。")}
            themeColor="#f7f5f0"
        />
        <DocsShell items={guideNav}>
            <PageHeader
                kicker={locale.text("Web extension / 01", "Web 扩展 / 01")}
                title={locale.text("Activating the extension", "激活扩展")}
                summary={locale.text("How an extension is activated, which words it owns, and what mount attaches.", "扩展如何激活、它拥有哪些词，以及 mount 挂载了什么。")}
            />
            <SectionList items={sections} />
            <Prose>
                <SectionHeading id="activation">{locale.text("Activation is declared", "激活是声明出来的")}</SectionHeading>
                <Paragraph>
                    {locale.text("The language core contains no JSX, no components, no reactivity, and no styling. A project that wants them lists @velarscript/web in velar.json, and only then do those words exist in its modules. A module in a project without the extension is checked as ordinary Core, where component and look are unremarkable identifiers.", "语言核心不包含 JSX、组件、响应式与样式。需要它们的项目在 velar.json 中列出 @velarscript/web，此后这些词才在其模块中存在。未启用扩展的项目里，模块按普通 Core 受检，component 与 look 只是平常的标识符。")}
                </Paragraph>
                <CodeBlock code={manifestJsonCode} />
                <BulletList>
                    <li>
                        {locale.text("extensions is a list, so a project may activate more than one extension.", "extensions 是一个列表，因此一个项目可以激活多个扩展。")}
                    </li>
                    <li>
                        {locale.text("entry names the one module the compiler starts from; a .vel file the entry cannot reach is not checked.", "entry 命名编译器的起点模块；入口无法到达的 .vel 文件不参与检查。")}
                    </li>
                    <li>
                        {locale.text("The same manifest carries the web block that velar/config reads and the build settings the CLI uses.", "同一份清单还携带 velar/config 读取的 web 块与 CLI 使用的构建设置。")}
                    </li>
                </BulletList>

                <SectionHeading id="entry">{locale.text("One entry, one root", "一个入口，一个根")}</SectionHeading>
                <Paragraph>
                    {locale.text("A Web application is an ordinary module graph whose entry ends with a mount call. Nothing about the file is special: the type, the Look, the component, and the state below are the same declarations any other module writes.", "Web 应用是一张普通的模块图，其入口以一次 mount 调用结束。这个文件本身没有任何特殊之处：下面的类型、Look、组件与状态，与其他模块写的是同样的声明。")}
                </Paragraph>
                <CodeBlock code={entryAppCode} />

                <SectionHeading id="vocabulary">{locale.text("What the extension owns", "扩展拥有什么")}</SectionHeading>
                <Paragraph>
                    {locale.text("The charter names the complete addition: ten contextual keywords, two lifecycle hooks, three reserved global functions, the unsafe CSS import, and the unit literals. Nothing else in a Web module is new syntax, so everything not on that list is Core and behaves exactly as the language chapters describe it.", "典章列出了完整的增补：十个上下文关键字、两个生命周期钩子、三个保留的全局函数、unsafe CSS 导入，以及单位字面量。Web 模块中再没有别的新语法，因此不在这份清单上的一切都属于 Core，行为与语言各章所述完全一致。")}
                </Paragraph>
                <CodeBlock code={vocabularyCode} />
                <BulletList>
                    <li>
                        {locale.text("The contextual keywords are component with exposes and expose, state, resource, action, watch, look, keyframes, and css in the unsafe stylesheet import.", "上下文关键字是：带 exposes 与 expose 的 component、state、resource、action、watch、look、keyframes，以及 unsafe 样式表导入中的 css。")}
                    </li>
                    <li>
                        {locale.text("The two lifecycle hooks are @mounted and @cleanup, written as siblings inside a component.", "两个生命周期钩子是 @mounted 与 @cleanup，作为兄弟块写在组件内部。")}
                    </li>
                    <li>
                        {locale.text("JSX itself, including fragments and the host marker, is part of the grammar rather than a preprocessor step.", "JSX 本身——包括 fragment 与 host 标记——属于语法，而不是预处理步骤。")}
                    </li>
                </BulletList>
                <Paragraph>
                    {locale.text("A contextual keyword declares only in its own shape, so it stays available as an ordinary name everywhere else. This module binds state, action, and look as constants and still declares component state in the same file.", "上下文关键字只在自己的形状中起声明作用，因此在其他位置它仍然是可用的普通名字。下面这个模块把 state、action 与 look 绑定为常量，同一个文件里仍然声明了组件 state。")}
                </Paragraph>
                <CodeBlock code={contextualCode} />

                <SectionHeading id="reserved">{locale.text("Six words a module refuses", "模块拒绝的六个词")}</SectionHeading>
                <Paragraph>
                    {locale.text("Three reserved globals — computed, mount, and tick — are real runtime entry points, and the three media subjects — viewport, scheme, and motion — are read by Look conditions. A Web module refuses all six as binding names, and those six words are the whole difference between what a Core module accepts and what a Web module accepts.", "三个保留全局——computed、mount 与 tick——是真实的运行时入口，三个媒体主语——viewport、scheme 与 motion——由 Look 条件读取。Web 模块拒绝把这六个词用作绑定名；这六个词就是 Core 模块与 Web 模块在可接受范围上的全部差别。")}
                </Paragraph>
                <CodeBlock code={reservedErrorCode} />
                <CodeBlock code={reservedErrorOutput} />

                <SectionHeading id="mount">{locale.text("mount attaches one root", "mount 挂载唯一的根")}</SectionHeading>
                <Paragraph>
                    {locale.text("mount(node, target) attaches one root to the document and answers null. The target is a CSS selector string or an element. The root is constructed synchronously so the runtime can own its failure transaction, which is why a direct await inside the argument is rejected and preload work is awaited into a binding first.", "mount(node, target) 把一个根挂载到文档并返回 null。target 是 CSS 选择器字符串或一个元素。根是同步构造的，运行时才能拥有它的失败事务，因此参数中直接写 await 会被拒绝，预加载工作要先 await 进一个绑定。")}
                </Paragraph>
                <CodeBlock code={mountCode} />
                <BulletList>
                    <li>
                        {locale.text("One component instance mounts exactly once; a repeated mount fails explicitly rather than moving DOM silently.", "同一个组件实例只挂载一次；重复挂载会显式失败，而不是静默地搬运 DOM。")}
                    </li>
                    <li>
                        {locale.text("Root mounting is lazy: if the initial render fails, the application receives the report and an accessible fatal state is rendered instead of a blank page.", "根挂载是惰性的：若首次渲染失败，应用会收到报告，并渲染一个可访问的致命状态，而不是空白页。")}
                    </li>
                    <li>
                        {locale.text("A missing mount target reports through the mount phase and renders that fatal state into the document body, since the requested target is exactly what is absent.", "缺失的 mount 目标经由 mount 阶段上报，并把该致命状态渲染进文档 body，因为缺的恰好就是被请求的目标。")}
                    </li>
                </BulletList>

                <SectionHeading id="modules">{locale.text("The module surface", "模块表面")}</SectionHeading>
                <Paragraph>
                    {locale.text("Browser capabilities arrive as explicit modules rather than ambient globals. Direct source-level use of console, document, window, navigator, location, history, fetch, JSON, Math, or Date is reported as VEL3008, and the diagnostic names the official module to import instead. Each official module captures the host objects it needs when it initializes, so JavaScript loaded later cannot redirect an official operation.", "浏览器能力以显式模块而不是环境全局的形式出现。在源码层面直接使用 console、document、window、navigator、location、history、fetch、JSON、Math 或 Date 会得到 VEL3008，诊断会指出应改为导入哪个官方模块。每个官方模块在初始化时捕获它需要的宿主对象，因此稍后加载的 JavaScript 无法改道一次官方操作。")}
                </Paragraph>
                <MemberTable
                    rows={moduleRows}
                    caption={locale.text("The modules the Web extension publishes", "Web 扩展发布的模块")}
                />
                <Callout title={locale.text("Where the Core language stops", "Core 语言在哪里结束")}>
                    <Paragraph>
                        {locale.text("Everything in the language chapters keeps working inside a Web module: the same types, the same collections, the same control flow, the same error rules. Reading a Web chapter is therefore reading an addition, never a replacement.", "语言各章的一切在 Web 模块中照常有效：同样的类型、同样的集合、同样的控制流、同样的错误规则。因此读 Web 章节读到的始终是增补，而不是替换。")}
                    </Paragraph>
                </Callout>
            </Prose>
            <DocsPager previous={guidePrevious("/guide/web")} next={guideNext("/guide/web")} />
        </DocsShell>
    </main>
