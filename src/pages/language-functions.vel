import {Head} from "velar/web"
import {BulletList, Callout, CodeBlock, DocsPager, DocsShell, PageHeader, Paragraph, Prose, SectionHeading, SectionList} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {guideNav, guideNext, guidePrevious, headTitle} from "../content.vel"

const declaringCode = `type User:\n    id: string\n    name: string\n    avatar: string?\n\nexport def formatUser(user: User, prefix: string = "@") -> string:\n    return f"{prefix}{user.name}"\n\n// A body-backed function may omit its result annotation. Where the inferred\n// result is null, omitting it is required.\nexport def inferredNull():\n    print("nothing a caller can use")\n\nexport def inferredText(flag: bool):\n    if flag:\n        return "yes"\n    return "no"\n\n// A partial return infers an optional result.\nexport def inferredOptional(flag: bool):\n    if flag:\n        return "yes"\n\n// An explicit result stays a checked contract: every reachable path returns.\nexport def explicitResult(flag: bool) -> string:\n    if flag:\n        return "yes"\n    return "no"\n\n// Recursive result dependencies solve to a fixed point.\ndef countDown(value: number):\n    if value <= 0:\n        return 0\n    return countDown(value - 1)`
const callsCode = `type User:\n    id: string\n    name: string\n\ndef formatUser(user: User, prefix: string = "@") -> string:\n    return f"{prefix}{user.name}"\n\nconst user: User = {id: "u-1", name: "Ada"}\n\nconst first = formatUser(user)\nconst second = formatUser(user, prefix="#")\nconst third = formatUser(user, "!")\nconst named = formatUser(user=user, prefix="?")\n\n// Named arguments may be reordered; source expressions still evaluate left to\n// right.\nconst reordered = formatUser(prefix="~", user=user)\n\n// Once a fixed parameter has a default, every following fixed parameter does\n// too, so positional and named calls stay identical.\ndef label(text: string, prefix: string = "[", suffix: string = "]") -> string:\n    return prefix + text + suffix\n\nconst defaulted = label("a")\nconst oneDefaultGiven = label("a", "<")\nconst bothDefaultsGiven = label("a", "<", ">")\nconst suffixOnly = label("a", suffix=">")`
const colonErrorCode = `def label(text: string, prefix: string = "[") -> string:\n    return prefix + text\n\nconst labelled = label("a", prefix: "<")`
const colonErrorOutput = `main.vel:4:29 error VEL2024: Write '=' between the name and value for named argument 'prefix': prefix = value\nconst labelled = label("a", prefix: "<")\n                            ^^^^^^`
const arrowsCode = `const values: List<number> = [1, 2, 3]\nconst doubled = values.map(value => value * 2)\nconst annotatedArrow = values.map((value: number) => value * 3)\nconst parenthesizedParameter = values.map((value) => value + 1)\nconst twoParameters = (left: number, right: number) => left + right\nconst noParameters = () => "a"\n\n// After the arrow a brace opens a record, never a block.\nconst recordFactory = () => {id: "a"}\nconst emptyRecordFactory = () => {}\n\n// A function that should do nothing answers null.\nconst doesNothing = () => null\n\n// A callback that needs two statements becomes a named def.\ndef describeValue(value: number) -> string:\n    const scaled = value * 10\n    return f"{value} -> {scaled}"\n\nconst described = values.map(describeValue)\n\n// A callback may use a local parameter name while satisfying a named contract.\nconst localName: (request: string) -> string = _request => _request.upper()\n\n// An unannotated arrow parameter takes its type from the annotation it is\n// assigned to; with no annotation on either side it is unknown.\nconst contextuallyTypedArrow: (number) -> number = value => value * 2`
const restCode = "const values: List<number> = [1, 2, 3]\n\nexport def total(...amounts: number) -> number:\n    return amounts.sum()\n\nexport def totalWithBase(base: number, ...amounts: number) -> number:\n    return base + amounts.sum()\n\nexport def totalWithDefault(base: number = 0, ...amounts: number) -> number:\n    return base + amounts.sum()\n\nconst summed = total(1, 2, 3)\nconst spreadInto = total(...values)\nconst fixedThenSpread = totalWithBase(10, ...values)"
const asyncCode = `type User:\n    id: string\n    name: string\n\ndef apiUser(id: string) -> User:\n    return {id, name: "Ada"}\n\nexport async def loadUser(id: string) -> User:\n    return apiUser(id)\n\n// The call type is a Promise of the annotated value; the declaration annotates\n// the resolved value, never the Promise around it.\nconst pending: Promise<User> = loadUser("u-1")\n\nexport async def inferredAsyncResult():\n    print("an async declaration with no value result infers a null result")\n\nexport async def awaitsAndDetaches():\n    // await waits; the async statement runs the task detached and requires a\n    // checked promise of null.\n    await loadUser("u-1")\n    async inferredAsyncResult()\n\nconst asyncArrow = async (id: string) => await loadUser(id)\nconst contextuallyTypedAsyncArrow: (string) -> Promise<User> = async id => await loadUser(id)`
const droppedErrorCode = `async def save() -> string:\n    return "saved"\n\nexport def run():\n    save()`
const droppedErrorOutput = "main.vel:5:5 error VEL4027: This call returns Promise<string>; 'await save()' to wait for it, or 'async save()' to run it detached\n    save()\n    ^^^^^^"
const genericsCode = `export def mapValues<T, U>(items: List<T>, transform: (T) -> U) -> List<U>:\n    return items.map(transform)\n\nconst flags: List<bool> = mapValues(["a", ""], value => value != "")\n\n// Type arguments are inferred at each call site; there is no explicit\n// instantiation syntax, and a parameter the call leaves unsolved is unknown.\nexport def identity<T>(value: T) -> T:\n    return value\n\nconst identicalText = identity("a")\nconst identicalNumber = identity(1)\n\n// The three closed bounds.\nexport def label<T: Text>(value: T) -> string:\n    return f"{value}"\n\nexport def ranked<T: Comparable>(values: List<T>) -> List<T>:\n    return values.sorted()\n\nexport def smallest<T: Comparable>(values: List<T>) -> T?:\n    return values.min()\n\nexport def encoded<T: Data>(value: T) -> string:\n    return Json.stringify(value)\n\nexport def cloned<T: Data>(value: T) -> T:\n    return Json.clone(value)\n\nconst labelled = label(5)\nconst rankedText = ranked(["b", "a"])\nconst encodedRecord = encoded({id: "u-1"})\n\n// A class method takes type parameters too.\nclass Registry:\n    let stored: List<unknown> = []\n\n    def keep<T>(value: T) -> T:\n        self.stored.append(value)\n        return value`

const sections = [
    {id: "declaring", label: "Parameters and results", labelZh: "参数与结果"},
    {id: "calls", label: "Positional, then named", labelZh: "先位置，后具名"},
    {id: "arrows", label: "Arrows", labelZh: "箭头函数"},
    {id: "rest", label: "Rest parameters and spread", labelZh: "剩余参数与展开"},
    {id: "async", label: "Async functions", labelZh: "async 函数"},
    {id: "generics", label: "Type parameters and bounds", labelZh: "类型参数与界"},
]

export component LanguageFunctions:
    const locale = useLocale()
    return <main>
        <Head
            title={headTitle("/guide/language/functions", locale.isChinese())}
            description={locale.text("How functions declare parameters and results, how calls order positional and named arguments, and what async adds.", "函数如何声明参数与结果、调用如何排列位置实参与具名实参，以及 async 增加了什么。")}
            themeColor="#f7f5f0"
        />
        <DocsShell items={guideNav}>
            <PageHeader
                kicker={locale.text("Language / 05", "语言 / 05")}
                title={locale.text("Functions and calls", "函数与调用")}
                summary={locale.text("Parameters and defaults, result inference, named arguments, arrows, async, and the three closed bounds.", "参数与默认值、结果推断、具名实参、箭头函数、async，以及三个封闭的界。")}
            />
            <SectionList items={sections} />
            <Prose>
                <SectionHeading id="declaring">{locale.text("Parameters and results", "参数与结果")}</SectionHeading>
                <Paragraph>
                    {locale.text("A parameter states its type, and a default is written at the declaration rather than reconstructed in the body. A body-backed function may omit its result annotation; where the inferred result is null, omitting it is required, so a declaration that writes an arrow always promises something a caller can use. An explicit result stays a checked contract on every reachable path.", "参数写出自己的类型，默认值写在声明处，而不是在函数体里重建。有函数体的函数可以省略结果注解；当推断结果为 null 时必须省略，因此写出了箭头的声明总是承诺了调用方能用的东西。显式结果在每条可达路径上都保持为受检契约。")}
                </Paragraph>
                <CodeBlock code={declaringCode} />
                <BulletList>
                    <li>
                        {locale.text("A function that returns on some paths and falls off the end on others infers an optional result.", "在部分路径返回、其余路径落到末尾的函数，推断出的是可选结果。")}
                    </li>
                    <li>
                        {locale.text("Recursive result dependencies solve to a fixed point, so a recursive helper needs no annotation to break a cycle.", "递归的结果依赖会解到不动点，因此递归辅助函数不需要靠注解来打断循环。")}
                    </li>
                </BulletList>

                <SectionHeading id="calls">{locale.text("Positional, then named", "先位置，后具名")}</SectionHeading>
                <Paragraph>
                    {locale.text("A call writes positional arguments first and named arguments after, and named arguments may be reordered while source expressions still evaluate left to right. Once a fixed parameter has a default every following fixed parameter does too, which is what keeps the positional and the named reading of one call identical.", "调用先写位置实参，再写具名实参；具名实参可以重排，而源表达式仍按从左到右求值。一旦某个固定参数带上默认值，其后的每个固定参数也必须带，正是这一点让同一次调用的位置读法与具名读法完全一致。")}
                </Paragraph>
                <CodeBlock code={callsCode} />
                <Paragraph>
                    <strong>{locale.text("What the compiler refuses", "编译器拒绝的写法")}</strong>
                </Paragraph>
                <CodeBlock code={colonErrorCode} />
                <Paragraph>
                    <strong>{locale.text("What velar check answers", "velar check 的回答")}</strong>
                </Paragraph>
                <CodeBlock code={colonErrorOutput} />

                <SectionHeading id="arrows">{locale.text("Arrows", "箭头函数")}</SectionHeading>
                <Paragraph>
                    {locale.text("An arrow carries one expression. A parameter may be bare, parenthesized, or annotated; an unannotated parameter takes its type from the annotation the arrow is assigned to. A callback that needs two statements becomes a named def, which is why an arrow body never opens a block and a brace after the arrow opens a record.", "箭头承载一个表达式。参数可以是裸的、加括号的或带注解的；未注解的参数从箭头被赋值到的那个注解取得类型。需要两条语句的回调改写成具名 def——这正是箭头体从不开启块、而箭头之后的花括号打开的是记录的原因。")}
                </Paragraph>
                <CodeBlock code={arrowsCode} />

                <SectionHeading id="rest">{locale.text("Rest parameters and spread", "剩余参数与展开")}</SectionHeading>
                <Paragraph>
                    {locale.text("A rest parameter collects the remaining positional arguments into a List of one element type, and the same three dots spread a List back into a call. Fixed parameters may precede a rest parameter, with or without defaults.", "剩余参数把余下的位置实参收进一个单一元素类型的 List，同样的三个点也把 List 展开回一次调用。固定参数可以出现在剩余参数之前，带默认值与否都可以。")}
                </Paragraph>
                <CodeBlock code={restCode} />

                <SectionHeading id="async">{locale.text("Async functions", "async 函数")}</SectionHeading>
                <Paragraph>
                    {locale.text("An async declaration annotates the resolved value, and the call type is the Promise around it. There are two ways to consume a call that answers a Promise: await waits for it, and the async statement runs it detached. A call whose Promise is dropped is a diagnostic, so a task that nobody is waiting for is a written decision rather than an omission.", "async 声明注解的是解析后的值，而调用类型是包在外面的 Promise。消费返回 Promise 的调用有两种写法：await 等待它，async 语句让它脱离当前流程运行。直接丢弃 Promise 的调用会得到诊断，因此「没有人等待这个任务」是一个写出来的决定，而不是一次遗漏。")}
                </Paragraph>
                <CodeBlock code={asyncCode} />
                <Paragraph>
                    <strong>{locale.text("What the compiler refuses", "编译器拒绝的写法")}</strong>
                </Paragraph>
                <CodeBlock code={droppedErrorCode} />
                <Paragraph>
                    <strong>{locale.text("What velar check answers", "velar check 的回答")}</strong>
                </Paragraph>
                <CodeBlock code={droppedErrorOutput} />

                <SectionHeading id="generics">{locale.text("Type parameters and bounds", "类型参数与界")}</SectionHeading>
                <Paragraph>
                    {locale.text("Type parameters exist on functions and on class methods. Type arguments are inferred at each call site and there is no explicit instantiation syntax. Three bounds are published — Comparable for ordering, Text for conversion to text, and Data for structured encoding — and the list is closed: there is no constraint language a library could extend.", "类型参数存在于函数与类方法上。类型实参在每个调用处推断，且没有显式实例化语法。已发布的界有三个——用于排序的 Comparable、用于转为文本的 Text、用于结构化编码的 Data——这份清单是封闭的：不存在可供库扩展的约束语言。")}
                </Paragraph>
                <CodeBlock code={genericsCode} />
                <Callout title={locale.text("Why the bound list is closed", "界的清单为何封闭")}>
                    <Paragraph>
                        {locale.text("A user-defined bound would put the reader back to reading a library before reading the code in front of them. The same reason keeps decorators out: the modifier keywords are a closed vocabulary the compiler owns, and a new marking arrives as a new keyword rather than as an extension point.", "用户自定义的界会让读者在读眼前这段代码之前，先得去读一个库。装饰器被排除在外是同样的理由：修饰关键字是一份由编译器持有的封闭词汇，新的标记以新关键字的形式到来，而不是作为扩展点。")}
                    </Paragraph>
                </Callout>
            </Prose>
            <DocsPager
                previous={guidePrevious("/guide/language/functions")}
                next={guideNext("/guide/language/functions")}
            />
        </DocsShell>
    </main>
