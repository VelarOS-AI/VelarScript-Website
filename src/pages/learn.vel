import {Head, Link} from "velar/web"
import {ActionLink, CodeWindow, Container, Eyebrow, Section, Surface, foundationInk as ink, foundationInkSoft as inkSoft, foundationSea as sea, useLocale} from "@velarscript/site-ui"

const createCode = "npm create velar@latest my-app\ncd my-app\nnpm install\nnpm run dev"
const dependencyCode = "velar install\nvelar add chart-library\nvelar add test-helper --dev\nvelar update\nvelar remove chart-library"
const valuesCode = "type Player:\n    name: string\n    score: number\n\nconst player: Player = {name: \"Mira\", score: 12}\nlet bonus = 3\n\nif player.score > 10:\n    bonus += 2\n\nprint(f\"{player.name}: {player.score + bonus}\")"
const componentCode = "const cardLook = look:\n    display = grid\n    gap = 12px\n\nexport component ScoreCard(player: Player):\n    state expanded = false\n    computed total = player.score + 5\n\n    return <article look={cardLook}>\n        <h2>{player.name}</h2>\n        <strong>{total} points</strong>\n        <button on:click={() => expanded = not expanded}>\n            {expanded ? \"Hide\" : \"Show\"} details\n        </button>\n    </article>"
const shipCode = "velar format --check\nvelar check\nvelar test\nvelar test --browser\nvelar build\nvelar verify"

const heroLook = look:
    paddingTop = clamp(76px, 11vw, 144px)
    paddingBottom = clamp(56px, 8vw, 96px)

const heroTitleLook = look:
    maxWidth = 1080px
    margin = 0
    marginTop = 18px
    fontSize = clamp(4rem, 10vw, 9rem)
    lineHeight = 0.88
    letterSpacing = -0.07em

const introLook = look:
    maxWidth = 740px
    margin = 0
    marginTop = 30px
    color = inkSoft
    fontSize = clamp(1.12rem, 2.2vw, 1.4rem)
    lineHeight = 1.65

const chapterLook = look:
    display = grid
    columns = tracks(minmax(230px, 0.42fr), minmax(0px, 1fr))
    gap = clamp(40px, 8vw, 110px)

    if viewport.width <= 800px:
        columns = tracks(1fr)

const chapterCopyLook = look:
    display = grid
    alignContent = start
    gap = 18px

const chapterNumberLook = look:
    margin = 0
    color = sea
    font = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.74rem

const chapterTitleLook = look:
    margin = 0
    fontSize = clamp(2rem, 4vw, 3.7rem)
    lineHeight = 1
    letterSpacing = -0.055em

const chapterTextLook = look:
    margin = 0
    color = inkSoft
    lineHeight = 1.7

const noteLook = look:
    padding = 20px
    color = inkSoft
    lineHeight = 1.65

const noteTitleLook = look:
    display = block
    marginBottom = 7px
    color = ink

const nextLook = look:
    display = grid
    columns = tracks(1fr, auto)
    alignItems = end
    gap = 40px
    padding = clamp(38px, 6vw, 70px)

    if viewport.width <= 800px:
        columns = tracks(1fr)

const nextTitleLook = look:
    margin = 0

const nextTextLook = look:
    maxWidth = 650px
    margin = 0
    marginTop = 16px
    color = inkSoft
    lineHeight = 1.7

const chapterLinkLook = look:
    color = sea
    fontWeight = 700

export component Learn:
    const locale = useLocale()
    return <main>
        <Head title={locale.text("Learn VelarScript", "学习 VelarScript")} description={locale.text("Learn the VelarScript language and its integrated Web framework from the first project to a verified production build.", "从第一个项目开始，学习 VelarScript 语言及其一体化 Web 框架，直到经过验证的生产构建。")} themeColor="#f7f5f0" />
        <section class="hero" look={heroLook} data-learn-page><Container><Eyebrow label={locale.text("Learn VelarScript", "学习 VelarScript")} /><h1 look={heroTitleLook}>{locale.text("Readable from the first line.", "从第一行开始就清晰易读。")}</h1><p class="intro" look={introLook}>{locale.text("If you know a little Python or JavaScript, VelarScript should feel familiar in minutes. This path introduces only the ideas you need, in the order you need them.", "只要了解一点 Python 或 JavaScript，你几分钟内就能熟悉 VelarScript。这条路径只介绍你真正需要的概念，并按需要出现的顺序组织。")}</p></Container></section>

        <Section ruled={true}><Container><div class="chapter" look={chapterLook}><div class="chapter-copy" look={chapterCopyLook}><span class="number" look={chapterNumberLook}>01 / {locale.text("CREATE", "创建")}</span><h2 look={chapterTitleLook}>{locale.text("Start with a complete Web project.", "从一个完整的 Web 项目开始。")}</h2><p look={chapterTextLook}>{locale.text("The standard creator gives you a small application, a VelarScript project manifest, Core tests, browser tests, and production scripts. Dedicated docs, Core library, and reusable Web component templates keep each project focused.", "标准创建器会生成一个小型应用、VelarScript 项目清单、Core 测试、浏览器测试和生产脚本。专门的文档、Core 库与可复用 Web 组件模板让每类项目保持专注。")}</p><Surface><div class="note" look={noteLook}><strong look={noteTitleLook}>{locale.text("Development line", "开发版本说明")}</strong>{locale.text("The public npm packages are not released yet. The commands shown here are the stable package contract being validated locally.", "公开 npm 包尚未发布。这里展示的命令是正在本地验证的稳定包契约。")}</div></Surface></div><CodeWindow code={createCode} label="terminal" /></div></Container></Section>

        <Section ruled={true}><Container><div class="chapter" look={chapterLook} data-package-workflow><div class="chapter-copy" look={chapterCopyLook}><span class="number" look={chapterNumberLook}>02 / {locale.text("PACKAGES", "包")}</span><h2 look={chapterTitleLook}>{locale.text("Use one dependency graph.", "只维护一张依赖图。")}</h2><p look={chapterTextLook}>{locale.text("npm remains the registry and lockfile authority. VelarScript adds project-aware commands that validate the result and activate compiler or framework extensions from package metadata—without maintaining a second registry.", "npm 继续负责注册表与锁文件。VelarScript 只增加理解项目的命令，用来验证结果并根据包元数据激活编译器或框架扩展，不维护第二套注册表。")}</p><p look={chapterTextLook}>{locale.text("Use npm directly for local paths, Git sources, aliases, audits, and advanced workspace operations.", "本地路径、Git 来源、别名、审计与高级工作区操作继续直接使用 npm。")}</p></div><CodeWindow code={dependencyCode} label="terminal" /></div></Container></Section>

        <Section ruled={true}><Container><div class="chapter" look={chapterLook}><div class="chapter-copy" look={chapterCopyLook}><span class="number" look={chapterNumberLook}>03 / {locale.text("LANGUAGE", "语言")}</span><h2 look={chapterTitleLook}>{locale.text("Use ordinary data and obvious control flow.", "使用普通数据和清晰控制流。")}</h2><p look={chapterTextLook}>{locale.text("const names a value that will not be rebound. let marks a binding that can change. Indentation makes blocks visible, while expressions remain compact and JavaScript-like.", "const 命名不会重新绑定的值，let 标记可以变化的绑定。缩进让代码块一目了然，而表达式保持紧凑并接近 JavaScript。")}</p><p look={chapterTextLook}>{locale.text("A single type declaration helps the compiler and also validates data when it crosses a runtime boundary.", "同一个类型声明既帮助编译器检查代码，也能在数据跨越运行时边界时进行验证。")}</p></div><CodeWindow code={valuesCode} label="player.vel" /></div></Container></Section>

        <Section ruled={true}><Container><div class="chapter" look={chapterLook}><div class="chapter-copy" look={chapterCopyLook}><span class="number" look={chapterNumberLook}>04 / {locale.text("COMPONENTS", "组件")}</span><h2 look={chapterTitleLook}>{locale.text("Keep behavior, markup, and Look close.", "让行为、结构与 Look 保持靠近。")}</h2><p look={chapterTextLook}>{locale.text("A component is a checked function with a rendered result. state is directly assignable, computed values remain derived, native JSX describes the DOM, and controlled Look values compose like ordinary VelarScript data.", "组件是带渲染结果的受检查函数。state 可以直接赋值，computed 始终由其他值派生，原生 JSX 描述 DOM，受控 Look 像普通 VelarScript 数据一样组合。")}</p><Link to="/docs/language" look={chapterLinkLook}>{locale.text("Explore the language reference →", "查看语言参考 →")}</Link></div><CodeWindow code={componentCode} label="score-card.vel" /></div></Container></Section>

        <Section ruled={true}><Container><div class="chapter" look={chapterLook}><div class="chapter-copy" look={chapterCopyLook}><span class="number" look={chapterNumberLook}>05 / {locale.text("SHIP", "交付")}</span><h2 look={chapterTitleLook}>{locale.text("Verify the application users actually receive.", "验证用户真正收到的应用。")}</h2><p look={chapterTextLook}>{locale.text("The CLI formats and checks source, runs fast Core tests, exercises a CSP production build in real browsers, emits static assets, and verifies the deployment contract.", "CLI 会格式化并检查源码、运行快速 Core 测试、在真实浏览器中验证 CSP 生产构建、生成静态资源并检查部署契约。")}</p><Link to="/docs/web" look={chapterLinkLook}>{locale.text("Explore the Web framework →", "查看 Web 框架 →")}</Link></div><CodeWindow code={shipCode} label="terminal" /></div></Container></Section>

        <Section ruled={true}><Container><Surface><div class="next" look={nextLook}><div><h2 look={nextTitleLook}>{locale.text("Now read by capability.", "现在按能力继续阅读。")}</h2><p look={nextTextLook}>{locale.text("The reference separates the language from browser application services while keeping their design intentionally connected.", "参考文档把语言与浏览器应用服务分开，同时保留两者有意建立的设计联系。")}</p></div><ActionLink to="/docs" label={locale.text("Open documentation", "打开文档")} /></div></Surface></Container></Section>
    </main>
