import {Head, Link} from "velar/web"
import {Callout, DocsShell, PageHeader, Prose} from "@velarscript/docs-kit"
import {InteractionPlayground} from "../components/interaction-playground.vel"
import {docsNav} from "../content.vel"

const activateCode = "{\n  \"formatVersion\": 2,\n  \"entry\": \"src/main.vel\",\n  \"extensions\": [\"@velarscript/web\"],\n  \"web\": {\n    \"title\": \"My App\",\n    \"base\": \"/\",\n    \"build\": {\"sourceMaps\": false},\n    \"security\": {\"contentSecurityPolicy\": true},\n    \"deployment\": {\"spaFallback\": true}\n  }\n}"
const importsCode = "import {Head, Link, Router, route} from \"velar/web\"\nimport {http} from \"velar/http\"\nimport {read} from \"velar/forms\"\nimport {storage} from \"velar/storage\"\nimport {after, focus} from \"velar/browser\""

export component WebDocs:
    return <main data-web-docs>
        <Head title="Web framework · VelarScript" description="The official @velarscript/web framework: native JSX, components, reactivity, routing, data, browser capabilities, tests, and production." themeColor="#f7f5f0" />
        <DocsShell items={docsNav}>
            <PageHeader kicker="Web framework / Overview" title="One official path from component to production." summary="@velarscript/web adds checked browser authoring without changing the JavaScript engine, exposing ambient globals, or introducing a virtual DOM." tags={["Web API 0.8", "native DOM", "scoped CSS", "explicit capabilities"]} />
            <Prose>
                <h2 id="activate">Activate the extension</h2>
                <pre><code>{activateCode}</code></pre>
                <p>The npm dependency provides a compiler entry and a separate Web host entry. The compiler contribution owns JSX, components, state, lifecycle, DOM types, scoped CSS, diagnostics, and editor semantics. The host contribution owns browser documents, development reload, CSP, production assets, deployment projection, and browser-test metadata. The generic CLI stays framework-independent.</p>

                <h2 id="model">Rendering model</h2>
                <p>JSX creates native HTML and SVG nodes. Static DOM and CSS are emitted once; reactive expressions subscribe only to the state they read and patch their owned text, attribute, branch, or keyed-list region. Components set up once and do not rerun as render functions.</p>
                <p>Component CSS is scoped and extracted in production. The parent scope may style a child component's top-level DOM root while arbitrary child internals remain private. Global rules require an explicit <code>style global</code> block.</p>

                <h2 id="modules">Capability modules</h2>
                <pre><code>{importsCode}</code></pre>
                <ul>
                    <li><code>velar/app</code> owns application error reports and recovery.</li>
                    <li><code>velar/config</code> validates explicit public build configuration.</li>
                    <li><code>velar/web</code> owns routing, links, document metadata, navigation, announcements, and DOM IDs.</li>
                    <li><code>velar/http</code> owns lazy bounded requests, strict data, typed responses, multipart bodies, timeout, and cancellation.</li>
                    <li><code>velar/storage</code> owns local/session namespaces, watches, and IndexedDB.</li>
                    <li><code>velar/forms</code> owns native form reads, typed record decoding, accessible errors, pending state, focus, and reset.</li>
                    <li><code>velar/browser</code> owns snapshots, timers, media, visibility, clipboard, focus, scrolling, layout, frames, and dialogs.</li>
                    <li><code>velar/files</code> owns cross-browser file selection, bounded reads, and downloads.</li>
                    <li><code>velar/realtime</code> owns explicit WebSocket and server-sent-event lifetimes.</li>
                    <li><code>velar/web-test</code> drives the delivered CSP application through a restricted typed browser controller.</li>
                </ul>

                <h2 id="native-interaction">Native interaction, composed</h2>
                <p>The framework uses native anchors, forms, dialogs, focus, events, and accessibility relationships. Components can build higher-level UI without replacing platform semantics.</p>
                <InteractionPlayground />

                <h2 id="globals">No ambient browser globals</h2>
                <Callout title="Capabilities stay visible"><p>Direct <code>window</code>, <code>document</code>, <code>navigator</code>, <code>location</code>, <code>history</code>, <code>fetch</code>, <code>JSON</code>, <code>Math</code>, <code>Date</code>, and <code>console</code> are rejected in ordinary source. Diagnostics point to JSX, Core modules, Web modules, or an explicit JavaScript adapter.</p></Callout>

                <h2 id="boundaries">Current boundary</h2>
                <p>Web API 0.8 does not define SSR, hydration, server execution, workers, service workers/PWA, WebRTC, WebGPU, directory handles, persistent file handles, or a game runtime. <code>velar/game</code> remains a future Canvas-oriented framework built on this Web platform.</p>

                <div class="next-links"><Link to="/docs/web/components"><strong>Next: Components and JSX</strong><span>Build native, accessible view trees.</span></Link><Link to="/docs/web/reactivity"><strong>State and lifecycle</strong><span>Own updates, resources, actions, watchers, and cleanup.</span></Link></div>
            </Prose>
        </DocsShell>
    </main>
