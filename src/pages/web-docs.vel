import {Head} from "velar/web"
import {DocsShell, PageHeader, Prose, Callout} from "@velarscript/docs-kit"
import {InteractionPlayground} from "../components/interaction-playground.vel"
import {docsNav} from "../content.vel"

const routerCode = "import {Head, Router, route} from \"velar/web\"\n\nconst routes = [\n    route(\"/\", Home),\n    route(\"/projects/:id\", Project),\n]\n\ncomponent App:\n    return <>\n        <Head title=\"My app\" />\n        <Router routes={routes} />\n    </>"
const dataCode = "import {http} from \"velar/http\"\n\ntype Project:\n    id: string\n    name: string\n\nasync def loadProject(id: string) -> Project:\n    return await http.get(f\"/api/projects/{id}\").parse(Project)"
const testCode = "import {expect} from \"velar/test\"\nimport {browser} from \"velar/web-test\"\n\nasync def test_project_navigation():\n    await browser.open(\"/projects/velar\")\n    expect(await browser.text(\"h1\")).toBe(\"Velar\")\n    await browser.click(\"[data-star]\")\n    expect(await browser.text(\"[data-status]\")).toBe(\"Starred\")"

export component WebDocs:
    return <main data-web-docs>
        <Head title="Web framework · Velar" description="The official @velarscript/web framework and browser capability modules." themeColor="#f7f5f0" />
        <DocsShell items={docsNav}>
            <PageHeader kicker="Reference / Web" title="The official framework is part of the language story." summary="@velarscript/web provides the checked compiler and runtime boundary for browser applications without a virtual DOM or ambient globals." tags={["Web API 0.8", "native DOM", "scoped CSS", "real browser tests"]} />
            <Prose>
                <h2>Components render native JSX</h2>
                <p>Velar JSX creates native DOM and SVG nodes. Component state updates only the dynamic regions that depend on it. Static production CSS is extracted from scoped style blocks rather than recreated as JavaScript objects at runtime.</p>
                <h2>Native interaction, composed</h2>
                <p>The private UI dogfood layer builds disclosure, dialog, status, and field primitives from native elements. Web 0.8 adds checked DOM IDs so accessible relationships do not depend on handwritten global names or cryptographic UUIDs.</p>
                <InteractionPlayground />
                <h2>Routing and document metadata</h2>
                <p>Router, Link, NavLink, Head, and navigation functions understand the application's configured base path. Route parameters, queries, and hashes arrive through a checked RouteContext.</p>
                <pre><code>{routerCode}</code></pre>
                <h2>Capability modules</h2>
                <ul><li><strong>velar/forms</strong> owns typed form reads, errors, focus, reset, and pending state.</li><li><strong>velar/http</strong> owns lazy requests, timeouts, cancellation, size bounds, strict JSON, and typed parsing.</li><li><strong>velar/storage</strong> owns local, session, and IndexedDB persistence through JSON-safe typed values.</li><li><strong>velar/browser</strong> owns environment snapshots, clipboard, dialogs, layout, timers, media, online, and visibility.</li><li><strong>velar/files</strong> and <strong>velar/realtime</strong> provide explicit file and connection lifetimes.</li><li><strong>velar/app</strong> unifies framework error reporting and recoverable rendering behavior.</li></ul>
                <pre><code>{dataCode}</code></pre>
                <Callout title="No ambient browser globals"><p>Direct window, document, fetch, location, history, JSON, Math, and Date access is rejected in ordinary Velar source. Use JSX, Core modules, Web capability modules, or an explicit JavaScript adapter.</p></Callout>
                <h2>Testing the delivered application</h2>
                <p>Core tests run quickly without a browser. Browser tests execute an isolated CSP production build through the typed browser controller, so the same routing, assets, chunks, and runtime behavior users receive are exercised.</p>
                <pre><code>{testCode}</code></pre>
                <h2>Production contract</h2>
                <p>velar build emits content-hashed assets and a deployment contract. velar verify checks the output locally. Hosts must provide the emitted single-page application fallback, base path, content types, and security behavior.</p>
            </Prose>
        </DocsShell>
    </main>
