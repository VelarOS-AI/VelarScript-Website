import {Head} from "velar/web"
import {ActionLink, CodeWindow, Container, Eyebrow, Section, SectionHeading, Surface} from "@velarscript/site-ui"
import {features, learningSteps} from "../content.vel"
import {FeatureGrid} from "../components/feature-grid.vel"
import {LearningPath} from "../components/learning-path.vel"

const heroCode = "type Project:\n    name: string\n    stars: int\n\ncomponent ProjectCard(project: Project):\n    state starred = false\n\n    style:\n        article {\n            display: grid;\n            gap: 12px;\n        }\n\n    return <article>\n        <h2>{project.name}</h2>\n        <p>{project.stars} stars</p>\n        <button on:click={() => starred = not starred}>\n            {starred ? \"Starred\" : \"Star\"}\n        </button>\n    </article>"

export component Home:
    style:
        .hero {
            min-height: calc(100vh - 66px);
            padding: clamp(70px, 10vw, 128px) 0 64px;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.72fr);
            align-items: center;
            gap: clamp(50px, 8vw, 120px);
        }

        h1, .lead, .proof {
            margin: 0;
        }

        h1 {
            max-width: 900px;
            margin-top: 18px;
            font-size: clamp(4rem, 10vw, 9.5rem);
            line-height: 0.85;
            letter-spacing: -0.075em;
        }

        h1 span {
            display: block;
            color: var(--velar-sea);
            font-weight: 520;
        }

        .lead {
            max-width: 690px;
            margin-top: 34px;
            color: var(--velar-ink-soft);
            font-size: clamp(1.12rem, 2.2vw, 1.42rem);
            line-height: 1.62;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 32px;
        }

        .proof {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 20px;
            margin-top: 27px;
            color: var(--velar-ink-faint);
            font-size: 0.78rem;
            font-weight: 650;
        }

        .proof span::before {
            content: "—";
            margin-right: 8px;
            color: var(--velar-sea);
        }

        .code-column {
            transform: rotate(1.4deg);
        }

        .manifesto {
            display: grid;
            grid-template-columns: minmax(0, 0.9fr) minmax(280px, 0.48fr);
            gap: clamp(40px, 8vw, 120px);
            align-items: end;
        }

        .manifesto h2, .manifesto p {
            margin: 0;
        }

        .manifesto h2 {
            font-size: clamp(3rem, 7.5vw, 7.4rem);
            line-height: 0.92;
            letter-spacing: -0.065em;
        }

        .manifesto p {
            color: var(--velar-ink-soft);
            font-size: 1.08rem;
            line-height: 1.75;
        }

        .layers {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            margin-top: 70px;
        }

        .layer {
            display: grid;
            gap: 28px;
            min-height: 250px;
            padding: 28px;
            border-right: 1px solid rgba(255, 255, 255, 0.16);
        }

        .layer:last-child {
            border-right: 0;
        }

        .layer span {
            color: rgba(255, 255, 255, 0.55);
            font: 0.74rem "SFMono-Regular", Consolas, monospace;
        }

        .layer strong {
            align-self: end;
            font-size: clamp(1.5rem, 3vw, 2.7rem);
            letter-spacing: -0.045em;
        }

        .closing {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: end;
            gap: 40px;
            padding: clamp(52px, 8vw, 86px);
        }

        .closing h2, .closing p {
            margin: 0;
        }

        .closing h2 {
            max-width: 760px;
            font-size: clamp(2.7rem, 7vw, 6.8rem);
            line-height: 0.94;
            letter-spacing: -0.065em;
        }

        .closing p {
            max-width: 570px;
            margin-top: 20px;
            color: rgba(255, 255, 255, 0.65);
            line-height: 1.7;
        }

        @media (max-width: 980px) {
            .hero-grid, .manifesto {
                grid-template-columns: 1fr;
            }

            .hero {
                min-height: auto;
            }

            .code-column {
                width: min(680px, 100%);
                transform: none;
            }
        }

        @media (max-width: 720px) {
            .layers, .closing {
                grid-template-columns: 1fr;
            }

            .layer {
                min-height: 190px;
                border-right: 0;
                border-bottom: 1px solid rgba(255, 255, 255, 0.16);
            }

            .layer:last-child {
                border-bottom: 0;
            }
        }

    return <main>
        <Head title="Velar — The Web, written clearly" description="A clear, compact language and integrated framework for modern web applications." themeColor="#f7f5f0" />
        <section class="hero" data-home-hero>
            <Container>
                <div class="hero-grid">
                    <div>
                        <Eyebrow label="Language + Web framework" />
                        <h1>The Web,<span>written clearly.</span></h1>
                        <p class="lead">Velar combines Python's readability with JavaScript's flexible runtime model, then makes components, styles, data, and browser capabilities feel like one language.</p>
                        <div class="actions"><ActionLink to="/learn" label="Start learning" /><ActionLink to="/docs" label="Read the docs" quiet={true} /></div>
                        <p class="proof"><span>Compiles to JavaScript</span><span>Native JSX and CSS</span><span>Apache-2.0</span></p>
                    </div>
                    <div class="code-column"><CodeWindow code={heroCode} label="project-card.vel" /></div>
                </div>
            </Container>
        </section>

        <Section ruled={true}>
            <Container>
                <div class="manifesto"><h2>Less language between you and the idea.</h2><p>Velar does not invent a new virtual machine or disguise how the browser works. Values, references, closures, promises, and the prototype-based JavaScript runtime remain underneath. The source language simply gives you a cleaner place to think.</p></div>
            </Container>
        </Section>

        <Section ruled={true}>
            <Container>
                <SectionHeading kicker="Design principles" title="Small enough to learn. Complete enough to ship." summary="Every feature must make ordinary web application code easier to read, safer at a real boundary, or simpler to operate." />
                <FeatureGrid features={features} />
            </Container>
        </Section>

        <Section ruled={true}>
            <Container>
                <SectionHeading kicker="One coherent stack" title="Language and framework, designed together." summary="The compiler owns the language. @velarscript/web owns browser application capabilities. The browser still runs ordinary JavaScript." />
                <Surface dark={true}><div class="layers"><div class="layer"><span>01 / SOURCE</span><strong>Velar language</strong></div><div class="layer"><span>02 / FRAMEWORK</span><strong>@velarscript/web</strong></div><div class="layer"><span>03 / RUNTIME</span><strong>Browser JavaScript</strong></div></div></Surface>
            </Container>
        </Section>

        <Section ruled={true}>
            <Container>
                <SectionHeading kicker="Learning path" title="From first line to production." summary="Start with readable language fundamentals, then add Web capabilities only when your application needs them." />
                <LearningPath steps={learningSteps} />
            </Container>
        </Section>

        <Section ruled={true}>
            <Container><Surface dark={true}><div class="closing"><div><h2>Write the app, not the ceremony.</h2><p>The current line is a development release. The language, compiler, Web framework, CLI, and this site advance as one tested system.</p></div><ActionLink to="/learn" label="Meet Velar" inverse={true} /></div></Surface></Container>
        </Section>
    </main>
