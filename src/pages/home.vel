import {Head, Link} from "velar/web"
import {border, clamp, minmax, repeat, rgba, spacing, tracks} from "velar/look"
import {CodeBlock} from "@velarscript/docs-kit"
import {ActionLink, CodeWindow, Container, Eyebrow, Section, Surface, foundationInk as ink, foundationInkFaint as inkFaint, foundationInkSoft as inkSoft, foundationPaperPure as paperPure, foundationRule as rule, foundationSea as sea, useLocale} from "@velarscript/site-ui"
import {headTitle} from "../content.vel"

const taskAppCode = `import {border, color, rgb, spacing} from "velar/look"\n\ntype Task:\n    id: string\n    title: string\n    done: bool\n\nconst cardLook = look:\n    display = "grid"\n    gap = 8px\n    padding = spacing(14px, 16px)\n    border = border(1px, color("silver"))\n    borderRadius = 10px\n\ndef titleLook(done: bool) -> Look:\n    return look:\n        margin = 0\n        fontSize = 1.05rem\n\n        if done:\n            color = rgb(94, 96, 102)\n            textDecoration = "line-through"\n\ncomponent TaskCard(task: Task):\n    state done = task.done\n\n    def toggle():\n        done = not done\n\n    return <article look={cardLook}>\n        <h2 look={titleLook(done)}>{task.title}</h2>\n        <button type="button" on:click={toggle}>{done ? "Reopen" : "Complete"}</button>\n    </article>\n\nconst first: Task = {id: "read", title: "Read the guide", done: false}\n\nmount(<TaskCard task={first} />, "#app")`

const presenceErrorCode = `type Account:\n    id: string\n    name: string\n\nexport def label(account: Account?) -> string:\n    if account:\n        return account.name\n    return "no account"`

const presenceErrorOutput = "main.vel:6:8 error VEL4001: A condition judges truth, not presence; write 'account != null' to test Account? for a value\n    if account:\n       ^^^^^^^"

const createShellCode = "npm create velar@latest my-app -- --template web\ncd my-app\nnpm install"

const developShellCode = "npm run dev\nnpx velar check"

const shipShellCode = "npm test\nnpm run build\nnpx velar verify"

const openingLook = look:
    paddingTop = clamp(64px, 8vw, 108px)
    paddingBottom = clamp(56px, 7vw, 88px)

const openingTitleLook = look:
    margin = 0
    marginTop = 14px
    fontSize = clamp(2.6rem, 6vw, 4.6rem)
    lineHeight = 1.02
    letterSpacing = -0.045em

const definitionLook = look:
    maxWidth = 760px
    margin = 0
    marginTop = 26px
    color = inkSoft
    fontSize = clamp(1.06rem, 1.9vw, 1.28rem)
    lineHeight = 1.65

const missionLook = look:
    maxWidth = 760px
    margin = 0
    marginTop = 16px
    color = inkSoft
    lineHeight = 1.7

const actionsLook = look:
    display = "flex"
    flexWrap = "wrap"
    gap = 10px
    marginTop = 30px

const sampleGridLook = look:
    display = "grid"
    gridTemplateColumns = tracks(minmax(0px, 1fr), minmax(0px, 0.62fr))
    alignItems = "start"
    gap = clamp(28px, 4vw, 56px)

    if viewport.width <= 900px:
        gridTemplateColumns = tracks(1fr)

const readingLook = look:
    display = "grid"
    gap = 14px
    margin = 0
    marginTop = 18px
    padding = 0
    listStyle = "none"
    color = inkSoft
    lineHeight = 1.65

const readingTermLook = look:
    color = ink
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.82rem

const cardsLook = look:
    display = "grid"
    gridTemplateColumns = repeat(3, minmax(0px, 1fr))
    gap = 1px
    marginTop = 40px
    border = border(1px, rule)
    borderRadius = 14px
    background = rule

    if viewport.width <= 900px:
        gridTemplateColumns = repeat(2, minmax(0px, 1fr))

    if viewport.width <= 620px:
        gridTemplateColumns = tracks(1fr)

const cardLook = look:
    display = "grid"
    alignContent = "start"
    gap = 10px
    padding = clamp(20px, 2.4vw, 28px)
    background = paperPure

const cardTitleLook = look:
    margin = 0
    fontSize = 1.06rem
    letterSpacing = -0.015em

const cardTextLook = look:
    margin = 0
    color = inkSoft
    fontSize = 0.96rem
    lineHeight = 1.65

const cardLinkLook = look:
    color = sea
    fontSize = 0.88rem
    fontWeight = 650

const diagnosticLook = look:
    display = "grid"
    gridTemplateColumns = tracks(minmax(0px, 1fr), minmax(0px, 1fr))
    gap = 16px
    marginTop = 34px

    if viewport.width <= 780px:
        gridTemplateColumns = tracks(1fr)

const diagnosticLabelLook = look:
    margin = 0
    marginBottom = 10px
    color = inkFaint
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.7rem
    fontWeight = 700
    letterSpacing = 0.1em
    textTransform = "uppercase"

const stepsLook = look:
    display = "grid"
    gridTemplateColumns = repeat(3, minmax(0px, 1fr))
    gap = 22px
    marginTop = 34px

    if viewport.width <= 860px:
        gridTemplateColumns = tracks(1fr)

const stepTitleLook = look:
    margin = 0
    marginBottom = 10px
    fontSize = 1rem

const boundaryInnerLook = look:
    display = "grid"
    gap = 18px
    padding = clamp(28px, 4vw, 52px)

const boundaryTitleLook = look:
    margin = 0
    fontSize = clamp(1.5rem, 3vw, 2.1rem)
    letterSpacing = -0.03em

const boundaryListLook = look:
    display = "grid"
    gap = 10px
    margin = 0
    paddingLeft = 20px
    color = rgba(255, 255, 255, 0.74)
    lineHeight = 1.7

const boundaryLinkLook = look:
    color = paperPure

const footLinksLook = look:
    display = "flex"
    flexWrap = "wrap"
    gap = spacing(10px, 26px)
    paddingBlock = 40px
    borderTop = border(1px, rule)

const footLinkLook = look:
    color = ink
    fontWeight = 650
    textDecoration = "none"

const sectionTitleLook = look:
    margin = 0
    fontSize = clamp(1.6rem, 3.2vw, 2.3rem)
    letterSpacing = -0.03em

const sectionLeadLook = look:
    maxWidth = 720px
    margin = 0
    marginTop = 12px
    color = inkSoft
    lineHeight = 1.7

export component Home:
    const locale = useLocale()
    return <main>
        <Head
            title={headTitle("/", locale.isChinese())}
            description={locale.text("VelarScript is an application language that compiles to JavaScript: a Python-shaped writing surface over JavaScript's runtime semantics, with the Web as an official extension.", "VelarScript 是一门编译到 JavaScript 的应用语言：以 Python 的书写表面承载 JavaScript 的运行时语义，Web 是它的官方扩展。")}
            themeColor="#f7f5f0"
        />

        <section class="opening" look={openingLook} data-home-definition>
            <Container>
                <Eyebrow label={locale.text("Language and official Web extension", "语言与官方 Web 扩展")} />
                <h1 look={openingTitleLook}>VelarScript</h1>
                <p class="definition" look={definitionLook}>
                    {locale.text("An application language that compiles to JavaScript: Python's writing surface over JavaScript's runtime semantics. The language core stands on its own, and the Web is an official extension a project activates.", "一门编译到 JavaScript 的应用语言：以 Python 的书写表面，承载 JavaScript 的运行时语义。语言核心独立成立，Web 是项目按需激活的官方扩展。")}
                </p>
                <p look={missionLook}>
                    {locale.text("It is designed for code that a model writes and a person owns: the reader has to be able to check what the code does, and the compiler has to say so when it cannot.", "它为「模型书写、人来拥有」的代码而设计：读者必须能够核验代码在做什么，而当编译器无法确认时，它必须说出来。")}
                </p>
                <div class="actions" look={actionsLook}>
                    <ActionLink to="/guide/quick-start" label={locale.text("Quick start", "快速开始")} />
                    <ActionLink to="/guide" label={locale.text("Read the guide", "阅读指南")} quiet={true} />
                </div>
            </Container>
        </section>

        <Section ruled={true}>
            <Container>
                <div class="sample" look={sampleGridLook} data-home-sample>
                    <CodeWindow code={taskAppCode} label="main.vel" />
                    <div>
                        <h2 look={sectionTitleLook}>{locale.text("One file, two vocabularies", "一个文件，两套词汇")}</h2>
                        <ul look={readingLook}>
                            <li>
                                <span look={readingTermLook}>type · def · const</span>
                                <br />
                                {locale.text("type, def, const, and the control flow are the language. They exist in every VelarScript project, including one that never touches a browser.", "type、def、const 与控制流属于语言本身。它们存在于每个 VelarScript 项目中，包括从不接触浏览器的项目。")}
                            </li>
                            <li>
                                <span look={readingTermLook}>component · state · look · JSX · mount</span>
                                <br />
                                {locale.text("component, state, look, JSX, and mount come from the Web extension. Without @velarscript/web in velar.json, none of those words exist.", "component、state、look、JSX 与 mount 来自 Web 扩展。如果 velar.json 中没有 @velarscript/web，这些词一个都不存在。")}
                            </li>
                            <li>
                                <span look={readingTermLook}>velar check</span>
                                <br />
                                {locale.text("This block is compiled by the site's own gate as a complete project before the page can be published.", "这段代码在页面发布之前，会由本站门禁作为一个完整项目编译。")}
                            </li>
                        </ul>
                    </div>
                </div>
            </Container>
        </Section>

        <Section ruled={true}>
            <Container>
                <h2 look={sectionTitleLook}>{locale.text("What the language is like", "这门语言的性质")}</h2>
                <p look={sectionLeadLook}>
                    {locale.text("Six properties that decide how ordinary application code reads. Each one links to the chapter that shows it working.", "六项决定日常应用代码读起来如何的性质。每一项都链接到展示它如何运作的章节。")}
                </p>
                <div class="cards" look={cardsLook}>
                    <article look={cardLook}>
                        <h3 look={cardTitleLook}>{locale.text("One idea, one spelling", "一个想法，一种拼写")}</h3>
                        <p look={cardTextLook}>
                            {locale.text("Where two spellings would mean the same thing, only one exists. There is one canonical layout, one equality, and one place cleanup is written.", "当两种拼写会表达同一件事时，只保留一种。只有一种规范排版、一种相等、一处书写清理逻辑的位置。")}
                        </p>
                        <Link to="/guide/language/operators" look={cardLinkLook}>
                            {locale.text("Operators", "运算符")}
                        </Link>
                    </article>
                    <article look={cardLook}>
                        <h3 look={cardTitleLook}>{locale.text("A type is also a runtime validator", "类型同时是运行时验证器")}</h3>
                        <p look={cardTextLook}>
                            {locale.text("The declaration that checks the source also validates data arriving from JSON, HTTP, storage, and forms. There is no second schema to keep in step.", "检查源码的那份声明，同时验证来自 JSON、HTTP、存储与表单的数据。不存在需要同步维护的第二套 schema。")}
                        </p>
                        <Link to="/guide/language/records" look={cardLinkLook}>
                            {locale.text("Records and enums", "记录与枚举")}
                        </Link>
                    </article>
                    <article look={cardLook}>
                        <h3 look={cardTitleLook}>
                            {locale.text("Diagnostics name the accepted spelling", "诊断说出被接受的拼写")}
                        </h3>
                        <p look={cardTextLook}>
                            {locale.text("A diagnostic states what to write, not only what was rejected. Where a rewrite is provably equivalent, velar fix applies it unattended.", "诊断说明应该写什么，而不只是指出被拒绝的写法。当改写可证明等价时，velar fix 会无人值守地应用它。")}
                        </p>
                        <Link to="/guide/quick-start" look={cardLinkLook}>{locale.text("Quick start", "快速开始")}</Link>
                    </article>
                    <article look={cardLook}>
                        <h3 look={cardTitleLook}>
                            {locale.text("No implicit coercion, no truthiness", "没有隐式转换，没有 truthiness")}
                        </h3>
                        <p look={cardTextLook}>
                            {locale.text("A condition accepts bool and bool? only. Presence is written != null and emptiness is written .size == 0, so the three questions stay three.", "条件只接受 bool 与 bool?。存在性写作 != null，空写作 .size == 0，三个问题始终是三个。")}
                        </p>
                        <Link to="/guide/language/control-flow" look={cardLinkLook}>
                            {locale.text("Control flow", "控制流")}
                        </Link>
                    </article>
                    <article look={cardLook}>
                        <h3 look={cardTitleLook}>{locale.text("Look is checked and extracted", "Look 受检并被提取")}</h3>
                        <p look={cardTextLook}>
                            {locale.text("A look block is a checked literal with closed property families and value kinds. The compiler extracts it at build time rather than assembling styles while the page runs.", "look 块是受检字面量，属性家族与取值种类都是封闭集合。编译器在构建期提取它，而不是在页面运行时拼装样式。")}
                        </p>
                        <Link to="/guide/web/look" look={cardLinkLook}>Look</Link>
                    </article>
                    <article look={cardLook}>
                        <h3 look={cardTitleLook}>
                            {locale.text("The output is readable JavaScript", "产物是可读的 JavaScript")}
                        </h3>
                        <p look={cardTextLook}>
                            {locale.text("The build emits ordinary JavaScript modules. Reading the output, or leaving with it, is a normal operation rather than a rescue procedure.", "构建产出普通的 JavaScript 模块。阅读产物，或者带着产物离开，都是普通操作，而不是抢救流程。")}
                        </p>
                        <Link to="/reference/escape-hatches" look={cardLinkLook}>
                            {locale.text("Escape hatches", "逃生通道")}
                        </Link>
                    </article>
                </div>
                <div class="diagnostic" look={diagnosticLook}>
                    <div>
                        <p look={diagnosticLabelLook}>{locale.text("Rejected", "被拒绝的写法")}</p>
                        <CodeBlock code={presenceErrorCode} />
                    </div>
                    <div>
                        <p look={diagnosticLabelLook}>{locale.text("What velar check answers", "velar check 的回答")}</p>
                        <CodeBlock code={presenceErrorOutput} />
                    </div>
                </div>
            </Container>
        </Section>

        <Section ruled={true}>
            <Container>
                <h2 look={sectionTitleLook}>{locale.text("How you use it", "怎么用")}</h2>
                <p look={sectionLeadLook}>
                    {locale.text("One toolchain covers the loop: create a project, run and check it, then test and build it.", "同一套工具链覆盖整个循环：创建项目、运行并检查、测试并构建。")}
                </p>
                <div class="steps" look={stepsLook}>
                    <div>
                        <h3 look={stepTitleLook}>{locale.text("Create", "创建")}</h3>
                        <CodeBlock code={createShellCode} />
                    </div>
                    <div>
                        <h3 look={stepTitleLook}>{locale.text("Run and check", "运行与检查")}</h3>
                        <CodeBlock code={developShellCode} />
                    </div>
                    <div>
                        <h3 look={stepTitleLook}>{locale.text("Test and build", "测试与构建")}</h3>
                        <CodeBlock code={shipShellCode} />
                    </div>
                </div>
            </Container>
        </Section>

        <Section ruled={true}>
            <Container>
                <Surface dark={true}>
                    <div class="boundaries" look={boundaryInnerLook}>
                        <h2 look={boundaryTitleLook}>{locale.text("Status and boundaries", "状态与边界")}</h2>
                        <ul look={boundaryListLook}>
                            <li>
                                {locale.text("This is a development release. The language, compiler, extensions, CLI, and this site advance as one tested system.", "当前是开发期发布。语言、编译器、扩展、CLI 与本站作为同一个经过测试的系统共同演进。")}
                            </li>
                            <li>
                                {locale.text("There is no backward-compatibility promise yet. A spelling can change when a better one is decided.", "目前没有向后兼容承诺。当更好的拼写被裁定时，现有拼写可以改变。")}
                            </li>
                            <li>
                                {locale.text("Pin the toolchain in your project. A pinned version is what makes a build reproducible across machines.", "请在项目中固定工具链版本。固定版本正是让构建在不同机器上可复现的前提。")}
                            </li>
                            <li>{locale.text("Every escape hatch is documented, including the final one: leaving with the compiled JavaScript.", "每一条逃生通道都有文档，包括最终那一条：带着编译产出的 JavaScript 离开。")} <Link to="/reference/escape-hatches" look={boundaryLinkLook}>{locale.text("Escape hatches", "逃生通道")}</Link></li>
                        </ul>
                    </div>
                </Surface>
            </Container>
        </Section>

        <Container>
            <div class="foot-links" look={footLinksLook}>
                <Link to="/guide" look={footLinkLook}>{locale.text("Guide", "指南")}</Link>
                <Link to="/reference" look={footLinkLook}>{locale.text("Reference", "参考")}</Link>
                <Link to="/examples" look={footLinkLook}>{locale.text("Examples", "示例")}</Link>
                <a href="https://github.com/VelarOS-AI/VelarScript" look={footLinkLook}>GitHub</a>
            </div>
        </Container>
    </main>
