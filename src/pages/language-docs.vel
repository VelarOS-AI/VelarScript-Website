import {Head, Link} from "velar/web"
import {Callout, DocsShell, PageHeader, Prose} from "@velarscript/docs-kit"
import {docsNav} from "../content.vel"

const bindingsCode = "const product = \"VelarScript\"\nlet downloads = 0\n\ndownloads += 1\n\nconst {name, version} = release\nconst [first, ...rest] = builds"
const valuesCode = "const title: string = \"Release\"\nconst progress: number = 0.75\nconst ready: bool = true\nconst failure: Error? = none\n\nconst label = ready ? \"Ready\" : \"Waiting\"\nconst message = f\"{title}: {progress * 100}%\""
const optionalCode = "const avatar = user?.profile.avatar ?? \"/default.png\"\n\nif user != none:\n    print(user.name)\nelse:\n    print(\"Guest\")\n\nassert draft.estimate, \"Estimate is required\"\nsave(draft.estimate)"
const expressionCode = "const inside = 0 <= index < items.length\nconst present = value in values\nconst squared = value ** 2\nconst visible = enabled and not hidden\n\n// Explicit conversion; no ambient coercion.\nconst text = str(42)\nconst parsed = number(\"42.5\")"
const objectCode = "const name = \"Ada\"\nconst active = true\nconst user = {name, active, role: \"admin\"}\nconst updated = {...user, active: false}"

export component LanguageDocs:
    return <main data-language-docs>
        <Head title="Syntax and values · VelarScript" description="VelarScript bindings, primitive values, references, optionals, expressions, objects, and strict conditions." themeColor="#f7f5f0" />
        <DocsShell items={docsNav}>
            <PageHeader kicker="Language / 01" title="Readable source, JavaScript runtime facts." summary="VelarScript keeps JavaScript values, references, closures, promises, garbage collection, and Number semantics while removing its accidental source-level traps." tags={["const + let", "indentation", "none", "strict conditions"]} />
            <Prose>
                <h2 id="runtime">Runtime model</h2>
                <p>Compiled programs run on the existing JavaScript engine. Objects and collections are references, primitive values behave as JavaScript primitives, numbers use IEEE 754, closures capture bindings, and asynchronous work uses the native event loop and Promise queue. VelarScript adds no VM, garbage collector, virtual DOM, or second memory model.</p>
                <p>The source language deliberately omits <code>var</code>, <code>undefined</code>, dynamic <code>this</code>, <code>new</code>, prototype mutation, <code>eval</code>, <code>with</code>, <code>arguments</code>, implicit globals, ambient coercion functions, and automatic semicolon insertion.</p>

                <h2 id="bindings">Bindings</h2>
                <pre><code>{bindingsCode}</code></pre>
                <ul>
                    <li>Use <code>const</code> unless the binding itself must be reassigned; use <code>let</code> for intentional reassignment.</li>
                    <li>Both forms are block scoped and must be initialized.</li>
                    <li><code>const</code> prevents rebinding but does not freeze a referenced object, List, Map, or Set.</li>
                    <li>Assignment is a statement, never a value-producing expression.</li>
                    <li>Declarations and <code>for</code> bindings support object/List destructuring. Spreads use <code>...</code>.</li>
                </ul>

                <h2 id="values">Primitive values and strings</h2>
                <pre><code>{valuesCode}</code></pre>
                <p>The four Core primitive types are <code>string</code>, <code>number</code>, <code>bool</code>, and <code>none</code>. Interpolated strings use <code>f"..."</code>. Short expression choices use JavaScript's readable <code>condition ? yes : no</code> ordering; Python's reversed inline conditional is not part of the language.</p>
                <Callout title="Number means JavaScript Number"><p>VelarScript does not claim Python arbitrary-precision integers or decimal arithmetic. APIs that require integers check the safe-integer range explicitly.</p></Callout>

                <h2 id="empty">One empty value</h2>
                <pre><code>{optionalCode}</code></pre>
                <p>Source uses <code>none</code> instead of <code>null</code> or <code>undefined</code>. A type ending in <code>?</code> may contain <code>none</code>. One <code>?.</code> begins a continuous optional chain across later field reads, checked indexes, calls, and compiler-owned collection operations; skipped arguments are not evaluated.</p>
                <p><code>if</code>, <code>while</code>, <code>not</code>, explicit comparisons with <code>none</code>, <code>is</code>, and successful <code>assert</code> narrow stable local names and dotted record fields. The proof stays in its lexical branch and never crosses a shadowed binding or deferred callback.</p>

                <h2 id="conditions">Strict conditions and operators</h2>
                <pre><code>{expressionCode}</code></pre>
                <ul>
                    <li>Conditions accept only <code>bool</code> or an optional value, where the test means “present.” Numbers, strings, and collections have no implicit truthiness.</li>
                    <li><code>==</code> and <code>!=</code> are already strict. Primitive values compare by value; objects, Lists, functions, and class instances compare by reference.</li>
                    <li><code>and</code>, <code>or</code>, and <code>not</code> return booleans rather than arbitrary operands.</li>
                    <li>Comparison chains evaluate each operand once from left to right and stop at the first false link.</li>
                    <li><code>in</code> tests List/string containment or Set/Map membership; it never inspects an object prototype chain.</li>
                    <li><code>%</code> keeps JavaScript remainder semantics. <code>**</code> is right-associative and handles signed exponents predictably.</li>
                </ul>

                <h2 id="conversion">Explicit conversion</h2>
                <p><code>str(value)</code> produces display text. <code>number(text) -&gt; number?</code> accepts one complete finite decimal and returns <code>none</code> for empty, partial, hexadecimal, NaN, or infinite input. <code>print(value)</code> is the small Core output function. These compiler-owned bindings cannot be shadowed.</p>

                <h2 id="objects">Objects and immutable updates</h2>
                <pre><code>{objectCode}</code></pre>
                <p>Object literals have a fixed known shape. An identifier may stand for a same-named field, explicit duplicate fields are rejected, and ordered spread followed by an explicit field is the normal immutable-update spelling. Use a <code>Map</code> when keys are dynamic.</p>

                <div class="next-links"><Link to="/docs/language/types"><strong>Next: Types and data</strong><span>Record shapes, aliases, unions, enums, and runtime validation.</span></Link><Link to="/docs/language/functions"><strong>Functions and flow</strong><span>Named work, callbacks, async code, matching, and errors.</span></Link></div>
            </Prose>
        </DocsShell>
    </main>
