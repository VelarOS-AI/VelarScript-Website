import {Head, Link} from "velar/web"
import {CodeBlock, Callout, DocsShell, PageHeader, Prose} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {docsNav} from "../content.vel"

const listCode = "const users: List<User> = [ada, grace]\nusers.append(linus)\nusers.extend(moreUsers)\n\nconst first = users.get(0)\nconst page = users.slice(10, 20)\nconst names = users.map(user => user.name)\nconst active = users.filter(user => user.active)"
const mapCode = "const users: Map<string, User> = Map()\nusers.set(ada.id, ada)\n\nconst user = users.get(\"ada\")\nconst ids = users.keys()\nconst entries = users.entries()\n\nfor id in users:\n    print(id)"
const setCode = "const tags: Set<string> = Set([\"web\", \"language\", \"web\"])\ntags.add(\"compiler\")\n\nif tags.has(\"web\"):\n    print(tags.size)\n\nconst values = tags.values()"
const helpersCode = "import {enumerate, groupBy, range, sortBy, sum, zip} from \"velar/collections\"\n\nconst pages = range(1, 5)\nconst numbered = enumerate(users, 1)\nconst byRole = groupBy(users, user => user.role)\nconst ordered = sortBy(users, user => user.name)\nconst total = sum(scores)\nconst pairs = zip(labels, values)"

export component LanguageCollections:
    const locale = useLocale()
    return <main>
        <Head title={locale.text("Collections · VelarScript", "集合 · VelarScript")} description={locale.text("VelarScript List, Map, Set, iteration, mutation, slices, functional transforms, and collection helpers.", "VelarScript 的 List、Map、Set、迭代、修改、切片、函数式变换与集合辅助函数。")} themeColor="#f7f5f0" />
        <DocsShell items={docsNav}>
            <PageHeader kicker={locale.text("Language / 04", "语言 / 04")} title={locale.text("Three native collections, one clear vocabulary.", "三种原生集合，一套清晰词汇。")} summary={locale.text("Lists preserve order, Maps own dynamic keys, and Sets own unique membership. All retain JavaScript reference identity and predictable bounded behavior.", "List 保持顺序，Map 管理动态键，Set 管理唯一成员；三者都保留 JavaScript 引用身份与可预测的有界行为。")} tags={["List<T>", "Map<K, V>", "Set<T>", "dense data"]} />
            <Prose>
                <h2 id="list">List</h2>
                <CodeBlock code={listCode} />
                <ul>
                    <li><code>list[index]</code>{locale.text(" throws ", " 在超出有效范围时抛出 ")}<code>IndexError</code>{locale.text(" outside the valid range; ", "；")}<code>get(index)</code>{locale.text(" returns an optional value.", " 返回可选值。")}</li>
                    <li><code>append(value)</code>{locale.text(" adds one value and ", " 添加一个值，")}<code>extend(list)</code>{locale.text(" atomically adds a typed List. Both return ", " 原子地添加类型化 List；两者都返回 ")}<code>none</code>{locale.text(".", "。")}</li>
                    <li><code>slice()</code>, <code>slice(start)</code>{locale.text(", and ", " 与 ")}<code>slice(start, end)</code>{locale.text(" return shallow copies. Negative positions count from the end and out-of-range positions clamp.", " 返回浅拷贝。负位置从末尾计数，越界位置会被夹紧。")}</li>
                    <li>{locale.text("An empty unannotated List learns its element type from the first append or extension, then rejects incompatible writes.", "没有标注的空 List 会从首次 append 或 extend 学到元素类型，之后拒绝不兼容写入。")}</li>
                    <li>{locale.text("Standard ", "标准 ")}<code>map</code>, <code>filter</code>{locale.text(", and ", " 与 ")}<code>reduce</code>{locale.text(" callbacks preserve checked element and result types.", " 回调会保留受检查的元素与结果类型。")}</li>
                </ul>
                <Callout title={locale.text("No JavaScript push surface", "不暴露 JavaScript push")}><p>{locale.text("VelarScript uses ", "VelarScript 使用 ")}<code>append</code>{locale.text(" and ", " 与 ")}<code>extend</code>{locale.text(" instead of variadic, length-returning ", "，而不是可变参数、返回长度的 ")}<code>push</code>{locale.text(". Every List is dense and bounded to 1,000,000 items.", "。每个 List 都是稠密的，并限制为最多 1,000,000 项。")}</p></Callout>

                <h2 id="map">Map</h2>
                <CodeBlock code={mapCode} />
                <p>{locale.text("Use a Map for runtime-chosen keys. ", "运行时选择键时使用 Map。")}<code>get</code>{locale.text(" returns ", " 在键缺失时返回 ")}<code>none</code>{locale.text(" when absent. ", "；")}<code>set</code>{locale.text(" and ", " 与 ")}<code>clear</code>{locale.text(" return ", " 返回 ")}<code>none</code>; <code>has</code>{locale.text(" and ", " 与 ")}<code>remove</code>{locale.text(" return booleans. ", " 返回布尔值。")}<code>keys</code>, <code>values</code>{locale.text(", and ", " 与 ")}<code>entries</code>{locale.text(" return ordered List snapshots shaped as ", " 返回有序 List 快照，条目形状为 ")}<code>{"{key, value}"}</code>{locale.text(". Iteration yields keys.", "。迭代 Map 会得到键。")}</p>
                <p><code>Map()</code>{locale.text(" creates an empty map; ", " 创建空映射；")}<code>Map(existing)</code>{locale.text(" creates a typed shallow copy. Put type arguments on the binding, not the constructor.", " 创建类型化浅拷贝。类型参数写在绑定上，而不是构造器上。")}</p>

                <h2 id="set">Set</h2>
                <CodeBlock code={setCode} />
                <p><code>Set()</code>{locale.text(" creates an empty set and ", " 创建空集合，")}<code>Set(list)</code>{locale.text(" constructs from a typed List. Duplicates collapse under native SameValueZero membership and insertion order is preserved. ", " 从类型化 List 构造。重复值按原生 SameValueZero 成员规则合并，并保留插入顺序。")}<code>add</code>{locale.text(" and ", " 与 ")}<code>clear</code>{locale.text(" return ", " 返回 ")}<code>none</code>; <code>has</code>{locale.text(" and ", " 与 ")}<code>remove</code>{locale.text(" return booleans.", " 返回布尔值。")}</p>

                <h2 id="iteration">{locale.text("Iteration and destructuring", "迭代与解构")}</h2>
                <p><code>for value in list</code>{locale.text(" visits List or Set values in order. ", " 按顺序访问 List 或 Set 值。")}<code>for key in map</code>{locale.text(" visits Map keys. Object and List patterns may destructure each value. Collection snapshots are ordinary typed Lists and compose with every List operation.", " 访问 Map 键。对象与 List 模式可以解构每个迭代值。集合快照是普通类型化 List，可以使用所有 List 操作。")}</p>

                <h2 id="helpers">velar/collections</h2>
                <CodeBlock code={helpersCode} />
                <p>{locale.text("The module includes bounded helpers for ranges, enumeration, zipping, uniqueness, chunking, flattening, filtering, ordering, grouping, aggregation, joining, and repetition: ", "该模块提供有界的范围、枚举、配对、去重、分块、展平、过滤、排序、分组、聚合、连接与重复辅助函数：")}<code>range</code>, <code>enumerate</code>, <code>zip</code>, <code>unique</code>, <code>chunk</code>, <code>flatten</code>, <code>compact</code>, <code>sortBy</code>, <code>groupBy</code>, <code>sum</code>, <code>join</code>{locale.text(", and more.", " 等。")}</p>
                <p>{locale.text("Transforms return new collections unless explicitly named otherwise. Predicates return a real bool. Ordering keys are uniformly strings or finite numbers, equal-key order stays stable, and missing lookups use ", "除非名称明确说明，否则变换都会返回新集合。谓词必须返回真实 bool。排序键必须统一为字符串或有限数字，相同键保持稳定顺序，缺失查找使用 ")}<code>none</code>{locale.text(".", "。")}</p>

                <div class="next-links"><Link to="/docs/core"><strong>{locale.text("Core module reference", "Core 模块参考")}</strong><span>{locale.text("See every collections export and the rest of the standard library.", "查看集合的全部导出与标准库其他部分。")}</span></Link><Link to="/docs/language/classes"><strong>{locale.text("Next: Classes", "下一步：类")}</strong><span>{locale.text("Model nominal behavior while keeping collection fields explicit.", "在保持集合字段明确的同时建模名义行为。")}</span></Link></div>
            </Prose>
        </DocsShell>
    </main>
