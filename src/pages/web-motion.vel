import {Head} from "velar/web"
import {Callout, CodeBlock, DocsPager, DocsShell, PageHeader, Prose, SectionList} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {guideNav, guideNext, guidePrevious, headTitle} from "../content.vel"

const keyframesCode = `import {rgb} from "velar/look"\n\n// A stop is from:, to:, or an integer percentage from 1% through 99%.\nexport const spin = keyframes:\n    from:\n        rotate = 0deg\n    50%:\n        rotate = 0.5turn\n    to:\n        rotate = 1turn\n\n// Comma-separated stops share one body, and declaration groups progress in\n// ascending order.\nexport const pulse = keyframes:\n    from, to:\n        opacity = 1\n        scale = 1\n    40%, 60%:\n        opacity = 0.4\n        scale = 1.08\n\n// A keyframes body contains direct, statically lowerable Look properties only:\n// literals, unit values, arithmetic over them, and positional velar/look\n// builder calls. A stop cannot read reactive state — make animation presence\n// dynamic on the element instead.\nexport const slideIn = keyframes:\n    from:\n        translate = -12px\n        color = rgb(120, 150, 255)\n    to:\n        translate = 0px\n        color = rgb(24, 31, 46)`
const keyframesErrorCode = `export const reveal = keyframes:\n    from:\n        display = "none"\n    to:\n        display = "block"`
const keyframesErrorOutput = `main.vel:3:9 error VEL5060: Look property 'display' does not participate in animation interpolation\n        display = "none"\n        ^^^^^^^^^^^^^^^^\n\nmain.vel:5:9 error VEL5060: Look property 'display' does not participate in animation interpolation\n        display = "block"\n        ^^^^^^^^^^^^^^^^^`
const animateCode = `import {animate} from "velar/look"\n\nconst pulse = keyframes:\n    from, to:\n        opacity = 1\n    50%:\n        opacity = 0.4\n\nconst slideIn = keyframes:\n    from:\n        translate = -12px\n    to:\n        translate = 0px\n\n// animate(frames, duration, easing?, delay?, count?, loop?, direction?, fill?)\n// answers an Animation. Duration must be positive, delay cannot be negative,\n// count is a positive integer, and count and loop=true are mutually exclusive —\n// so these two spellings are the whole repetition vocabulary.\nexport const spinForever = animate(pulse, 1s, easing="linear", loop=true)\nexport const spinThrice = animate(pulse, 900ms, easing="ease-in-out", count=3)\n\n// The seven easings.\nconst easings = [\n    animate(pulse, 400ms, easing="linear"),\n    animate(pulse, 400ms, easing="ease"),\n    animate(pulse, 400ms, easing="ease-in"),\n    animate(pulse, 400ms, easing="ease-out"),\n    animate(pulse, 400ms, easing="ease-in-out"),\n    animate(pulse, 400ms, easing="step-start"),\n    animate(pulse, 400ms, easing="step-end"),\n]\n\n// The four directions and the four fills.\nconst directions = [\n    animate(pulse, 400ms, direction="normal"),\n    animate(pulse, 400ms, direction="reverse"),\n    animate(pulse, 400ms, direction="alternate"),\n    animate(pulse, 400ms, direction="alternate-reverse"),\n]\n\nconst fills = [\n    animate(slideIn, 400ms, fill="none"),\n    animate(slideIn, 400ms, fill="forwards"),\n    animate(slideIn, 400ms, fill="backwards"),\n    animate(slideIn, 400ms, fill="both"),\n]\n\n// The positional spelling of the same call, with a delay, alongside the fully\n// named one. Both are ordinary VelarScript calls, so named arguments work\n// normally.\nconst positional = animate(slideIn, 300ms, "ease-out", 60ms)\nconst named = animate(slideIn, 300ms, easing="ease-out", delay=60ms, count=2, direction="alternate", fill="both")\n\nexport const closedSets = f"{easings.size} easings, {directions.size} directions, {fills.size} fills"\n\n// Look animation accepts one Animation, a List<Animation>, or null.\nexport const animatedLook = look:\n    animation = spinForever\n\nexport const layeredLook = look:\n    animation = [positional, named]`
const animationErrorCode = `export const spinnerLook = look:\n    animation = "spin 1s linear infinite"`
const animationErrorOutput = `main.vel:2:5 error VEL5038: Look animation does not accept CSS shorthand text; declare a checked 'keyframes:' value and pass animate(frames, duration, ...) instead\n    animation = "spin 1s linear infinite"\n    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^`
const transitionCode = `import {transition} from "velar/look"\n\n// transition describes a state change rather than a timeline. The builder takes\n// a property name, a duration, and optionally an easing and a delay; the\n// transition property accepts what it returns and rejects a raw CSS string.\nconst fade = transition("opacity", 200ms)\nconst fadeEased = transition("opacity", 200ms, "ease-in-out", 50ms)\n\nexport const transitioningLook = look:\n    opacity = 1\n    transition = fade\n\n    if @hover:\n        opacity = 0.6\n\n// The transition property takes one Transition, and the two duration longhands\n// take Duration values.\nexport const transitionLonghandLook = look:\n    transition = fadeEased\n    transitionDuration = 200ms\n    transitionDelay = 50ms`
const politeCode = `import {animate} from "velar/look"\n\nconst pulse = keyframes:\n    from, to:\n        opacity = 1\n    50%:\n        opacity = 0.4\n\n// A media condition still governs motion, which is the checked way to honour a\n// reduced-motion preference.\nexport const politeLook = look:\n    animation = null\n\n    if not motion.reduced:\n        animation = animate(pulse, 900ms, easing="ease-in-out", count=3)\n\n// Bind a changing animation on the element; null removes the native animation.\nexport component MotionPanel:\n    state active = false\n\n    def toggle():\n        active = not active\n\n    return <div data-motion>\n        <div data-polite look={politeLook}>reduced motion is honoured</div>\n        <div data-toggled look:animation={active ? animate(pulse, 600ms, loop=true) : null}>toggled animation</div>\n        <button type="button" data-toggle-animation on:click={toggle}>{active ? "Stop" : "Start"}</button>\n    </div>`

const sections = [
    {id: "two", label: "Two spellings and no third", labelZh: "两种拼写，没有第三种"},
    {id: "keyframes", label: "The keyframes literal", labelZh: "keyframes 字面量"},
    {id: "animate", label: "animate and its closed sets", labelZh: "animate 与它的封闭集合"},
    {id: "transition", label: "transition is a state change", labelZh: "transition 是状态变化"},
    {id: "reduced", label: "Reduced motion and toggling", labelZh: "降低动效与开关"},
]

const pointsLook = look:
    display = "grid"
    gap = 7px
    marginTop = 18px
    marginBottom = 4px
    paddingLeft = 22px

export component WebMotion:
    const locale = useLocale()
    return <main>
        <Head
            title={headTitle("/guide/web/motion", locale.isChinese())}
            description={locale.text("How a keyframes literal is written, what animate accepts, and when transition is the right spelling.", "keyframes 字面量如何书写、animate 接受什么，以及何时该用 transition。")}
            themeColor="#f7f5f0"
        />
        <DocsShell items={guideNav}>
            <PageHeader
                kicker={locale.text("Web extension / 08", "Web 扩展 / 08")}
                title={locale.text("Motion", "动效")}
                summary={locale.text("Two checked spellings and no third: keyframes with animate for timelines, transition for state changes.", "两种受检拼写，没有第三种：用于时间线的 keyframes 加 animate，用于状态变化的 transition。")}
            />
            <SectionList items={sections} />
            <Prose>
                <h2 id="two">{locale.text("Two spellings and no third", "两种拼写，没有第三种")}</h2>
                <p>
                    {locale.text("Motion has exactly two checked spellings. transition, together with its four longhands, describes a state change — a hover colour, an opening panel, a fading toast. A module-level keyframes value passed to animate describes a timeline. The animation longhands stay outside Look because animate owns the checked contract, and a raw CSS animation string is rejected at the property.", "动效恰好有两种受检拼写。transition 与它的四个 longhand 描述一次状态变化——悬停的颜色、展开的面板、淡出的提示。传给 animate 的模块级 keyframes 值描述一条时间线。animation 的各个 longhand 留在 Look 之外，因为受检契约由 animate 拥有；原始 CSS animation 字符串会在属性处被拒绝。")}
                </p>
                <CodeBlock code={animationErrorCode} />
                <CodeBlock code={animationErrorOutput} />

                <h2 id="keyframes">{locale.text("The keyframes literal", "keyframes 字面量")}</h2>
                <p>
                    {locale.text("A stop is from, to, or an integer percentage from one through ninety-nine. Comma-separated stops share one body, and declaration groups progress in ascending order. A keyframes body contains direct, statically lowerable Look properties only: literals, unit values, arithmetic over them, and positional velar/look builder calls.", "一个停靠点是 from、to，或者从一到九十九的整数百分比。用逗号分隔的停靠点共享一个体，声明组按升序推进。keyframes 体只包含可静态下降的直接 Look 属性：字面量、单位值、对它们的算术，以及位置参数形式的 velar/look 构建器调用。")}
                </p>
                <CodeBlock code={keyframesCode} />
                <p>
                    {locale.text("Non-interpolating properties are rejected here even though a Look accepts them, because a keyframe that cannot interpolate is a declaration the browser would drop.", "即使 Look 接受某些不参与插值的属性，它们在这里仍然会被拒绝，因为无法插值的关键帧只是浏览器会直接丢弃的声明。")}
                </p>
                <CodeBlock code={keyframesErrorCode} />
                <CodeBlock code={keyframesErrorOutput} />
                <ul look={pointsLook}>
                    <li>
                        {locale.text("A stop cannot read reactive state; make the presence of an animation dynamic on the element instead.", "停靠点不能读取响应式状态；应当让动画的有无在元素上动态变化。")}
                    </li>
                    <li>
                        {locale.text("Equal keyframe structures share one generated CSS name and one emitted rule, including across module boundaries.", "结构相同的关键帧共享一个生成的 CSS 名字与一条发出的规则，跨模块边界也是如此。")}
                    </li>
                </ul>

                <h2 id="animate">{locale.text("animate and its closed sets", "animate 与它的封闭集合")}</h2>
                <p>
                    {locale.text("animate takes the frames and a duration, then optional easing, delay, count, loop, direction, and fill. The duration must be positive, the delay cannot be negative, count is a positive integer, and count together with a looping animation is refused — so those two options are the whole repetition vocabulary. The easings, the directions, and the fills are closed sets.", "animate 接受帧与一个时长，然后是可选的 easing、delay、count、loop、direction 与 fill。时长必须为正，延迟不能为负，count 是正整数，且 count 与循环动画不能同时给出——因此这两个选项就是重复的全部词汇。easing、direction 与 fill 都是封闭集合。")}
                </p>
                <CodeBlock code={animateCode} />
                <ul look={pointsLook}>
                    <li>
                        {locale.text("The Look animation property accepts one Animation, a List of them, or null.", "Look 的 animation 属性接受一个 Animation、它们的 List，或 null。")}
                    </li>
                    <li>
                        {locale.text("animate is an ordinary function call, so its arguments may be positional or named exactly as any other call's are.", "animate 是普通的函数调用，因此它的实参可以是位置形式或具名形式，与其他任何调用完全一样。")}
                    </li>
                </ul>

                <h2 id="transition">{locale.text("transition is a state change", "transition 是状态变化")}</h2>
                <p>
                    {locale.text("The transition builder takes a property name, a duration, and optionally an easing and a delay. Written next to a state condition, it says what should ease when that condition turns on, which is a different statement from a timeline that runs on its own.", "transition 构建器接受一个属性名、一个时长，以及可选的 easing 与 delay。写在状态条件旁边时，它说明的是该条件开启时什么应当过渡——这与一条自行播放的时间线是不同的陈述。")}
                </p>
                <CodeBlock code={transitionCode} />

                <h2 id="reduced">{locale.text("Reduced motion and toggling", "降低动效与开关")}</h2>
                <p>
                    {locale.text("A media condition governs motion like any other visual decision, so honouring a reduced-motion preference does not leave Look. Making an animation appear and disappear is the element's job: bind it with look:animation, where null removes the native animation.", "媒体条件像其他视觉决定一样管辖动效，因此尊重降低动效偏好无需离开 Look。让动画出现与消失是元素的工作：用 look:animation 绑定它，其中 null 会移除原生动画。")}
                </p>
                <CodeBlock code={politeCode} />
                <Callout title={locale.text("When a stylesheet must own its own keyframes", "当样式表必须拥有自己的关键帧")}>
                    <p>
                        {locale.text("The CSS at-rule for keyframes is not a Look target. A stylesheet that must own its own keyframe names — one shipped by a design system, or a name-dependent third-party class — crosses the unsafe CSS boundary like any other native CSS, which the next chapter covers.", "CSS 的关键帧 at-rule 不是 Look 的目标。必须拥有自己关键帧名字的样式表——设计系统提供的，或依赖名字的第三方类——像其他原生 CSS 一样跨越 unsafe CSS 边界，这正是下一章的内容。")}
                    </p>
                </Callout>
            </Prose>
            <DocsPager previous={guidePrevious("/guide/web/motion")} next={guideNext("/guide/web/motion")} />
        </DocsShell>
    </main>
