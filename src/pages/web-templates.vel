import {Head, Link} from "velar/web"
import {BulletList, Callout, CodeBlock, DocsPager, DocsShell, GateNote, MemberRow, MemberTable, PageHeader, Paragraph, Prose, SectionHeading, SectionList} from "@velarscript/docs-kit"
import {foundationSea as sea, useLocale} from "@velarscript/site-ui"
import {guideNav, guideNext, guidePrevious, headTitle} from "../content.vel"

// The React blocks are third-party JavaScript, so they are *JsCode and nothing
// here compiles them. Every VelarScript block is compiled by this site's gate,
// and each quoted diagnostic is paired with the sample that produces it.
const handlerCaseJsCode = "// React 19.2 — one letter apart, and only one of them is a handler\n<button onClick={save}>Save</button>\n<button onclick={save}>Save</button>"
const directiveErrorCode = `component Panel:\n    def save():\n        print("saved")\n\n    return <button type="button" onClick={save} class="ok">Save</button>`
const directiveErrorOutput = `main.vel:5:34 error VEL5025: Use 'on:click'; VelarScript event attributes use the on: directive\n    return <button type="button" onClick={save} class="ok">Save</button>\n                                 ^^^^^^^^^^^^^^`
const targetCastTsCode = "// React 19.2 with TypeScript — the cast everybody writes\n<input onChange={(event) => setDraft((event.target as HTMLInputElement).value)} />"
const eventTypesCode = `// The six event value types the Web extension publishes, one handler each.\n// event.target, event.currentTarget, event.value and event.checked are\n// deliberately absent.\ndef onPlainEvent(event: Event):\n    print(f"plain: {event.type}")\n\ndef onKeyEvent(event: KeyboardEvent):\n    print(f"key: {event.key} {event.code} {event.altKey} {event.ctrlKey} {event.metaKey} {event.shiftKey} {event.repeat}")\n\ndef onPointerEvent(event: PointerEvent):\n    print(f"pointer: {event.pointerType} {event.pointerId} {event.button} {event.clientX} {event.clientY}")\n\ndef onInputEvent(event: InputEvent):\n    print(f"input: {event.inputType} {event.data ?? "no data"}")\n\ndef onCompositionEvent(event: CompositionEvent):\n    print(f"composition: {event.data}")\n\ndef onClipboardEvent(event: ClipboardEvent):\n    print(f"clipboard: {event.type}")\n\nexport component EventTypes:\n    return <input\n        data-events\n        type="text"\n        on:focus={onPlainEvent}\n        on:keydown={onKeyEvent}\n        on:pointerdown={onPointerEvent}\n        on:beforeinput={onInputEvent}\n        on:compositionend={onCompositionEvent}\n        on:paste={onClipboardEvent}\n    />`
const eventsCode = `def onPlainEvent(event: Event):\n    print(f"plain: {event.type}")\n\ndef onPointerEvent(event: PointerEvent):\n    print(f"pointer: {event.pointerType} {event.button}")\n\n// There are exactly five modifiers, appended with dots. self, prevent and stop\n// always apply in that order, before the handler runs.\nexport component EventDirectives:\n    state clicks = 0\n\n    def count():\n        clicks += 1\n\n    return <form data-directive-form on:submit.prevent={onPlainEvent}>\n        <button type="button" data-count on:click={count}>Clicked {clicks} times</button>\n        <button type="button" data-prevent on:click.prevent={onPlainEvent}>prevent</button>\n        <button type="button" data-stop on:click.stop={onPointerEvent}>stop</button>\n        <button type="button" data-self on:click.self={onPlainEvent}>self</button>\n        <button type="button" data-capture on:click.capture={onPlainEvent}>capture</button>\n        <button type="button" data-once on:click.once={onPlainEvent}>once</button>\n        <button type="button" data-stacked on:click.prevent.stop={onPointerEvent}>prevent and stop</button>\n    </form>`
const controlledJsCode = "// React 19.2 — three well-known ways this goes wrong\n<input value={draft} />                            // read-only, and React warns\n<input value={undefined} onChange={onDraft} />     // uncontrolled, then controlled: React warns\n<input value={draft} onChange={onDraft} />         // the one that works"
const bindErrorCode = `component Panel:\n    const draft = "fixed"\n    return <input type="text" bind:value={draft} />`
const bindErrorOutput = `main.vel:3:31 error VEL5019: bind:value requires a writable reactive location: a state name, or a field or index path on one such as bind:value={form.name} or bind:value={items[0]}\n    return <input type="text" bind:value={draft} />\n                              ^^^^^^^^^^^^^^^^^^`
const bindCode = `// bind:value on the supported form controls, bind:checked on one checkbox,\n// bind:group on radios (the state holds the selected input's value) and on\n// checkboxes (List<string> membership).\nexport component BindDirectives:\n    state draft = ""\n    state accepted = false\n    state pick = "beta"\n    state picks: List<string> = []\n    state form = {nickname: "ada"}\n    state rows = ["first"]\n\n    const options = ["alpha", "beta", "gamma"]\n\n    return <fieldset data-bind-directives>\n        <input data-draft type="text" name="draft" bind:value={draft} />\n        <textarea data-note bind:value={draft}></textarea>\n        <input data-nickname type="text" bind:value={form.nickname} />\n        <input data-row type="text" bind:value={rows[0]} />\n        <input data-accepted type="checkbox" name="terms" bind:checked={accepted} />\n        <input data-pick-alpha type="radio" name="pick" value="alpha" bind:group={pick} />\n        <input data-pick-beta type="radio" name="pick" value="beta" bind:group={pick} />\n        <input data-picks-alpha type="checkbox" name="picks" value="alpha" bind:group={picks} />\n        <input data-picks-beta type="checkbox" name="picks" value="beta" bind:group={picks} />\n        <select data-select name="option" bind:value={pick}>\n            {options.map(option => <option key={option} value={option}>{option}</option>)}\n        </select>\n        <output data-bound>{f"{draft}|{accepted}|{pick}|{picks.size}|{form.nickname}|{rows[0]}"}</output>\n    </fieldset>`
const classJoinJsCode = `// The template literal everyone tries first\n<p className={\`row ${isActive && "active"}\`} />\n// When isActive is false the class attribute reads: "row false"`
const classesCode = `export enum Tone:\n    quiet\n    loud\n\n// class takes a name or a List of names; class:name toggles one name from a\n// bool. The two are independent contributions to the same attribute.\nexport component ClassDirectives:\n    state highlighted = false\n    state tone: Tone = Tone.quiet\n\n    def toggleHighlight():\n        highlighted = not highlighted\n\n    def switchTone():\n        tone = tone == Tone.quiet ? Tone.loud : Tone.quiet\n\n    return <div data-class-directives>\n        <p\n            data-classes\n            class={["tour-note", "tour-note-wide"]}\n            class:tour-active={highlighted}\n            class:tour-quiet={tone == Tone.quiet}\n        >\n            class directives\n        </p>\n        <button type="button" data-toggle-highlight on:click={toggleHighlight}>Toggle highlight</button>\n        <button type="button" data-toggle-tone on:click={switchTone}>Toggle tone</button>\n    </div>`
const classErrorCode = `component Tab(label: string, selected: string):\n    return <button type="button" class="tab" class:selected={selected}>{label}</button>`
const classErrorOutput = `main.vel:2:46 error VEL4001: Cannot assign string to bool\n    return <button type="button" class="tab" class:selected={selected}>{label}</button>\n                                             ^^^^^^^^^^^^^^^^^^^^^^^^^`
const inlineStyleJsCode = `// The split every project ends up with\n<div className="panel" style={{ opacity: hot ? 1 : 0.5 }} />\n// The stylesheet owns hover, media queries and pseudo-elements.\n// The inline object owns everything that changes. Nothing decided the line.`
const visualsCode = `import {rgb, spacing} from "velar/look"\n\nconst controlLook = look:\n    display = "inline-flex"\n    gap = 6px\n    padding = spacing(6px, 10px)\n    borderRadius = 8px\n\nconst inkColor = rgb(24, 31, 46)\n\n// look={value} composes an existing Look, every look:property on the element\n// forms one anonymous base applied after it, and style:property is the\n// inline-priority compatibility override.\nexport component StyleDirectives:\n    state hot = false\n\n    def toggle():\n        hot = not hot\n\n    return <div data-style-directives>\n        <p data-visuals look={controlLook} look:color={inkColor} look:fontWeight={600} style:letterSpacing={0.02em}>\n            look and style directives\n        </p>\n        <p data-reactive look:color={hot ? inkColor : null}>a null value removes the controlled property</p>\n        <p\n            data-attributes\n            data-flag={hot}\n            data-absent={hot ? "present" : null}\n            hidden={not hot}\n        >\n            attribute values\n        </p>\n        <button type="button" data-toggle-hot on:click={toggle}>Toggle</button>\n    </div>`
const indexKeyJsCode = "// React 19.2 — the key that looks harmless\n{tasks.map((task, index) => <TaskRow key={index} task={task} />)}\n// Delete the first row and every row below it inherits the previous row's\n// state: the focused input, the open menu, the half-typed text."
const keyErrorCode = `component Panel:\n    return <div><p key="only">one</p></div>`
const keyErrorOutput = `main.vel:2:20 error VEL5050: This JSX key has no effect: '<p>' is rendered in a fixed position, and keys reuse children by identity only inside 'items.map(item => <Row key={item.id} />)' — remove the key, or render this element from a keyed .map()\n    return <div><p key="only">one</p></div>\n                   ^^^^^^^^^^`
const refKeyCode = `// A key drives identity-preserving reuse only in the keyed-children shape.\n// There are no if, else-if or else JSX attributes: conditional children are\n// ordinary expressions.\nexport component ChildDirectives:\n    state names: List<string> = ["alpha", "beta"]\n    state shown = true\n\n    let field: InputElement? = null\n\n    def reverse():\n        names = [...names].reversed()\n\n    def focusField():\n        if field != null:\n            field.focus()\n\n    return <div data-child-directives>\n        <input ref={field} data-field type="text" aria-label="A referenced field" />\n        <ul data-keyed>\n            {names.size == 0 ? <li data-empty>nothing listed</li> : names.map(name => <li key={name} data-listed={name}>{name}</li>)}\n        </ul>\n        <p data-conditional>\n            {shown ? <strong>on</strong> : <span>off</span>}\n        </p>\n        <p data-nullish>\n            {(shown ? null : "fallback") ?? <em>from nullish</em>}\n        </p>\n        <div data-positions>\n            {[<b>one</b>, <i>two</i>]}\n        </div>\n        <button type="button" data-reverse on:click={reverse}>Reverse</button>\n        <button type="button" data-focus-field on:click={focusField}>Focus the field</button>\n    </div>`
const literalCode = `// The three literal attribute delimiters — double quotes, the HTML single\n// quote, and backticks for a value that already contains a quotation mark.\n// Raw HTML is an explicit string-only boundary that cannot carry children.\nexport component LiteralDirectives:\n    const markup = "<em>trusted markup</em>"\n\n    return <div data-literal-directives>\n        <p data-double="double quoted" data-single='single quoted' data-backtick=\`a "quoted" phrase\`>attribute delimiters</p>\n        <div data-markup unsafe:html={markup}></div>\n    </div>`

const sections = [
    {id: "jsx", label: "An attribute one letter off", labelZh: "差一个字母的属性"},
    {id: "events", label: "What a handler is allowed to see", labelZh: "处理器能看到什么"},
    {id: "bindings", label: "The controlled-input dance", labelZh: "受控输入的那套舞步"},
    {id: "classes", label: "A class name that says false", labelZh: "写着 false 的类名"},
    {id: "visuals", label: "The line between two styling systems", labelZh: "两套样式系统之间的那条线"},
    {id: "refkey", label: "The key that looked harmless", labelZh: "看着没事的那个 key"},
    {id: "literal", label: "Literals and raw markup", labelZh: "字面量与原始标记"},
]

const directiveRows: List<MemberRow> = [
    {name: "on:event", signature: "on:click={handler}", summary: "Binds a handler to a native DOM event; the handler's parameter is a typed event.", summaryZh: "把处理器绑到原生 DOM 事件上；处理器的参数是带类型的事件。"},
    {name: "bind:value", signature: "bind:value={draft}", summary: "Two-way binding for text inputs, textareas, and select elements.", summaryZh: "文本输入框、textarea 与 select 的双向绑定。"},
    {name: "bind:checked", signature: "bind:checked={accepted}", summary: "Two-way binding for one checkbox, held as a bool.", summaryZh: "单个复选框的双向绑定，用 bool 存。"},
    {name: "bind:group", signature: "bind:group={pick}", summary: "One decision shared by a set of controls: a radio group's selected value, or a checkbox group's List<string> membership.", summaryZh: "一组控件共享的一个决定：单选组选中的值，或复选组的 List<string> 成员关系。"},
    {name: "class", signature: `class={["note", "wide"]}`, summary: "A class name or a List of names; the value may be reactive.", summaryZh: "一个类名，或一个类名 List；取值可以是响应式的。"},
    {name: "class:name", signature: "class:active={selected}", summary: "Adds and removes one class name as a bool changes.", summaryZh: "随一个 bool 变化增删一个类名。"},
    {name: "look", signature: "look={panelLook}", summary: "Composes a whole Look value onto the element, and may be reactive.", summaryZh: "把一整个 Look 值合成到元素上，可以是响应式的。"},
    {name: "look:property", signature: "look:color={ink}", summary: "Sets one checked Look property; a null value removes it.", summaryZh: "设置一个受检的 Look 属性；取值为 null 就移除它。"},
    {name: "style:property", signature: "style:letterSpacing={0.02em}", summary: "Writes the real CSS property at inline priority; a compatibility layer rather than a second visual language.", summaryZh: "以内联优先级写出真实的 CSS 属性；这是兼容层，不是第二套视觉语言。"},
    {name: "ref", signature: "ref={field}", summary: "Fills a mutable optional binding with the constructed element or a component Handle.", summaryZh: "把构造好的元素或组件 Handle 填进一个可变的可选绑定。"},
    {name: "key", signature: "key={item.id}", summary: "Identifies a row in a keyed children shape so reuse follows identity rather than position.", summaryZh: "在带 key 的 children 形状里标识一行，让复用跟着身份走，而不是跟着位置走。"},
    {name: "unsafe:html", signature: "unsafe:html={markup}", summary: "A string-only raw markup boundary; it cannot carry children.", summaryZh: "只收字符串的原始标记边界；它不能带 children。"},
]

const modifierRows: List<MemberRow> = [
    {name: "prevent", signature: "on:submit.prevent", summary: "Calls preventDefault() before the handler runs.", summaryZh: "在处理器运行前调用 preventDefault()。"},
    {name: "stop", signature: "on:click.stop", summary: "Calls stopPropagation() before the handler runs.", summaryZh: "在处理器运行前调用 stopPropagation()。"},
    {name: "self", signature: "on:click.self", summary: "Ignores the event unless this element is the event's target.", summaryZh: "除非本元素就是事件的 target，否则忽略这次事件。"},
    {name: "capture", signature: "on:click.capture", summary: "Registers the listener for the capture phase.", summaryZh: "在捕获阶段注册监听器。"},
    {name: "once", signature: "on:click.once", summary: "Removes the listener after one dispatch.", summaryZh: "分发一次之后移除监听器。"},
]

const linkLook = look:
    color = sea
    textDecoration = "none"

    if @hover:
        textDecoration = "underline"

export component WebTemplates:
    const locale = useLocale()
    return <main>
        <Head
            title={headTitle("/guide/web/templates", locale.isChinese())}
            description={locale.text("Why an attribute one letter off is a compile error, what an event handler is allowed to see, and the whole closed directive table.", "差一个字母的属性为什么是编译错误、事件处理器能看到什么，以及那张封闭的完整指令表。")}
            themeColor="#f7f5f0"
        />
        <DocsShell items={guideNav}>
            <PageHeader
                kicker={locale.text("Web extension / 03", "Web 扩展 / 03")}
                title={locale.text("Templates and directives", "模板与指令")}
                summary={locale.text("JSX is grammar here rather than a preprocessor step, so a native element accepts twelve directives and nothing else. This chapter is what each one buys and what it costs.", "这里的 JSX 属于语法，不是预处理步骤，所以原生元素只接受十二个指令。这一章讲每一个换来了什么、又要付出什么。")}
            />
            <SectionList items={sections} />
            <Prose>
                <SectionHeading id="jsx">{locale.text("An attribute one letter off", "差一个字母的属性")}</SectionHeading>
                <Paragraph>
                    {locale.text("These two lines differ by one capital letter.", "下面这两行只差一个大写字母。")}
                </Paragraph>
                <CodeBlock code={handlerCaseJsCode} />
                <Paragraph>
                    {locale.text("The second is not a handler. JSX is a transform, so an attribute name it does not recognise is passed along to the DOM, and what you get is an element with a strange attribute and a button that does nothing. In development React will often warn; in production it will not. Either way the failure surfaces as behaviour rather than as a message about the line you wrote.", "第二行不是处理器。JSX 是一次转换，它不认识的属性名会被原样交给 DOM，于是你得到一个带着奇怪属性的元素，和一个按下去没反应的按钮。开发模式下 React 通常会警告，生产模式不会。不管哪种，失败最后浮现的方式是「行为不对」，而不是一条关于你写的那一行的消息。")}
                </Paragraph>
                <CodeBlock code={directiveErrorCode} />
                <CodeBlock code={directiveErrorOutput} />
                <Paragraph>
                    {locale.text("Elements, attributes and interpolations are parsed by the compiler, not by a preprocessor. That is the whole mechanism, and it is why a name outside the table is a diagnostic that names the current spelling. A native element accepts twelve directives; the table below is the complete list.", "元素、属性与插值由编译器解析，不是由预处理器处理。机制就这一句，也正因如此，表外的名字会得到一条点名当前拼写的诊断。原生元素接受十二个指令；下面这张表就是完整清单。")}
                </Paragraph>
                <MemberTable
                    rows={directiveRows}
                    caption={locale.text("Directives a native element accepts", "原生元素接受的指令")}
                />
                <BulletList>
                    <li>
                        {locale.text("A less-than sign begins JSX in a fixed set of positions: after return, after an assignment, after an opening parenthesis or bracket, after a comma, after an arrow, and after the nullish operator.", "小于号只在一组固定位置开始 JSX：return 之后、赋值之后、左圆括号或左方括号之后、逗号之后、箭头之后，以及空值合并运算符之后。")}
                    </li>
                    <li>
                        {locale.text("JSX text is normalized before it becomes a text node: every whitespace run inside a text child collapses to one space, and whitespace that exists only because the source wrapped is dropped.", "JSX 文本在变成文本节点之前先规范化：文本子节点里每一段空白折叠成一个空格，纯粹因为源码折行而出现的空白被丢掉。")}
                    </li>
                    <li>
                        {locale.text("Indentation therefore never adds spaces to the output, while a deliberate space between two inline elements on one line survives.", "所以缩进永远不会给输出加空格，而同一行两个内联元素之间刻意留的那个空格会保留。")}
                    </li>
                </BulletList>
                <Paragraph>
                    {locale.text("The cost of grammar over transform is that there are no seams. JSX has no comment form, so a note about markup lives outside it. There is no attribute-spreading spelling, so a wrapper that wants to pass twenty attributes through writes twenty. And a tool that wants to read a VelarScript template cannot borrow a JavaScript parser and get most of the way there.", "把 JSX 做成语法而不是转换，代价是没有缝可插。JSX 没有注释形式，关于标记的说明只能写在它外面。也没有属性展开的写法，想透传二十个属性的包装器就得写二十遍。而想读 VelarScript 模板的工具，没法借一个 JavaScript 解析器蒙混过关。")}
                </Paragraph>
                <GateNote>
                    {locale.text("Gate: every VelarScript block on this page is compiled by scripts/check-code-samples.mjs, and each quoted VEL code is verified against the diagnostics its own sample really produces.", "门禁：本页每个 VelarScript 块都由 scripts/check-code-samples.mjs 编译；引用的每个 VEL 码都与它自己那个样本真正产生的诊断核对过。")}
                </GateNote>

                <SectionHeading id="events">
                    {locale.text("What a handler is allowed to see", "处理器能看到什么")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("Reading the value out of an input is the first thing anybody does, and this is the line.", "从输入框里读值是每个人做的第一件事，写出来就是这一行。")}
                </Paragraph>
                <CodeBlock code={targetCastTsCode} />
                <Paragraph>
                    {locale.text("The cast is there because event.target is typed as the general event target, which has no value. So you assert the element type — and the assertion is unchecked. Move the same handler onto a form and the target is now whichever descendant was clicked; the cast still compiles and now it is a lie. This is the seam where untyped DOM reading gets back into application code, and it gets in through the one object every handler receives.", "这个 cast 之所以在，是因为 event.target 的类型是通用的事件目标，上面没有 value。于是你断言一个元素类型——而这个断言不受检。把同一个处理器挪到 form 上，target 就变成被点中的那个后代；cast 照样通过编译，只是现在它在说谎。无类型的 DOM 读取就是从这条缝回到应用代码里的，而这条缝是每个处理器都会收到的那个对象。")}
                </Paragraph>
                <CodeBlock code={eventTypesCode} />
                <Paragraph>
                    {locale.text("An event object here carries typed event fields and nothing else. There is no target and no currentTarget, so the seam is not narrowed — it is closed. The two questions people used target for each have their own answer: the value comes from the cell the control is bound to, and whether this element was the one hit is what the self modifier says.", "这里的事件对象只带类型确定的事件字段，别的没有。没有 target，也没有 currentTarget，所以这条缝不是被收窄，是被封上了。以前用 target 问的两个问题各有各的答案：值从控件绑定的那个单元里来；「是不是本元素被点中」由 self 修饰符回答。")}
                </Paragraph>
                <CodeBlock code={eventsCode} />
                <MemberTable rows={modifierRows} caption={locale.text("The five event modifiers", "五个事件修饰符")} />
                <BulletList>
                    <li>
                        {locale.text("There are exactly five modifiers, an unknown one is a compile error, and none may repeat.", "修饰符恰好五个，未知的是编译错误，任何一个都不能重复。")}
                    </li>
                    <li>
                        {locale.text("They are appended with dots and always apply in the order self, prevent, stop, and then the handler runs.", "它们用点追加，并且总是按 self、prevent、stop 的顺序生效，然后处理器才跑。")}
                    </li>
                    <li>
                        {locale.text("A zero-parameter handler stays valid, and no synthetic event runtime is layered over the native one.", "零参数处理器仍然有效，也没有在原生事件之上再叠一层合成事件运行时。")}
                    </li>
                </BulletList>
                <Paragraph>
                    {locale.text("The cost is event delegation. One handler on a container that works out which row was clicked needs the target, and the target is exactly what is not there — so a thousand-row table gets a thousand handlers rather than one. For most interfaces that is a non-issue and the browser handles it; for a very large table it is a real difference, and there is no supported spelling that gives the delegated version back.", "代价是事件委托。在容器上放一个处理器、再判断点中了哪一行，这需要 target，而 target 恰恰不在——于是一千行的表格会有一千个处理器，而不是一个。对多数界面这不成问题，浏览器扛得住；对特别大的表格这是实打实的差别，而且没有哪种受支持的写法能把委托那一版还给你。")}
                </Paragraph>

                <SectionHeading id="bindings">
                    {locale.text("The controlled-input dance", "受控输入的那套舞步")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("Three lines, and only the last one behaves.", "三行，只有最后一行是对的。")}
                </Paragraph>
                <CodeBlock code={controlledJsCode} />
                <Paragraph>
                    {locale.text("A value without a change handler makes the field read-only. A value that starts undefined and later becomes a string switches the input from uncontrolled to controlled, and React warns about that too. Both are warnings about a pairing the framework needs you to keep, in two attributes it has no way to check together.", "有 value 没有 change 处理器，输入框就是只读的。value 一开始是 undefined、后来变成字符串，输入框就从非受控切成受控，React 同样会警告。这两条都是在提醒你维持一组配对，而这组配对写在两个属性里，框架没办法把它们放在一起检查。")}
                </Paragraph>
                <CodeBlock code={bindCode} />
                <Paragraph>
                    {locale.text("bind names the pairing once, so there is no pairing to keep. There are four spellings and that is all of them: bind:value for a text input, textarea or select; bind:checked for one checkbox as a bool; and bind:group twice over, once for a radio group whose state holds the selected input's value and once for a checkbox group whose List<string> state holds the checked values, so ticking and unticking are membership changes.", "bind 把这组配对一次说完，也就没有配对要维持了。写法只有四种，就这四种：bind:value 给文本输入框、textarea 或 select；bind:checked 用 bool 绑一个复选框；bind:group 出现两次，一次给单选组，它的 state 存被选中输入的 value，一次给复选组，它的 List<string> state 存被勾选的值，于是勾选与取消就是成员关系的变化。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("Every bind target is a writable reactive location: a state name, or a field or index path rooted in one. Anything else is refused at the directive.", "每个 bind 目标都是一个可写的响应位置：一个 state 名字，或者以它为根的字段路径、索引路径。别的都会在指令处被拒。")}
                </Paragraph>
                <CodeBlock code={bindErrorCode} />
                <CodeBlock code={bindErrorOutput} />
                <Paragraph>
                    {locale.text("The cost is reach. bind works on native form controls, not on your own components: a component that wraps an input takes a value and a callback like any other component, and the binding stops at its boundary. It also cannot bind to a computed or to a prop, because neither is a place a write can land — which is right, and which means the cases where a wrapper would have been convenient are the cases you write out by hand.", "代价是覆盖面。bind 作用于原生表单控件，不作用于你自己的组件：包着一个 input 的组件，和别的组件一样收一个值加一个回调，绑定到它的边界为止。它也不能绑到 computed 或 prop 上，因为这两个都不是写入能落脚的地方——这是对的，代价是那些「有个包装器会很省事」的场合，得手写出来。")}
                </Paragraph>

                <SectionHeading id="classes">
                    {locale.text("A class name that says false", "写着 false 的类名")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("Conditional class names are the first thing a template needs and the first thing that goes wrong.", "条件类名是模板最先要的东西，也是最先出岔子的东西。")}
                </Paragraph>
                <CodeBlock code={classJoinJsCode} />
                <Paragraph>
                    {locale.text("The string interpolation is doing exactly what it was told; nobody meant a class called false. This is small and completely universal, which is why a tiny package whose only job is joining class names is a dependency of almost every front end. A whole npm package exists because the template had no way to say what was meant.", "字符串插值老老实实照做了；没人想要一个叫 false 的类。这件事很小，也彻底普遍——所以「把类名拼起来」这件唯一的活儿，撑起了一个几乎每个前端项目都装的小包。一个 npm 包之所以存在，是因为模板没办法把意思说出来。")}
                </Paragraph>
                <CodeBlock code={classesCode} />
                <Paragraph>
                    {locale.text("class takes a name or a List of names. class:name toggles one name from a bool. They are independent contributions to the same attribute, so a static class, a reactive list and several toggles coexist on one element without anyone joining strings. The toggle takes a bool because every condition in this language takes a bool, which is the same rule you already met and not a template rule.", "class 收一个类名或一个类名 List。class:name 由一个 bool 开关一个类名。两者是对同一个属性的独立贡献，所以静态类、响应式类列表和若干开关能同处一个元素，谁都不用去拼字符串。开关要 bool，是因为这门语言里每个条件都要 bool——这是你已经见过的那条规则，不是模板另立的规矩。")}
                </Paragraph>
                <CodeBlock code={classErrorCode} />
                <CodeBlock code={classErrorOutput} />
                <Paragraph>
                    {locale.text("The cost is keystrokes, every time. A string that happens to be non-empty does not toggle a class here; you write the comparison you meant, and you write it at each site. The saving is that the attribute never contains a word nobody chose.", "代价是每次都要多敲字。碰巧非空的字符串在这里开不了一个类；你要写出你真正想问的那个比较，而且每处都要写。省下来的是：这个属性里永远不会出现一个没人挑过的词。")}
                </Paragraph>

                <SectionHeading id="visuals">
                    {locale.text("The line between two styling systems", "两套样式系统之间的那条线")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("Almost every component ends up styled by two systems at once.", "几乎每个组件最后都同时被两套系统设样式。")}
                </Paragraph>
                <CodeBlock code={inlineStyleJsCode} />
                <Paragraph>
                    {locale.text("The stylesheet owns hover, media queries and pseudo-elements because the inline object cannot express them. The inline object owns whatever changes because the stylesheet cannot see the state. Nobody decided where the line goes; the platform did, and it goes through the middle of one component's appearance.", "样式表拥有 hover、媒体查询和伪元素，因为内联对象表达不了它们。内联对象拥有会变的部分，因为样式表看不见状态。这条线不是谁定的，是平台定的，而它正好从一个组件的外观中间穿过去。")}
                </Paragraph>
                <CodeBlock code={visualsCode} />
                <Paragraph>
                    {locale.text("Here one vocabulary covers both sides. look={value} composes an existing Look; every look:property on the element forms one anonymous base applied after that composition; a null expression removes the composed property rather than emitting the text null. style:property is the third spelling and it is honest about what it is — the real CSS property at inline priority, reusing Look's property table, types, builders and reactive updates, kept as a native compatibility layer rather than a second visual language.", "在这里一套词汇覆盖两边。look={value} 合成一个已有的 Look；元素上每个 look:property 组成一个匿名基底，在那次合成之后应用；取值为 null 会把被合成的属性移掉，而不是发出 null 这个词。style:property 是第三种写法，它对自己是什么很坦白——以内联优先级写出的真实 CSS 属性，复用 Look 的属性表、类型、构建器与响应式更新，作为原生兼容层留着，而不是第二套视觉语言。")}
                </Paragraph>
                <BulletList>
                    <li>
                        {locale.text("Hooks, media conditions, pseudo-elements and spreads stay exclusive to a named or local full Look. A form such as look:hover:color does not exist.", "钩子、媒体条件、伪元素与展开只属于具名或局部的完整 Look。look:hover:color 这种形式并不存在。")}
                    </li>
                    <li>
                        {locale.text("An attribute whose value is null is removed rather than rendered, so a conditional attribute is an ordinary conditional expression.", "取值为 null 的属性会被移除而不是渲染出来，所以条件属性就是普通的条件表达式。")}
                    </li>
                </BulletList>
                <Paragraph>
                    {locale.text("The cost is that the element cannot set a stateful property one at a time. A hover colour that depends on application state is expressed by choosing between two named Looks, not by writing look:hover:color, so a component with several independent stateful visuals accumulates named Looks rather than one-line overrides. That is more names, and it is the reason the rules can be extracted at build time at all.", "代价是元素没法一次只设一条带状态的属性。取决于应用状态的 hover 颜色，要靠在两个具名 Look 之间挑一个来表达，而不是写 look:hover:color；所以有好几处独立状态视觉的组件，攒下来的是一堆具名 Look，而不是一行行覆盖。名字更多了。也正因为这样，这些规则才能在构建期被提取出来。")} <Link
                        to="/evidence"
                        look={linkLook}
                    >
                        {locale.text("The evidence page shows one look literal and the CSS rule it becomes.", "证据页摆出了一个 look 字面量，以及它变成的那条 CSS 规则。")}
                    </Link>
                </Paragraph>

                <SectionHeading id="refkey">
                    {locale.text("The key that looked harmless", "看着没事的那个 key")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("Every list needs a key, and the index is right there.", "每个列表都要 key，而下标就在手边。")}
                </Paragraph>
                <CodeBlock code={indexKeyJsCode} />
                <Paragraph>
                    {locale.text("It works until the list changes shape. Delete the first row and row two moves into row one's position while keeping row one's key, so the framework reuses row one's instance for row two's data: the focused input, the open menu and the half-typed text all shift up by one. The list still looks right after a repaint, which is why this one takes so long to find.", "在列表的形状没变之前它都好用。删掉第一行，第二行搬进第一行的位置、却还顶着第一行的 key，于是框架把第一行的实例拿来装第二行的数据：获得焦点的输入框、展开的菜单、打了一半的字，全都往上串了一格。重绘之后列表看着还是对的，所以这个问题特别难找。")}
                </Paragraph>
                <CodeBlock code={refKeyCode} />
                <Paragraph>
                    {locale.text("key belongs on the element a map produces, or on a branch of a conditional that produces one, and it identifies the row rather than its position. A keyed update moves only the rows whose position actually changed, so a row already standing where the new order wants it keeps its focused input and its in-flight composition. Both ordinary and keyed JSX lists read one checked dense List snapshot, so a mutation during rendering cannot change the values taking part in that update.", "key 属于 map 产生的那个元素，或者产生该元素的条件分支；它标识的是这一行，不是它的位置。带 key 的更新只移动位置确实变了的行，所以已经站在新顺序要它站的位置上的那一行，会保住它的焦点输入框和进行中的输入法组合。普通 JSX 列表和带 key 的列表读的是同一份受检的稠密 List 快照，所以渲染期间的改动改不了参与这次更新的取值。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("A key outside that shape does nothing, so it is refused rather than accepted and ignored.", "不在那个形状里的 key 什么也做不了，所以它会被拒绝，而不是收下再无视。")}
                </Paragraph>
                <CodeBlock code={keyErrorCode} />
                <CodeBlock code={keyErrorOutput} />
                <Paragraph>
                    {locale.text("ref is the other identity directive: it fills a mutable optional binding with the constructed element, is null while the component body runs, and is filled before @mounted — which is why DOM setup lives there. The cost of both is narrowness. key is not a general annotation you can sprinkle for reuse, and there are no if, else-if or else JSX attributes, so conditional children are ordinary expressions. Someone arriving from a template language will find fewer template features here than they expect, on purpose.", "另一个身份指令是 ref：它把构造好的元素填进一个可变的可选绑定，组件体运行期间是 null，在 @mounted 之前被填上——所以需要 DOM 的初始化写在那里。两者的代价都是窄。key 不是能到处撒来换复用的通用注记；JSX 也没有 if、else-if、else 属性，条件子节点就是普通表达式。从模板语言过来的人，会发现这里的模板特性比预想的少——这是故意的。")}
                </Paragraph>

                <SectionHeading id="literal">
                    {locale.text("Literals and raw markup", "字面量与原始标记")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("An attribute value that already contains a quotation mark is the small annoyance that ends with somebody escaping by hand and getting it wrong once. There are three delimiters here so that nobody has to: double quotes, the HTML single quote, and backticks.", "属性值里本身就带引号，是那种小麻烦——最后总有人手工转义，并且总会错一次。这里给了三种定界符，就是为了不必手工转义：双引号、HTML 单引号，以及反引号。")}
                </Paragraph>
                <CodeBlock code={literalCode} />
                <Paragraph>
                    {locale.text("unsafe:html is the other boundary in that block, and its name is the whole warning. It is an explicit wholesale assignment of the element's inner HTML on every reactive update: it does not morph DOM and does not preserve descendant identity, so everything inside is replaced rather than updated in place. It cannot carry children either, because the assignment owns the whole subtree.", "那一块里的另一条边界是 unsafe:html，它的名字就是全部警示。它在每次响应式更新时，对元素的内部 HTML 做一次显式的整体赋值：不做 DOM 变形，也不保留后代身份，所以里面的一切是被替换，不是就地更新。它也不能带 children，因为这次赋值拥有整棵子树。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("The cost is everything the checked path gives you. Inside that string there is no element vocabulary, no escaping performed for you, and no incremental update; a stream of markup that must update as it arrives has no supported spelling here, because the boundary deliberately does not infer a parser-owned contract. Reaching for it is an ordinary decision rather than a failure, and the escape-hatch chapter is where the other exits are.", "代价是受检那条路上给你的一切。在那个字符串里，没有元素词汇表，不替你转义，也没有增量更新；边流入边更新的标记流在这里没有受支持的写法，因为这条边界刻意不去推断一份由解析器拥有的契约。用它是一个普通决定，不是一次失败；其余的出口在逃生通道那一章。")} <Link
                        to="/guide/web/beyond-look"
                        look={linkLook}
                    >
                        {locale.text("Beyond Look covers this boundary and the CSS one together.", "「Look 之外」把这条边界和 CSS 那条一起讲了。")}
                    </Link>
                </Paragraph>
                <Callout title={locale.text("What the directive set does not contain", "指令集合里没有什么")}>
                    <Paragraph>
                        {locale.text("There is no directive that reads an untyped element inside a handler, no raw style attribute, no conditional directive name, and no reusable Style value. Each of those has one supported spelling instead: a binding, a ref, an ordinary conditional expression, and a Look.", "没有哪个指令能在处理器内部读一个无类型的元素，没有原始 style 属性，没有条件化的指令名，也没有可复用的 Style 值。它们各自都有一种受支持的写法：绑定、ref、普通条件表达式，以及 Look。")}
                    </Paragraph>
                </Callout>
            </Prose>
            <DocsPager previous={guidePrevious("/guide/web/templates")} next={guideNext("/guide/web/templates")} />
        </DocsShell>
    </main>
