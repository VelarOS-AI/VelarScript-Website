import {Head, Link} from "velar/web"
import {CodeBlock, Callout, DocsShell, PageHeader, Prose} from "@velarscript/docs-kit"
import {useLocale} from "@velarscript/site-ui"
import {docsNav} from "../content.vel"

const coreTestCode = "import {expect} from \"velar/test\"\n\ndef test_total_is_stable():\n    expect(total([1, 2, 3])).toBe(6)\n    expect({name: \"VelarScript\"}).toEqual({name: \"VelarScript\"})\n\nasync def test_rejection():\n    await expect(() => loadMissing()).toReject(\"Not found\")"
const browserTestCode = "import {expect} from \"velar/test\"\nimport {browser} from \"velar/web-test\"\n\nasync def test_project_navigation():\n    await browser.viewport(390, 844)\n    await browser.open(\"/projects/velar\")\n    await browser.waitForText(\"h1\", \"VelarScript\")\n    expect(await browser.currentPath()).toBe(\"/projects/velar\")\n    await browser.click(\"[data-star]\")\n    expect(await browser.text(\"[data-status]\")).toBe(\"Starred\")"
const buildCode = "velar format --check\nvelar check\nvelar test\nvelar test --browser all\nvelar build\nvelar verify\nvelar preview"
const deployCode = "# Deploy dist/ with its generated contract, then:\nvelar verify-deployment --url https://app.example.com\nvelar verify-deployment --url https://app.example.com --json"

export component TestingDeployment:
    const locale = useLocale()
    return <main data-testing-docs>
        <Head title={locale.text("Testing and deployment · VelarScript", "测试与部署 · VelarScript")} description={locale.text("VelarScript unit tests, browser tests, formatting, checking, deterministic production builds, local verification, preview, and remote deployment verification.", "VelarScript 的单元测试、浏览器测试、格式化、检查、确定性生产构建、本地验证、预览与远端部署验证。")} themeColor="#f7f5f0" />
        <DocsShell items={docsNav}>
            <PageHeader kicker={locale.text("Reference / Delivery", "参考 / 交付")} title={locale.text("Test the source; verify the artifact users receive.", "测试源码，验证用户真正收到的产物。")} summary={locale.text("Fast Core tests cover domain logic. Browser tests run the real CSP application. Production verification turns output and hosting behavior into exact contracts.", "快速 Core 测试覆盖领域逻辑，浏览器测试运行真实 CSP 应用，生产验证把产物与托管行为变成精确契约。")} tags={["velar/test", "velar/web-test", "3 browsers", "SHA-256"]} />
            <Prose>
                <h2 id="core-tests">{locale.text("Core tests", "Core 测试")}</h2>
                <CodeBlock code={coreTestCode} />
                <p>{locale.text("Files ending in ", "以 ")}<code>.test.vel</code>{locale.text(" are discovered recursively. Top-level ", " 结尾的文件递归发现。顶层 ")}<code>test_*</code>{locale.text(" functions need not export. ", " 函数无需导出。")}<code>expect</code>{locale.text(" provides identity, structural equality, boolean, containment, pattern, length, throw, and rejection matchers.", " 提供身份、结构相等、布尔、包含、模式、长度、抛错与拒绝 matcher。")}</p>
                <p><code>toBe</code>{locale.text(" follows strict value/reference equality. ", " 遵循严格值/引用相等。")}<code>toEqual</code>{locale.text(" uses public ", " 使用公开 ")}<code>velar/json.deepEqual</code>{locale.text(". Boolean matchers require real bools, and subject matchers stay checked so sync throws cannot masquerade as rejected Promises.", "。布尔 matcher 要求真实 bool，主题 matcher 保持受检查，因此同步抛错不能伪装成 Promise 拒绝。")}</p>

                <h2 id="browser-tests">{locale.text("Browser application tests", "浏览器应用测试")}</h2>
                <CodeBlock code={browserTestCode} />
                <p>{locale.text("Files ending in ", "以 ")}<code>.browser.test.vel</code>{locale.text(" run only through ", " 结尾的文件只通过 ")}<code>velar test --browser</code>{locale.text(". CLI builds an isolated real CSP production site and fresh browser context per test. Page errors and console warning/errors fail automatically.", " 运行。CLI 构建隔离的真实 CSP 生产站点，并为每个测试打开新浏览器上下文。页面错误与 console 警告/错误自动导致失败。")}</p>
                <p>{locale.text("The compact typed controller exposes navigation, interaction, reads, waiting, path, and viewport operations. It is intentionally not a raw DOM or Playwright escape hatch.", "紧凑类型化控制器暴露导航、交互、读取、等待、路径与视口操作。它有意不成为原始 DOM 或 Playwright 逃生口。")}</p>
                <p>{locale.text("Chromium is local default. Choose ", "本地默认 Chromium。可显式选择 ")}<code>chromium</code>, <code>firefox</code>, <code>webkit</code>{locale.text(", or ", " 或 ")}<code>all</code>{locale.text(". Browser binaries remain an explicit Playwright installation outside project creation.", "。浏览器二进制仍通过项目创建之外的显式 Playwright 安装获得。")}</p>

                <h2 id="quality-gate">{locale.text("Recommended delivery gate", "推荐交付门禁")}</h2>
                <CodeBlock code={buildCode} />
                <ul>
                    <li><code>format --check</code>{locale.text(" prevents formatting drift.", " 防止格式漂移。")}</li>
                    <li><code>check</code>{locale.text(" runs parser, resolution, type, Web, accessibility, and extension diagnostics.", " 运行解析、名称解析、类型、Web、无障碍与扩展诊断。")}</li>
                    <li>{locale.text("Core and browser tests separately cover logic and delivered behavior.", "Core 与浏览器测试分别覆盖逻辑与交付行为。")}</li>
                    <li><code>build</code>{locale.text(" stages, bundles, tree-shakes, minifies, splits checked dynamic modules, extracts Look CSS, hashes assets, and writes deterministic manifests.", " 暂存、打包、tree-shake、压缩、拆分受检查动态模块、提取 Look CSS、哈希资源并写确定性清单。")}</li>
                    <li><code>verify</code>{locale.text(" compares exact files, paths, sizes, SHA-256, roles, build ID, versions, source-map policy, CSP, cache, fallback, and adapters.", " 比较精确文件、路径、大小、SHA-256、角色、构建 ID、版本、source map 策略、CSP、缓存、回退与适配器。")}</li>
                    <li><code>preview</code>{locale.text(" refuses unverified output and never turns missing assets into SPA shell.", " 拒绝未验证产物，也绝不把缺失资源变成 SPA shell。")}</li>
                </ul>

                <h2 id="artifacts">{locale.text("Production files", "生产文件")}</h2>
                <p><code>velar-build.json</code>{locale.text(" records build identity, versions, module composition, files, roles, sizes, hashes, source-map policy, and dependency summaries. ", " 记录构建身份、版本、模块组成、文件、角色、大小、哈希、source map 策略与依赖摘要。")}<code>velar-deploy.json</code>{locale.text(" declares base, SPA fallback, security headers, cache, and host adapter behavior.", " 声明 base、SPA 回退、安全响应头、缓存与宿主适配器行为。")}</p>
                <p>{locale.text("Compiler-owned HTML, manifests, and adapters cannot be overridden by ", "编译器拥有的 HTML、清单与适配器不能被 ")}<code>publicDir</code>{locale.text(". Production source maps are off by default and explicitly enabled.", " 覆盖。生产 source map 默认关闭，必须显式启用。")}</p>

                <h2 id="remote">{locale.text("Verify the deployment", "验证部署")}</h2>
                <CodeBlock code={deployCode} />
                <p>{locale.text("Remote verification checks local output, downloads every declared file from HTTPS, and compares transfer-decoded size/SHA-256. It checks MIME, security/cache headers, base, SPA navigation, and missing hashed-asset 404. Redirects, login pages, stale files, rewrites, and provider transforms fail closed.", "远端验证先检查本地产物，再从 HTTPS 下载每个声明文件，并比较传输解码后的大小/SHA-256。它检查 MIME、安全/缓存响应头、base、SPA 导航与缺失哈希资源 404。重定向、登录页、旧文件、重写与供应商变换都会封闭失败。")}</p>
                <Callout title={locale.text("Deployment is not a rebuild", "部署不是重新构建")}><p>{locale.text("Build once, verify once, deploy the exact directory, then remotely verify that identity. Fix hosting problems at hosting layer instead of silently producing a different artifact.", "构建一次、验证一次、部署精确目录，再远端验证该身份。托管问题应在托管层修复，而不是悄悄生成不同产物。")}</p></Callout>

                <h2 id="ci">{locale.text("CI shape", "CI 结构")}</h2>
                <p>{locale.text("Complete CI uses Node 24, installs from lockfile, runs format/check/Core, runs browser matrix where required, builds once, verifies output, and preserves manifests as evidence. Deployment stays separately authorized; remote verification proves selected origin after activation.", "完整 CI 使用 Node 24、按锁文件安装、运行 format/check/Core、按需运行浏览器矩阵、只构建一次、验证产物，并保留清单作为证据。部署仍是独立授权操作；激活后由远端验证证明所选源站。")}</p>

                <div class="next-links"><Link to="/docs/getting-started"><strong>{locale.text("Build the tutorial app", "构建教程应用")}</strong><span>{locale.text("Return to first project and apply the full delivery gate.", "回到第一个项目并应用完整交付门禁。")}</span></Link><Link to="/docs"><strong>{locale.text("Documentation overview", "文档概览")}</strong><span>{locale.text("Choose another language or framework chapter.", "选择其他语言或框架章节。")}</span></Link></div>
            </Prose>
        </DocsShell>
    </main>
