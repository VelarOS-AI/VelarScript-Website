import {Head, Link} from "velar/web"
import {BulletList, Callout, CodeBlock, DocsPager, DocsShell, GateNote, PageHeader, Paragraph, Prose, SectionHeading, SectionList, Subheading} from "@velarscript/docs-kit"
import {foundationSea as sea, useLocale} from "@velarscript/site-ui"
import {guideNav, guideNext, guidePrevious, headTitle} from "../content.vel"

const throwJsCode = `// JavaScript, in a retry helper somebody wrote three years ago\nif (response.status === 429) throw "rate limited";\n\n// ...and in the handler reading it today\ntry {\n  await send(request);\n} catch (error) {\n  logger.warn(error.message);   // undefined\n}`
const blocksCode = `async def save():\n    print("saved")\n\ndef close():\n    print("closed")\n\nexport async def tryCatchFinally() -> string:\n    try:\n        await save()\n    catch error:\n        return error.message\n    finally:\n        close()\n    return "ok"\n\n// catch with no finally, and try/finally with no catch.\nexport def catchOnly(values: List<number>) -> number:\n    try:\n        return values[99]\n    catch error:\n        return -1\n\nexport def finallyOnly() -> string:\n    try:\n        return "body"\n    finally:\n        close()\n\n// The five members every caught value has.\nexport def errorContract(error: Error) -> string:\n    const message = error.message\n    const name = error.name\n    const code = error.code\n    const stack = error.stack\n    const cause = error.cause\n    return f"{message} {name} {code} {stack} {cause == null}"\n\n// finally is cleanup, not a control-flow override, so a loop written wholly\n// inside one still uses its own break and continue.\nexport def loopInsideFinally(values: List<number>) -> number:\n    let seen = 0\n    try:\n        seen += 1\n    finally:\n        for value in values:\n            if value < 0:\n                continue\n            if value > 10:\n                break\n            seen += value\n    return seen`
const textErrorCode = "export def refuse(reason: string):\n    throw reason"
const textErrorOutput = "main.vel:2:11 error VEL4001: Only Error values can be thrown, received string\n    throw reason\n          ^^^^^^"

const enoentJsCode = `// JavaScript. The branch that decides whether to create the file.\ntry {\n  settings = JSON.parse(await readFile(path, "utf8"));\n} catch (error) {\n  if (error.code === "ENOENT") settings = defaults;\n  else throw error;\n}`
const raisedCode = `type Config:\n    retries: number\n\n// The three classes the compiler itself raises.\nexport def compilerRaised(untrusted: unknown, values: List<number>) -> string:\n    try:\n        const config = Config.parse(untrusted)\n        return str(values[config.retries])\n    catch error:\n        if error is ValidationError:\n            // ValidationError carries the detail its parse site reports.\n            return f"{error.path} {error.field} {error.reason}"\n        if error is NarrowingError:\n            return "a stale flow fact"\n        if error is IndexError:\n            return "an out-of-range position"\n        throw error\n\n// Each may be constructed and thrown directly.\nexport def constructAndThrow(kind: string):\n    if kind == "validation":\n        throw ValidationError("bad shape")\n    if kind == "narrowing":\n        throw NarrowingError("stale fact")\n    if kind == "index":\n        throw IndexError("out of range")\n    throw Error("ordinary")`
const capabilityCode = `// The five capability classes are reserved Core bindings and need no import.\nexport def capabilityRecovery(error: Error) -> string:\n    if error is FileNotFoundError:\n        return f"missing: {error.path}"\n    else if error is PermissionError:\n        return f"refused: {error.path}"\n    else if error is NotADirectoryError:\n        return f"not a directory: {error.path}"\n    else if error is FileExistsError:\n        return f"already there: {error.path}"\n    else if error is AddressInUseError:\n        return "bind another port, or port 0 for any free one"\n    else:\n        return error.message\n\n// code is the class name in string form, and it always agrees with is.\nexport def crossesAJsonBoundary(error: Error) -> string:\n    return Json.stringify({code: error.code, message: error.message})`
const foreignNodeCode = `extern module "node:vm":\n    export def runInThisContext(code: string) -> unknown\n\nimport js {runInThisContext} from "node:vm"\n\n// Four throws from JavaScript: a string, an object literal, null, and a real\n// TypeError. Read what arrives on this side of the boundary.\ndef attempt(source: string) -> string:\n    try:\n        const answer = runInThisContext(source)\n        return f"no throw: {answer == null}"\n    catch error:\n        return f"is Error: {error is Error}  name: {error.name}  code: {error.code}  message: {error.message}"\n\nprint(attempt("(function () { throw 'rate limited' })()"))\nprint(attempt("(function () { throw {code: 'RATE_LIMIT'} })()"))\nprint(attempt("(function () { throw null })()"))\nprint(attempt("(function () { throw new TypeError('bad shape') })()"))`
const foreignRunTextCode = "is Error: true  name: Error  code: Error  message: rate limited\nis Error: true  name: Error  code: Error  message: A non-Error value was thrown by JavaScript\nis Error: true  name: Error  code: Error  message: null\nis Error: true  name: TypeError  code: Error  message: bad shape"

const subclassJsCode = `// JavaScript. Every codebase has this class, and one place that forgot line 4.\nclass TimeoutError extends Error {\n  constructor(seconds) {\n    super("far too slow");\n    this.name = "TimeoutError";\n    this.seconds = seconds;\n  }\n}`
const customCode = `class TimeoutError extends Error:\n    constructor(message: string, const seconds: number):\n        super(message)\n\nclass SlowTimeoutError extends TimeoutError:\n    constructor(seconds: number):\n        super("far too slow", seconds)\n\nexport def customHierarchy(error: Error) -> string:\n    // A subclass answers with its declared name, and a type test narrows to\n    // the fields that subclass adds.\n    if error is SlowTimeoutError:\n        return f"{error.name} {error.code} {error.seconds}"\n    if error is TimeoutError:\n        return f"{error.name} after {error.seconds}"\n    return error.name`
const wireNodeCode = `type Profile:\n    name: string\n\nclass RateLimitError extends Error:\n    constructor(const retryAfterSeconds: number):\n        super("too many requests")\n\n// A branch tests the class. code is that same identity written as text, for\n// the JSON boundary a class cannot cross.\ndef report(error: Error) -> string:\n    if error is RateLimitError:\n        return Json.stringify({code: error.code, retryAfter: error.retryAfterSeconds})\n    if error is ValidationError:\n        return Json.stringify({code: error.code, reason: error.reason})\n    return Json.stringify({code: error.code, message: error.message})\n\ndef parseFailure() -> Error:\n    try:\n        const profile = Profile.parse({})\n        return Error(profile.name)\n    catch error:\n        return error\n\nprint(report(RateLimitError(30)))\nprint(report(parseFailure()))\nprint(report(Error("something else")))`
const wireRunTextCode = `{"code":"RateLimitError","retryAfter":30}\n{"code":"ValidationError","reason":"field 'name' is missing"}\n{"code":"Error","message":"something else"}`

const parseJsCode = "// JavaScript. Four lines and a mutable binding, to ask one question.\nlet settings;\ntry {\n  settings = JSON.parse(raw);\n} catch {\n  settings = defaults;\n}"
const expressionCode = `type Config:\n    retries: number\n\ndef readPort() -> number:\n    return 8080\n\nasync def load(url: string) -> string:\n    return url\n\nexport async def tryExpression(untrusted: unknown, url: string) -> string:\n    const parsed = try Config.parse(untrusted)\n    const port = try readPort() ?? 8080\n    const body = try await load(url)\n    // try reaches exactly as far as await does — over the whole postfix chain\n    // — so a failure anywhere in the chain produces one absent answer.\n    const chained = try url.trim().upper().slice(0, 3)\n    return f"{parsed?.retries} {port} {body} {chained}"\n\n// The result must be consumed; a bare try statement is rejected.\nexport def consumedResult(untrusted: unknown) -> number:\n    const config = try Config.parse(untrusted)\n    if config == null:\n        return 0\n    return config.retries`
const bareErrorCode = "type Config:\n    retries: number\n\nexport def load(untrusted: unknown):\n    try Config.parse(untrusted)"
const bareErrorOutput = "main.vel:5:5 error VEL4034: A 'try' result must be consumed — bind it, test it, or supply a fallback with '??'; to run something and ignore its failure on purpose, use a try/catch block\n    try Config.parse(untrusted)\n    ^^^^^^^^^^^^^^^^^^^^^^^^^^^"

const assertJsCode = `// JavaScript. This prints a red line and carries on with a negative total.\nconsole.assert(total >= 0, "negative total");`
const assertionsNodeCode = `type Config:\n    retries: number\n\ndef scale(maximum: number) -> number:\n    assert 0 < maximum <= 4096 else "The chart maximum is outside the supported range"\n    return maximum\n\n// A successful assertion narrows, so the next line may use what it settled.\nexport def retriesFor(config: Config?) -> number:\n    assert config != null else "A configuration is required"\n    return config.retries\n\nexport def bareAssertion(flag: bool):\n    assert flag\n\nprint(str(scale(1000)))\nprint(str(scale(9000)))`
const assertionRunTextCode = `1000\nAssertionError: The chart maximum is outside the supported range\n    assert 0 < maximum <= 4096 else "The chart maximum is outside the supported range"\n                          ^`

const fixableErrorCode = `import {sqrt} from "velar/math"\n\nexport def hypotenuse(a: number, b: number) -> number:\n    return sqrt(a * a + b * b);`
const fixableErrorOutput = `src/main.vel:1:9 error VEL3008: Use Math.sqrt directly; VelarScript's pure namespaces need no import\nimport {sqrt} from "velar/math"\n        ^^^^\n\nsrc/main.vel:4:31 error VEL1005: A statement ends at its newline; VelarScript does not use ';'\n    return sqrt(a * a + b * b);\n                              ^`
const fixShellCode = "velar fix"
const fixRunTextCode = "src/main.vel:1:1 fixed VEL3008: Drop the import and read through Math\nsrc/main.vel:4:31 fixed VEL1005: Remove the semicolon\napplied 2 mechanical fixes in 1 file; 0 diagnostics remain"

const sections = [
    {id: "blocks", label: "try, catch, finally", labelZh: "try、catch、finally"},
    {id: "classes", label: "The published classes", labelZh: "已发布的错误类"},
    {id: "custom", label: "Your own error classes", labelZh: "你自己的错误类"},
    {id: "expression", label: "When failure is an answer", labelZh: "把失败当成答案"},
    {id: "assertions", label: "Assertions the build cannot strip", labelZh: "构建剥不掉的断言"},
    {id: "diagnostics", label: "The failure that arrives first", labelZh: "最先到的那次失败"},
]

const inlineLinkLook = look:
    color = sea

export component LanguageErrors:
    const locale = useLocale()
    return <main>
        <Head
            title={headTitle("/guide/language/errors", locale.isChinese())}
            description={locale.text("What a caught value is guaranteed to be, the eight classes VelarScript publishes, the try expression, assertions that survive the build, and what the compiler's own diagnostics do for you.", "捕获到的东西一定是什么、VelarScript 发布的八个错误类、try 表达式、构建剥不掉的断言，以及编译器自己的诊断替你做了多少事。")}
            themeColor="#f7f5f0"
        />
        <DocsShell items={guideNav}>
            <PageHeader
                kicker={locale.text("Language / 10", "语言 / 10")}
                title={locale.text("Errors and assertions", "错误与断言")}
                summary={locale.text("try, catch, finally, the classes the compiler raises, the failure that is an answer rather than an incident, assertions that stay in production, and the diagnostics that arrive before any of it.", "try、catch、finally；编译器抛出的那几个类；不算事故、只算答案的那种失败；在生产里照样生效的断言；以及比这一切都先到的诊断。")}
            />
            <SectionList items={sections} />
            <Prose>
                <SectionHeading id="blocks">{locale.text("try, catch, finally", "try、catch、finally")}</SectionHeading>
                <Paragraph>
                    {locale.text("Here is a line from a retry helper, and the handler that was supposed to read it.", "先看一行重试逻辑，和本该读懂它的那个处理器。")}
                </Paragraph>
                <CodeBlock code={throwJsCode} />
                <Paragraph>
                    {locale.text("The log says undefined. Not the reason, not a stack — undefined, on the one failure you were trying to diagnose. A JavaScript catch binds whatever was thrown, and a string has no message. Somebody threw text three years ago; the bill arrives today, addressed to a person who has never opened that file.", "日志上是 undefined。不是原因，也不是堆栈，就是 undefined——偏偏出现在你正要查的那次失败上。JavaScript 的 catch 绑定的是「被抛出的那个东西」，而字符串没有 message。三年前有人抛了一段文本，账单今天到，收件人是一个从没打开过那个文件的人。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("Only an Error can be thrown here, so the binding after catch always has the same five members.", "在这里只有 Error 能被抛出，所以 catch 之后拿到的绑定，永远带着同样的五个成员。")}
                </Paragraph>
                <CodeBlock code={blocksCode} />
                <Paragraph>
                    {locale.text("catch binds the error and finally runs on every path out of the block. Either clause may stand without the other, so cleanup with no recovery needs no empty catch. finally stays cleanup rather than a control-flow override: a loop written wholly inside one keeps its own break and continue. And the throw rule is what buys the line after catch — message, name, code, stack, and cause are there because nothing else could have arrived.", "catch 绑定错误，finally 在离开这个块的每条路径上都会执行。两个子句谁都可以单独出现，所以「只清理、不恢复」不必写一个空的 catch。finally 始终是清理，不是控制流的覆盖：完全写在它里面的循环，仍然用自己的 break 和 continue。而 catch 后面那一行之所以敢那么写，靠的是「只能抛 Error」这条规则——message、name、code、stack、cause 一定都在，因为别的东西根本进不来。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("The cost is a declaration. JavaScript let you signal a new kind of failure inline, with an object literal thrown mid-function; here that same idea is a class extends Error with a constructor, written somewhere a reader can find it. For a failure you raise once, in one branch, that is real overhead and you will feel it.", "代价是一次声明。在 JavaScript 里，你想表示一种新的失败，函数写到一半抛个对象字面量就行；在这里，同一个想法要写成一个 class extends Error，带构造函数，放在读者找得到的地方。如果这种失败你一共只抛一次、只在一个分支里抛，这笔开销是实打实的，你会感觉到。")}
                </Paragraph>
                <Subheading>{locale.text("What the compiler refuses", "编译器拒绝的写法")}</Subheading>
                <CodeBlock code={textErrorCode} />
                <CodeBlock code={textErrorOutput} />
                <GateNote>
                    {locale.text("Gate: a checked counter-example. This site's build compiles the sample and fails if it ever stops producing a diagnostic, and it verifies that VEL4001 is a code the sample really produces — so this rule cannot quietly relax without the page failing to build.", "门禁：受检的教学反例。本站构建会编译这个样本，一旦它不再报错就让构建失败；并且会核对 VEL4001 确实由这个样本产生。所以这条规则要是悄悄松了，这一页就构建不过。")}
                </GateNote>

                <SectionHeading id="classes">{locale.text("The published classes", "已发布的错误类")}</SectionHeading>
                <Paragraph>
                    {locale.text("This is how a Node program asks whether a file was missing.", "在 Node 里，判断「文件是不是不存在」，写出来是这样。")}
                </Paragraph>
                <CodeBlock code={enoentJsCode} />
                <Paragraph>
                    {locale.text("A magic string, compared against a value nothing checks. Type ENOTENT and the branch is dead forever: no crash, no warning, just a settings file that never gets created and a first run that fails for a reason nobody can reproduce. The comparison is also doing double duty here — a syntax error in the file lands in the same catch and takes the ENOENT branch's else, which is the correct behavior only by accident.", "一个魔法字符串，跟一个没人校验的值比。把 ENOENT 敲成 ENOTENT，这个分支就永远死了：不崩溃，不警告，只是配置文件再也建不出来，首次运行失败，而失败的原因谁都复现不了。这里的比较还身兼两职——文件里有语法错误时，也落进同一个 catch，走的是 ENOENT 分支的 else 路径；那个行为是对的，纯属巧合。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("Eight classes are published, and a branch tests the class rather than a string.", "已发布的类一共八个。分支检验的是类，不是字符串。")}
                </Paragraph>
                <CodeBlock code={raisedCode} />
                <CodeBlock code={capabilityCode} />
                <Paragraph>
                    {locale.text("Three of them are raised by the compiler's own checks — a failed validation, a stale flow fact, an out-of-range position. Five more describe capability failures a program can recover from, and each carries the detail its site can report. All eight are reserved Core bindings, so recovery needs no import, and nothing you declare can shadow one.", "其中三个由编译器自身的检查抛出：验证失败、过期的流事实、越界的位置。另外五个描述程序可以从中恢复的能力失败，每一个都带着它发生的地方能报出来的细节。八个全是保留的 Core 绑定，所以恢复代码不用导入，你声明的东西也遮不住它们。")}
                </Paragraph>
                <BulletList>
                    <li>
                        {locale.text("Discrimination is the class, tested with is. code is the same identity written as text, for a boundary a class cannot travel across.", "判别的依据是类，用 is 检验。code 是同一个身份写成文本，供类过不去的那种边界使用。")}
                    </li>
                    <li>
                        {locale.text("The two always agree, so a log line and a branch never disagree about what failed.", "两者永远一致，所以日志那一行和分支那一行，不会对「到底哪里失败了」给出两个答案。")}
                    </li>
                </BulletList>
                <Paragraph>
                    {locale.text("Three things are given up for that. The set is closed, so a capability failure the language has not named arrives as an ordinary Error and you are back to reading message. Eight names are permanently spent — none of them can be a type of yours. And the hierarchy stops at the JavaScript boundary: a class thrown by a package does not join it, so is cannot discriminate a foreign TypeError even though its name survives.", "为此放弃了三样东西。第一，这套集合是封闭的，语言没有命名过的能力失败会以普通 Error 的身份到达，你又回去读 message 了。第二，八个名字被永久占用，你的类型不能叫这些名字。第三，这套层级到 JavaScript 边界就停了：包里抛出的类不会加入进来，所以哪怕 name 还在，is 也认不出一个外来的 TypeError。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("The edge of the hierarchy is worth seeing rather than taking on trust. This program asks JavaScript to throw four things, three of which are not Errors at all.", "层级的边界，与其信，不如看一眼。下面这个程序让 JavaScript 抛四样东西，其中三样根本不是 Error。")}
                </Paragraph>
                <CodeBlock code={foreignNodeCode} />
                <CodeBlock code={foreignRunTextCode} />
                <GateNote>
                    {locale.text("Gate: this site's build compiles the sample above in a Node project on every build, so the program is at least a real program. The output beside it is a quotation from one run on toolchain 0.10.0, not an artifact this site compares — run it yourself and read line four, where name survives the crossing and code does not.", "门禁：本站每次构建都会在一个 Node 项目里编译上面这个样本，所以它至少是一个真程序。旁边的输出是 0.10.0 工具链上一次真实运行的摘录，不是本站逐字比对的产物——自己跑一遍，重点看第四行：name 过了边界，code 没过。")}
                </GateNote>

                <SectionHeading id="custom">{locale.text("Your own error classes", "你自己的错误类")}</SectionHeading>
                <Paragraph>
                    {locale.text("Every JavaScript codebase has this class, and one place that forgot the fifth line.", "每个 JavaScript 代码库里都有这么一个类，也总有一处漏了第五行。")}
                </Paragraph>
                <CodeBlock code={subclassJsCode} />
                <Paragraph>
                    {locale.text("Drop this.name and the class still works, still extends Error, still passes instanceof. It just tells the logs it is an Error. Six months later somebody greps the dashboard for TimeoutError, finds nothing, and concludes the timeouts stopped.", "把 this.name 那行删掉，这个类照样能用，照样继承 Error，instanceof 照样过。它只是在日志里自称 Error 而已。半年后有人在看板上搜 TimeoutError，一条都搜不到，于是得出结论：超时没有了。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("Here the name comes from the declaration.", "在这里，名字来自声明本身。")}
                </Paragraph>
                <CodeBlock code={customCode} />
                <Paragraph>
                    {locale.text("A subclass answers under its declared name with no line to remember, and a type test narrows to the fields that subclass adds, so recovery reads the detail without a cast. The same identity is what code answers, which is how the branch and the JSON that leaves your process stay in step.", "子类以自己声明的名字回答，不需要你记得写哪一行；类型检验会收窄到该子类新增的字段上，所以恢复代码不用强制转换就能读到细节。code 给出的是同一个身份——分支和离开进程的那份 JSON，因此才对得上。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("Which is also the bill. Your class name is a wire value. Rename TimeoutError to RequestTimeoutError for the sake of a clearer module and every consumer matching on that code stops matching, with no compiler on their side to notice — the rename reads local and is not. Treat an error class name the way you treat a JSON field name, and rename it on the same schedule.", "这也正是账单所在。你的类名会随数据一起发出去。为了模块读起来更清楚，把 TimeoutError 改叫 RequestTimeoutError，所有靠这个 code 做匹配的消费方就都匹配不上了，而他们那边没有编译器会替他们发现——这次改名看着是局部的，其实不是。把错误类名当成 JSON 字段名来对待，改它的时候按同一套节奏来。")}
                </Paragraph>
                <CodeBlock code={wireNodeCode} />
                <CodeBlock code={wireRunTextCode} />
                <GateNote>
                    {locale.text("Gate: the sample above is compiled in a Node project on every build of this site. The three lines beside it are a quotation from one run on toolchain 0.10.0 rather than a compared artifact — note that a class you declared and a class the compiler raises answer the same way.", "门禁：上面这个样本，本站每次构建都会在 Node 项目里编译一遍。旁边那三行是 0.10.0 工具链上一次真实运行的摘录，不是逐字比对的产物——注意看：你自己声明的类和编译器抛出的类，回答方式完全一样。")}
                </GateNote>

                <SectionHeading id="expression">{locale.text("When failure is an answer", "把失败当成答案")}</SectionHeading>
                <Paragraph>
                    {locale.text("Sometimes a failure is not an incident. Reading a settings file that may not parse yet is an ordinary question with an ordinary fallback, and in JavaScript it costs this.", "有些失败不是事故。读一个可能还解析不了的配置文件，这是个普通问题，也有普通的回退方案；在 JavaScript 里，它要花这么多行。")}
                </Paragraph>
                <CodeBlock code={parseJsCode} />
                <Paragraph>
                    {locale.text("A mutable binding that exists only because the block needs somewhere to write, and a bare catch that also swallows the typo you made on the line above it.", "一个可变绑定，存在的唯一理由是那个块总得有个地方写结果；再加一个空的 catch，顺便把你上一行敲错的那个变量名也一起吞了。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("A try expression turns that failure into an optional, so a caller with a fallback never opens a block.", "try 表达式把这样的失败变成可选值，本来就有回退方案的调用方，从头到尾不必开一个块。")}
                </Paragraph>
                <CodeBlock code={expressionCode} />
                <Paragraph>
                    {locale.text("It reaches exactly as far as await does — over the whole postfix chain — and its result must be consumed, which is what keeps a swallowed failure from being invisible. Absence is the answer, and ?? is where the fallback goes.", "它的作用范围与 await 完全一致——覆盖整条后缀链——并且它的结果必须被消费，被吞掉的失败因此不会变得看不见。答案就是「没有」，回退方案写在 ?? 后面。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("You pay for that in resolution. Every failure inside the reach of one try collapses into the same absent answer: a malformed file and a permission error come back identical, and reaching over a chain hides a failure in the middle of it just as willingly as one at the end. When the reason matters — when the recovery for a missing file is not the recovery for a corrupt one — the block is not the clumsy option, it is the correct one.", "这笔钱付在分辨率上。一个 try 覆盖范围内的所有失败，都塌缩成同一个「没有」：文件格式坏了和权限不足，回来长得一模一样；而它跨过一整条链时，链中间的失败和链末尾的失败一样会被藏起来。当原因本身要紧的时候——「文件不存在」和「文件损坏」需要不同的恢复方式——那个块就不是笨办法，而是正确答案。")}
                </Paragraph>
                <Subheading>{locale.text("What the compiler refuses", "编译器拒绝的写法")}</Subheading>
                <CodeBlock code={bareErrorCode} />
                <CodeBlock code={bareErrorOutput} />
                <GateNote>
                    {locale.text("Gate: a checked counter-example, held to the same rule — the sample is compiled on every build and VEL4034 is checked against the diagnostics it really produces. Read what the message does: it names all three ways to consume the result, and names the block for the case where ignoring the failure is the point.", "门禁：同样是受检的教学反例——每次构建都编译这个样本，并核对 VEL4034 确实出现在它真实产生的诊断里。留意这条消息在做什么：它把消费结果的三种方式全说了出来，也点名了「就是要忽略这次失败」时该用的那个块。")}
                </GateNote>

                <SectionHeading id="assertions">
                    {locale.text("Assertions the build cannot strip", "构建剥不掉的断言")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("One line, from a billing module.", "一行代码，来自一个计费模块。")}
                </Paragraph>
                <CodeBlock code={assertJsCode} />
                <Paragraph>
                    {locale.text("It prints a red line and carries on. In a browser nobody is watching, and in a Node process the line goes to a log that rotates hourly, so the invariant that failed on a customer's data is a message nobody reads followed by a negative total that everything downstream treats as real. Languages that do strip assertions have the same shape of problem from the other side: the check runs only where the corruption never happens.", "它打一行红字，然后接着往下跑。浏览器里没人看着，Node 进程里那行进了一个按小时轮转的日志。于是「某个客户的数据把不变量打破了」这件事，变成一条没人读的消息，后面跟着一个负数总额，而下游的一切都把它当真的用。那些真会剥掉断言的语言，问题的形状是一样的，只是从另一头来：检查只在从来不出事的地方跑。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("Nothing strips an assertion from a VelarScript build.", "VelarScript 的构建不会剥掉任何一条断言。")}
                </Paragraph>
                <CodeBlock code={assertionsNodeCode} />
                <Paragraph>
                    {locale.text("An assertion states an invariant the program depends on, and it stays active where the program actually runs. That is why it carries a message: the message is what a person reads when the invariant turns out to be false in a live system. A successful assertion also narrows, so the line after it may use what it settled — the return above reads config.retries with no second null test.", "断言陈述的是程序依赖的一个不变量，而且它在程序真正运行的地方依然生效。它带一条消息就是为了这个：当这个不变量在活着的系统里被证伪时，人读到的就是这句话。成功的断言还会收窄，所以它下面那一行可以直接用它定下来的事实——上面那个 return 读 config.retries，没有再做一次 null 判断。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("Two prices. The check runs on every call for the life of the program, so an assertion inside a hot loop is a comparison you are paying for a billion times. And a failed assertion takes down the request that hit it; a build that stripped assertions would have limped on and served something slightly wrong instead. Whether that trade is right is a judgment about your product, not about the language — and it is the reason a condition not worth checking in production should not be written as an assertion at all.", "两笔钱。其一，这个检查在程序活着的每一次调用里都跑，所以热循环里的一条断言，是一次要付十亿遍的比较。其二，断言一旦失败，撞上它的那个请求就没了；换成会剥掉断言的构建，程序会瘸着腿继续跑，交出一个稍微不对的结果。这笔账划不划算，取决于你的产品，不取决于语言——也正因如此，在生产里都不值得检查的条件，一开始就不该写成断言。")}
                </Paragraph>
                <CodeBlock code={assertionRunTextCode} />
                <GateNote>
                    {locale.text("Gate: the sample above is compiled in a Node project on every build of this site. The block beside it is an excerpt of one velar run on toolchain 0.10.0 — the stack frames under the caret are trimmed for the page — so it is a quotation rather than an artifact this site compares. Notice the first line: 1000 was already printed. Assertions do not run early.", "门禁：上面这个样本，本站每次构建都会在 Node 项目里编译。旁边那一块是 0.10.0 工具链上一次 velar run 的摘录——插入符下面的堆栈帧为了排版被截掉了——所以它是引文，不是本站逐字比对的产物。注意第一行：1000 已经打出来了。断言不会提前跑。")}
                </GateNote>
                <Callout title={locale.text("An assertion is not a development-only check", "断言不是只在开发期生效的检查")}>
                    <Paragraph>
                        {locale.text("There is no flag that removes them and no build mode that skips them. A condition worth asserting is worth checking where the program actually runs, and a condition not worth checking there should not be written as an assertion in the first place.", "没有哪个开关能去掉它们，也没有哪种构建模式会跳过它们。值得断言的条件，也值得在程序真正运行的地方被检查；在那里都不值得检查的条件，一开始就不该写成断言。")}
                    </Paragraph>
                </Callout>

                <SectionHeading id="diagnostics">
                    {locale.text("The failure that arrives first", "最先到的那次失败")}
                </SectionHeading>
                <Paragraph>
                    {locale.text("Everything above is a failure your program handles. There is one more kind, and it arrives before the program runs at all.", "上面讲的都是你的程序要处理的失败。还有一种，在程序开跑之前就到了。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("The usual shape of it: a compiler says type mismatch, you read it twice, and then you spend twenty minutes in documentation to learn that the word you wanted was somewhere else entirely. A model in the same position does something worse — it invents a workaround that compiles, and you inherit it. Here is a module with two mistakes in it, both of the kind a person carries in from another language.", "它通常长这样：编译器说「类型不匹配」，你读了两遍，然后花二十分钟翻文档，才知道你要的那个词根本在另一个地方。模型碰上同样的情况，做的事更糟——它造出一个能编译的绕法，然后由你接手。下面这个模块里有两个错，都是从别的语言带过来的那种。")}
                </Paragraph>
                <CodeBlock code={fixableErrorCode} />
                <CodeBlock code={fixableErrorOutput} />
                <Paragraph>
                    {locale.text("Each diagnostic names the spelling that replaces it, so neither one needs a search. And because the compiler already knows the answer, it can write it.", "每条诊断都点出了替代它的那种拼写，所以两条都不用去搜。而既然编译器已经知道答案，它就可以直接写下来。")}
                </Paragraph>
                <CodeBlock code={fixShellCode} />
                <CodeBlock code={fixRunTextCode} />
                <Paragraph>
                    {locale.text("velar fix applies the rewrites it can prove equivalent — retired spellings with one named successor, line-ending semicolons, and the rest of that family — and reports whatever is left. It is safe to run unattended because of what it refuses: a second run applies nothing, and anything that needs a decision stays a diagnostic addressed to you. The truthiness rule is the clearest case. Write if account: against an Account? and the message names account != null, and fix still leaves the line alone, because changing what a condition tests is a decision about the program rather than a rewrite of its spelling.", "velar fix 会应用那些它能证明等价的改写——只有一个指定后继者的退役拼写、行尾分号，以及同一族的其他情况——然后把剩下的报给你。它敢无人值守地跑，靠的是它拒绝做的那些事：再跑一次什么都不改；凡是需要做决定的，都作为诊断留给你。最清楚的例子是条件那条规则。对一个 Account? 写 if account:，消息里会点名 account != null，而 fix 依然不动那一行——改变一个条件在检验什么，是关于程序的决定，不是拼写的改写。")}
                </Paragraph>
                <Paragraph>
                    {locale.text("Two costs, and the first one is the kind you find out about the hard way. fix edits your files in place: no diff, no confirmation, no backup. Run it on work that is not committed and you have no way back to what you had. The second is the shape of the boundary. Because the rule is provable equivalence rather than best guess, most of the diagnostics you actually meet are outside it — the mechanical family is real and it is narrow, and the rest of the walls are yours to answer.", "两个代价，第一个属于那种「吃过亏才知道」的。fix 直接改你的文件：没有 diff，没有确认，没有备份。在没提交的工作上跑它，你就回不去了。第二个是这条边界的形状。既然规则是「可证明等价」而不是「最佳猜测」，那你实际撞到的大多数诊断都在它之外——机械改写这一族是真的存在，但它很窄，剩下的墙都得你自己回答。")}
                </Paragraph>
                <GateNote>
                    {locale.text("Gate: the two-mistake module above is a checked counter-example — compiled on every build, and VEL3008 and VEL1005 are both checked against the diagnostics it really produces. The velar fix block beside it is a quotation from one run on toolchain 0.10.0 rather than a compared artifact; a second run in the same project answers \"applied 0 mechanical fixes; 0 diagnostics remain\".", "门禁：上面那个带两个错的模块是受检的教学反例——每次构建都编译，VEL3008 与 VEL1005 都会与它真实产生的诊断核对。旁边的 velar fix 那一块是 0.10.0 工具链上一次运行的引文，不是逐字比对的产物；在同一个项目里再跑一次，回答是「applied 0 mechanical fixes; 0 diagnostics remain」。")}
                </GateNote>
                <Paragraph>
                    {locale.text("A diagnostic that names nothing you can act on is a defect here rather than a matter of taste.", "一条说不出「那你该写什么」的诊断，在这里算缺陷，不算风格问题。")} <Link
                        to="/participate"
                        look={inlineLinkLook}
                    >
                        {locale.text("Send us the one that stopped you.", "把拦住你的那一条寄给我们。")}
                    </Link>
                </Paragraph>
            </Prose>
            <DocsPager previous={guidePrevious("/guide/language/errors")} next={guideNext("/guide/language/errors")} />
        </DocsShell>
    </main>
