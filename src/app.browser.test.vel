import {browser} from "velar/web-test"
import {expect} from "velar/test"

test "the home page renders its definition and its compiled sample":
    await browser.open("/")
    await browser.waitFor("[data-home-definition]")
    expect(await browser.text("[data-home-definition] h1")).toBe("VelarScript")
    await browser.waitFor("[data-home-sample] figure")

test "the header brand draws the language mark in currentColor":
    await browser.open("/")
    await browser.waitFor(".brand .brand-mark")
    expect(await browser.namespace(".brand .brand-mark")).toBe("http://www.w3.org/2000/svg")
    expect(await browser.attribute(".brand .brand-mark", "viewBox")).toBe("85 113 346 290")
    expect(await browser.attribute(".brand .brand-mark", "aria-hidden")).toBe("true")
    expect(await browser.attribute(".brand .brand-mark g", "fill")).toBe("currentColor")
    expect(await browser.count(".brand .brand-mark path")).toBe(3)
    expect(await browser.count(".brand img")).toBe(0)

test "the primary navigation moves between pages as a route change":
    await browser.open("/")
    await browser.click(".primary-nav a:first-of-type")
    await browser.waitFor("[data-why]")
    expect(await browser.currentPath()).toBe("/why")
    await browser.click(".primary-nav a:nth-of-type(2)")
    await browser.waitFor(".docs")
    expect(await browser.currentPath()).toBe("/guide")

test "the guide shell lists all three sidebar groups":
    await browser.open("/guide")
    await browser.waitFor(".docs")
    expect(await browser.count(".nav-group")).toBe(6)
    expect(await browser.count(".velar-docs-prose") >= 1).toBeTruthy()

test "the language switch flips the navigation and flips it back":
    await browser.open("/guide")
    await browser.waitFor(".primary-nav")
    const before = await browser.text(".primary-nav a:first-of-type")
    await browser.click(".language-switch")
    const flipped = before == "Why" ? "为什么" : "Why"
    await browser.waitForText(".primary-nav a:first-of-type", flipped)
    await browser.click(".language-switch")
    await browser.waitForText(".primary-nav a:first-of-type", before)

// The switch used to reach the page body and stop there. The sidebar labels and
// the "On this page" label were chosen by a `const` in setup, so they held
// whichever language the page first loaded in — an English reader got a Chinese
// sidebar. The test above passed the whole time, because it only ever looked at
// .primary-nav, so this one looks at the two surfaces that were wrong.
test "the language switch reaches the sidebar and the section list too":
    await browser.open("/guide/language/values")
    await browser.waitFor(".velar-docs-sections")
    const sidebarBefore = await browser.text(".desktop-docs-nav .nav-group:first-child .nav-label")
    const sectionsBefore = await browser.text(".velar-docs-sections span")
    const sidebarFlipped = sidebarBefore == "Start" ? "开始" : "Start"
    const sectionsFlipped = sectionsBefore == "On this page" ? "本页内容" : "On this page"

    await browser.click(".language-switch")
    await browser.waitForText(".desktop-docs-nav .nav-group:first-child .nav-label", sidebarFlipped)
    await browser.waitForText(".velar-docs-sections span", sectionsFlipped)

    await browser.click(".language-switch")
    await browser.waitForText(".desktop-docs-nav .nav-group:first-child .nav-label", sidebarBefore)
    await browser.waitForText(".velar-docs-sections span", sectionsBefore)

test "a language chapter carries its sections, its samples, and its pager":
    await browser.open("/guide/language/values")
    await browser.waitFor(".velar-docs-sections")
    expect(await browser.count(".velar-docs-prose pre") >= 3).toBeTruthy()
    await browser.waitFor(".velar-docs-pager")

// D66 ruling 2: Prose owns the vertical rhythm, so every block a chapter lays
// out has to come from the docs-kit vocabulary. A page that writes its own <p>,
// <h2> or <ul look={...}> is back to spelling spacing forty times, and that is
// what these two tests refuse. The class is the observable: the browser test
// surface reads nodes rather than computed style, so the gap itself cannot be
// asserted from here.
test "every block a chapter lays out comes from the prose vocabulary":
    // /examples and /evidence are in this list because the rule is site-wide, not
    // chapter-wide. /examples is also the one page that lays out a deliberate
    // non-prose structure inside Prose — a grid of example cards — so the list
    // assertion excludes it by class rather than by leaving the page unchecked.
    for path in ["/why", "/guide", "/guide/quick-start", "/guide/for-javascript", "/guide/language/operators", "/guide/web/templates", "/reference/cli", "/guide/for-frameworks", "/examples", "/evidence"]:
        await browser.open(path)
        await browser.waitFor(".velar-docs-prose")
        expect(await browser.count(".velar-docs-prose > p:not(.velar-docs-paragraph)")).toBe(0)
        expect(await browser.count(".velar-docs-prose > h2:not(.velar-docs-heading)")).toBe(0)
        expect(await browser.count(".velar-docs-prose > h3:not(.velar-docs-subheading)")).toBe(0)
        expect(await browser.count(".velar-docs-prose > ul:not(.velar-docs-points):not(.velar-docs-cards)")).toBe(0)
        expect(await browser.count(".velar-docs-prose > .velar-docs-paragraph") >= 5).toBeTruthy()
        expect(await browser.count(".velar-docs-prose > .velar-docs-heading") >= 4).toBeTruthy()

test "a chapter's bullet points are the owned list, not a list the page invented":
    await browser.open("/guide/language/values")
    await browser.waitFor(".velar-docs-prose")
    expect(await browser.count(".velar-docs-prose > .velar-docs-points")).toBe(5)
    expect(await browser.count(".velar-docs-prose > ul:not(.velar-docs-points)")).toBe(0)

// D78 ruling 197: the positioning is answered in eight questions, in one fixed
// order, and the eighth — what the language refuses to promise — is the one a
// page like this loses first, because it is the only one that costs something
// to publish. So the eight ids are pinned by name rather than counted, and the
// refusals section is asserted on its own.
test "the why page answers all eight questions, refusals included":
    await browser.open("/why")
    await browser.waitFor(".velar-docs-prose")
    for id in ["#for", "#problem", "#now", "#tenets", "#choose", "#good", "#promises", "#refuses"]:
        expect(await browser.count(id)).toBe(1)
    expect(await browser.count(".velar-docs-prose > .velar-docs-heading")).toBe(8)
    expect(await browser.count(".velar-docs-prose > .velar-docs-gate-note")).toBe(1)
    expect(await browser.text("#refuses")).toBe("What it does not promise")

// D66 ruling 5B: the built-in AI skill brief is half of "models write, people
// own", and before this it appeared on the whole site twice, both times as a
// bare line in a command list. A visitor could not tell it existed. The section
// is the deliverable, so its absence has to fail rather than merely read worse.
// The gate notes are counted with it because ruling 5's fifth step is evidence:
// a section that quietly loses the note naming its gate is back to asserting
// things nobody checks.
test "the introduction gives the built-in skill brief a section of its own":
    await browser.open("/guide")
    await browser.waitFor(".velar-docs-prose")
    expect(await browser.count("#skill")).toBe(1)
    expect(await browser.count(".velar-docs-prose > .velar-docs-heading")).toBe(6)
    expect(await browser.count(".velar-docs-prose > .velar-docs-gate-note")).toBe(3)

// D66 ruling 5A: every Web chapter is written to the same skeleton, and the
// fifth step of it is evidence. A chapter that loses the note naming its gate
// is back to asserting things nobody checks, so the note's presence is what
// this loop refuses to lose — together with the vocabulary rule from ruling 2,
// which these thirteen pages were rewritten under.
test "every Web chapter keeps the owned vocabulary and names at least one gate":
    for path in ["/guide/web", "/guide/web/components", "/guide/web/templates", "/guide/web/state", "/guide/web/resources", "/guide/web/lifecycle", "/guide/web/look", "/guide/web/motion", "/guide/web/beyond-look", "/guide/web/routing", "/guide/web/browser", "/guide/web/data", "/guide/web/testing"]:
        await browser.open(path)
        await browser.waitFor(".velar-docs-prose")
        expect(await browser.count(".velar-docs-prose > p:not(.velar-docs-paragraph)")).toBe(0)
        expect(await browser.count(".velar-docs-prose > h2:not(.velar-docs-heading)")).toBe(0)
        expect(await browser.count(".velar-docs-prose > ul:not(.velar-docs-points)")).toBe(0)
        expect(await browser.count(".velar-docs-prose > .velar-docs-heading") >= 4).toBeTruthy()
        expect(await browser.count(".velar-docs-prose > .velar-docs-gate-note") >= 1).toBeTruthy()

// D66 ruling 5B item 4: the test seams the Web extension owns — tick(), an
// action's own pending flag, and a subscription's own stop function — lived
// only on the framework-comparison page, and left the site when that page was
// rewritten. The testing chapter is where they belong, so the section's absence
// has to fail rather than merely read worse.
test "the testing chapter carries the seams the extension owns":
    await browser.open("/guide/web/testing")
    await browser.waitFor(".velar-docs-prose")
    expect(await browser.count("#seams")).toBe(1)
    expect(await browser.count("#warnings")).toBe(1)
    expect(await browser.count(".velar-docs-prose > .velar-docs-heading")).toBe(5)
    expect(await browser.count(".velar-docs-prose > .velar-docs-gate-note")).toBe(2)

// The tracking trap is the sharpest teaching case for how reads are subscribed,
// and it was a live bug in this site's own sidebar before it was a chapter
// section. It opens the state chapter for that reason, so its id is pinned.
test "the state chapter opens on where the read happens":
    await browser.open("/guide/web/state")
    await browser.waitFor(".velar-docs-prose")
    expect(await browser.count("#tracking")).toBe(1)
    expect(await browser.text(".velar-docs-prose > .velar-docs-heading:first-of-type")).toBe("Where the read happens")

test "the reference CLI page renders its command tables":
    await browser.open("/reference/cli")
    await browser.waitFor(".docs")
    expect(await browser.count(".velar-docs-members table") >= 1).toBeTruthy()

test "an unknown route answers the not-found page":
    await browser.open("/this/page/does/not/exist")
    await browser.waitFor("[data-not-found]")
