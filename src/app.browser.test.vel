import {expect} from "velar/test"
import {browser} from "velar/web-test"

async def test_home_explains_the_product_and_uses_framework_navigation():
    await browser.open("/")
    expect(await browser.attribute('a[href="#main-content"]', "href")).toBe("#main-content")
    expect(await browser.count('#main-content[tabindex="-1"]')).toBe(1)
    expect(await browser.text(".brand-name")).toBe("VelarScript")
    expect(await browser.text("[data-home-hero] h1")).toContain("The Web")
    expect(await browser.text("[data-home-hero]")).toContain("Language + Web framework")
    expect(await browser.attribute('nav a[href="/learn"]', "aria-current")).toBe(none)
    await browser.click('nav a[href="/learn"]')
    await browser.waitForText("h1", "Readable from the first line.")
    expect(await browser.currentPath()).toBe("/learn")
    expect(await browser.attribute('nav a[href="/learn"]', "aria-current")).toBe("page")
    expect(await browser.text("[data-package-workflow]")).toContain("velar add")

async def test_documentation_routes_and_active_navigation():
    await browser.open("/docs")
    await browser.waitForText("h1", "Learn the whole stack, from first value to verified deployment.")
    expect(await browser.text(".velar-docs-callout")).toContain("Language and framework are separate")
    expect(await browser.text("[data-docs-page]")).toContain("@velarscript/ui")
    expect(await browser.attribute('[aria-label="Primary navigation"] a[href="/docs"]', "aria-current")).toBe("page")
    await browser.click('[aria-label="Documentation sections"] a[href="/docs/getting-started"]')
    await browser.waitForText("h1", "From an empty folder to a real Web app.")
    expect(await browser.text("[data-getting-started]")).toContain("npm create velar@latest")
    await browser.click('[aria-label="Documentation sections"] a[href="/docs/web"]')
    await browser.waitForText("h1", "One official path from component to production.")
    expect(await browser.currentPath()).toBe("/docs/web")
    expect(await browser.text("[data-web-docs]")).toContain("velar/http")
    expect(await browser.visible("[data-disclosure-answer]")).toBe(false)
    await browser.press("[data-interaction-playground] summary", "Enter")
    expect(await browser.visible("[data-disclosure-answer]")).toBe(true)
    await browser.click('[data-interaction-playground] button:has-text("Inspect the dialog")')
    expect(await browser.visible("[data-interaction-playground] dialog")).toBe(true)
    const dialogTitleId = await browser.attribute("[data-interaction-playground] dialog", "aria-labelledby")
    expect(dialogTitleId != none).toBe(true)
    if dialogTitleId:
        expect(dialogTitleId).toContain("velar-dialog-title-")
    await browser.click('[data-interaction-playground] button:has-text("Return to the page")')
    expect(await browser.visible("[data-interaction-playground] dialog")).toBe(false)
    await browser.waitFor('[data-interaction-playground] button:has-text("Inspect the dialog"):focus')
    await browser.click('[data-interaction-playground] button:has-text("Inspect the dialog")')
    await browser.press('[data-interaction-playground] button:has-text("Return to the page")', "Escape")
    expect(await browser.visible("[data-interaction-playground] dialog")).toBe(false)
    await browser.waitFor('[data-interaction-playground] button:has-text("Inspect the dialog"):focus')
    const fieldId = await browser.attribute('[data-interaction-playground] input[name="name"]', "id")
    const labelTarget = await browser.attribute("[data-interaction-playground] [data-velar-ui-field] label", "for")
    const hintId = await browser.attribute('[data-interaction-playground] input[name="name"]', "aria-describedby")
    expect(fieldId).toBe(labelTarget)
    expect(hintId != none).toBe(true)
    await browser.click('[data-interaction-playground] button[type="submit"]')
    expect(await browser.attribute('[data-interaction-playground] input[name="name"]', "aria-invalid")).toBe("true")
    const errorDescription = await browser.attribute('[data-interaction-playground] input[name="name"]', "aria-describedby")
    expect(errorDescription != none).toBe(true)
    if hintId:
        if errorDescription:
            expect(errorDescription).toContain(hintId)
    await browser.waitFor('[data-interaction-playground] input[name="name"]:focus')
    await browser.fill('[data-interaction-playground] input[name="name"]', "Ada")
    await browser.click('[data-interaction-playground] button[type="submit"]')
    await browser.waitForText('[data-interaction-playground] [role="status"]', "Hello, Ada. This form stayed inside checked VelarScript APIs.")
    expect(await browser.attribute('[data-interaction-playground] input[name="name"]', "aria-invalid")).toBe(none)
    expect(await browser.attribute('[data-interaction-playground] input[name="name"]', "aria-describedby")).toBe(hintId)

async def test_examples_and_not_found_are_delivered_by_production_router():
    await browser.open("/examples")
    await browser.waitForText("h1", "Small programs, honest ideas.")
    expect(await browser.count("article.example")).toBe(3)
    await browser.open("/not-a-velar-page")
    await browser.waitForText("[data-not-found] h1", "Nothing is written here yet.")
    expect(await browser.text("[data-not-found] p")).toContain("/not-a-velar-page")

async def test_mobile_navigation_and_code_surfaces_remain_usable():
    await browser.viewport(390, 844)
    await browser.open("/")
    expect(await browser.visible('[aria-label="Primary navigation"]')).toBe(true)
    expect(await browser.visible("[data-home-hero] figure")).toBe(true)
    await browser.open("/docs")
    expect(await browser.visible(".docs aside .brand")).toBe(false)
    expect(await browser.visible(".mobile-docs-nav")).toBe(true)
    await browser.click(".mobile-docs-nav summary")
    expect(await browser.visible('[aria-label="Mobile documentation sections"]')).toBe(true)

async def test_detailed_reference_routes_are_delivered():
    await browser.open("/docs/language/types")
    await browser.waitForText("h1", "Useful types, not type-level programming.")
    expect(await browser.text("main")).toContain("User.parse")
    await browser.open("/docs/core")
    await browser.waitForText("h1", "Small explicit modules for everyday programs.")
    expect(await browser.text("[data-core-library]")).toContain("velar/collections")
    expect(await browser.text("[data-core-library]")).toContain("velar/log")
    await browser.open("/docs/web/data")
    await browser.waitForText("h1", "External data crosses checked boundaries.")
    expect(await browser.text("main")).toContain("velar/http")
    expect(await browser.text("main")).toContain("velar/storage")
    await browser.open("/docs/testing")
    await browser.waitForText("h1", "Test the source; verify the artifact users receive.")
    expect(await browser.text("[data-testing-docs]")).toContain("verify-deployment")
