import {clearErrors, focusFirstError, setError, textValue} from "velar/forms"
import {isBlank, trim} from "velar/text"
import {Disclosure, ModalDialog, Status, TextField} from "@velarscript/ui"

export component InteractionPlayground:
    let form: Element? = none
    state message = "Try the native interactions below."

    def submitExample():
        if form:
            clearErrors(form)
            const name = trim(textValue(form, "name"))
            if isBlank(name):
                setError(form, "name", "Enter a name to complete the example")
                focusFirstError(form)
                message = "The example needs one value."
            else:
                message = f"Hello, {name}. This form stayed inside checked Velar APIs."

    style:
        .playground {
            display: grid;
            gap: 18px;
            padding: 22px;
            border: 1px solid var(--velar-line);
            border-radius: var(--velar-radius-small);
            background: var(--velar-paper-pure);
        }

        .playground form {
            display: grid;
            gap: 14px;
        }

        .playground button {
            justify-self: start;
            padding: 9px 14px;
            border: 1px solid var(--velar-ink);
            border-radius: 999px;
            color: var(--velar-paper-pure);
            background: var(--velar-ink);
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .playground [role="status"] {
            margin: 0;
            color: var(--velar-ink-soft);
        }

    return <section class="playground" data-interaction-playground aria-label="Velar interaction primitives">
        <Disclosure summary="Why does Disclosure use details and summary?"><p data-disclosure-answer>Native disclosure behavior already owns keyboard activation and its open state. Velar styles and composes it instead of rebuilding browser semantics.</p></Disclosure>
        <ModalDialog title="A checked dialog boundary" triggerLabel="Inspect the dialog" closeLabel="Return to the page"><p>The component uses a typed DialogElement ref and explicit browser helpers. Closing it returns focus to the trigger.</p></ModalDialog>
        <form ref={form} on:submit.prevent={submitExample} novalidate>
            <TextField name="name" label="Your name" hint="Errors are owned by velar/forms and keep this hint relationship." autocomplete="name" placeholder="Ada" required={true} />
            <button type="submit">Run the form example</button>
        </form>
        <Status message={message} />
    </section>
