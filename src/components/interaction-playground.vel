import {clearErrors, focusFirstError, setError, textValue} from "velar/forms"
import {isBlank, trim} from "velar/text"
import {Disclosure, ModalDialog, Status, TextField} from "@velarscript/ui"
import {controlSurface, foundationInk as ink, foundationInkSoft as inkSoft, foundationPaperPure as paperPure, foundationRule as rule} from "@velarscript/site-ui"

const playgroundLook = look:
    display = grid
    gap = 18px
    padding = 22px
    border = line(1px, rule)
    radius = 9px
    background = paperPure

const formLook = look:
    display = grid
    gap = 14px

const buttonLook = look:
    ...controlSurface(radius: pill, padding: space(9px, 14px))
    justifySelf = start
    border = line(1px, ink)
    color = paperPure
    background = ink

const statusLook = look:
    margin = 0
    color = inkSoft

export component InteractionPlayground:
    let form: Element? = none
    state message = "Try the native interactions below."

    def submitExample():
        if form:
            clearErrors(form)
            const name = trim(textValue(form, "name"))
            if isBlank(name):
                setError(form, "name", "Enter a name to complete the example")
                focusFirstError(form)
                message = "The example needs one value."
            else:
                message = f"Hello, {name}. This form stayed inside checked VelarScript APIs."

    return <section class="playground" look={playgroundLook} data-interaction-playground aria-label="VelarScript interaction primitives">
        <Disclosure summary="Why does Disclosure use details and summary?"><p data-disclosure-answer>Native disclosure behavior already owns keyboard activation and its open state. VelarScript styles and composes it instead of rebuilding browser semantics.</p></Disclosure>
        <ModalDialog title="A checked dialog boundary" triggerLabel="Inspect the dialog" closeLabel="Return to the page"><p>The component uses a typed DialogElement ref and explicit browser helpers. Closing it returns focus to the trigger.</p></ModalDialog>
        <form look={formLook} ref={form} on:submit.prevent={submitExample} novalidate>
            <TextField name="name" label="Your name" hint="Errors are owned by velar/forms and keep this hint relationship." autocomplete="name" placeholder="Ada" required={true} />
            <button look={buttonLook} type="submit">Run the form example</button>
        </form>
        <Status message={message} look={statusLook} />
    </section>
