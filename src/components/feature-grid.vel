import {Feature} from "../content.vel"
import {enumerate} from "velar/collections"
import {foundationInkFaint as inkFaint, foundationInkSoft as inkSoft, foundationRule as rule, foundationSea as sea, useLocale} from "@velarscript/site-ui"

const gridLook = look:
    display = grid
    columns = repeat(3, minmax(0px, 1fr))
    borderTop = line(1px, rule)

    if viewport.width <= 850px:
        columns = tracks(1fr)

def featureLook(last: bool) -> Look:
    return look:
        display = grid
        alignContent = start
        gap = 18px
        minHeight = 390px
        padding = 30px
        borderRight = line(1px, rule)

        if last:
            borderRight = line(0px, transparent)

        if viewport.width <= 850px:
            minHeight = auto
            borderRight = line(0px, transparent)
            borderBottom = line(1px, rule)

            if last:
                borderBottom = line(0px, transparent)

const numberLook = look:
    color = sea
    font = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.76rem

const titleLook = look:
    maxWidth = 340px
    margin = 0
    fontSize = clamp(1.7rem, 3vw, 2.55rem)
    lineHeight = 1.06
    letterSpacing = -0.05em

const summaryLook = look:
    margin = 0
    color = inkSoft
    fontSize = 1rem
    lineHeight = 1.65

const detailLook = look:
    alignSelf = end
    margin = 0
    color = inkFaint
    fontSize = 0.85rem
    lineHeight = 1.6

export component FeatureGrid(features: List<Feature>):
    const locale = useLocale()
    const numbered = enumerate(features)
    return <div class="grid" look={gridLook}>{numbered.map(item => <article key={item.value.number} look={featureLook(item.index == features.length - 1)}><span class="number" look={numberLook}>{item.value.number}</span><h3 look={titleLook}>{locale.text(item.value.title, item.value.titleZh)}</h3><p class="summary" look={summaryLook}>{locale.text(item.value.summary, item.value.summaryZh)}</p><p class="detail" look={detailLook}>{locale.text(item.value.detail, item.value.detailZh)}</p></article>)}</div>
