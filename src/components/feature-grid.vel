import {Feature} from "../content.vel"

export component FeatureGrid(features: List<Feature>):
    style:
        .grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            border-top: 1px solid var(--velar-line-strong);
        }

        article {
            display: grid;
            align-content: start;
            gap: 18px;
            min-height: 390px;
            padding: 30px;
            border-right: 1px solid var(--velar-line);
        }

        article:last-child {
            border-right: 0;
        }

        .number {
            color: var(--velar-sea);
            font: 0.76rem "SFMono-Regular", Consolas, monospace;
        }

        h3, p {
            margin: 0;
        }

        h3 {
            max-width: 340px;
            font-size: clamp(1.7rem, 3vw, 2.55rem);
            line-height: 1.06;
            letter-spacing: -0.05em;
        }

        .summary {
            color: var(--velar-ink-soft);
            font-size: 1rem;
            line-height: 1.65;
        }

        .detail {
            align-self: end;
            color: var(--velar-ink-faint);
            font-size: 0.85rem;
            line-height: 1.6;
        }

        @media (max-width: 850px) {
            .grid {
                grid-template-columns: 1fr;
            }

            article {
                min-height: auto;
                border-right: 0;
                border-bottom: 1px solid var(--velar-line);
            }
        }

    return <div class="grid">{features.map(feature => <article key={feature.number}><span class="number">{feature.number}</span><h3>{feature.title}</h3><p class="summary">{feature.summary}</p><p class="detail">{feature.detail}</p></article>)}</div>
