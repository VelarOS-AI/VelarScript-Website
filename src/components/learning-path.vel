import {Link} from "velar/web"
import {foundationInk as ink, foundationInkSoft as inkSoft, foundationRule as rule, foundationSea as sea, useLocale} from "@velarscript/site-ui"
import {LearningStep} from "../content.vel"

const pathLook = look:
    display = grid
    borderBottom = line(1px, rule)

const stepLook = look:
    display = grid
    columns = tracks(72px, minmax(180px, 0.55fr), minmax(280px, 1fr), auto)
    alignItems = center
    gap = 24px
    paddingBlock = 24px
    borderTop = line(1px, rule)

    if viewport.width <= 760px:
        columns = tracks(44px, 1fr, auto)

const numberLook = look:
    color = sea
    font = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.76rem

const titleLook = look:
    margin = 0
    fontSize = clamp(1.25rem, 3vw, 2rem)
    letterSpacing = -0.04em

const summaryLook = look:
    margin = 0
    color = inkSoft
    lineHeight = 1.6

    if viewport.width <= 760px:
        gridColumn = "2 / -1"

const linkLook = look:
    color = ink
    fontWeight = 700
    textDecoration = undecorated

export component LearningPath(steps: List<LearningStep>):
    const locale = useLocale()
    return <div class="path" look={pathLook}>{steps.map(step => <article key={step.number} class="step" look={stepLook}><span class="number" look={numberLook}>{step.number}</span><h3 look={titleLook}>{locale.text(step.title, step.titleZh)}</h3><p look={summaryLook}>{locale.text(step.summary, step.summaryZh)}</p><Link to={step.path} look={linkLook}>{locale.text("Continue →", "继续 →")}</Link></article>)}</div>
