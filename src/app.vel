import {publicConfig} from "velar/config"
import {Head, RouteContext, Router, route} from "velar/web"
import {Container, SiteFoundation, foundationInkSoft as inkSoft, foundationSea as sea, useLocale} from "@velarscript/site-ui"
import {primaryNav, SiteRuntimeConfig} from "./content.vel"
import {SiteFooter, SiteHeader} from "./components/site-shell.vel"
import {DocsOverview} from "./pages/docs-overview.vel"
import {DocsGettingStarted} from "./pages/docs-getting-started.vel"
import {DocsProject} from "./pages/docs-project.vel"
import {Examples} from "./pages/examples.vel"
import {Home} from "./pages/home.vel"
import {CoreLibrary} from "./pages/core-library.vel"
import {LanguageClasses} from "./pages/language-classes.vel"
import {LanguageCollections} from "./pages/language-collections.vel"
import {LanguageDocs} from "./pages/language-docs.vel"
import {LanguageFunctions} from "./pages/language-functions.vel"
import {LanguageModules} from "./pages/language-modules.vel"
import {LanguageTypes} from "./pages/language-types.vel"
import {Learn} from "./pages/learn.vel"
import {TestingDeployment} from "./pages/testing-deployment.vel"
import {WebBrowser} from "./pages/web-browser.vel"
import {WebComponents} from "./pages/web-components.vel"
import {WebData} from "./pages/web-data.vel"
import {WebDocs} from "./pages/web-docs.vel"
import {WebReactivity} from "./pages/web-reactivity.vel"
import {WebRouting} from "./pages/web-routing.vel"

const config = publicConfig(SiteRuntimeConfig)

const missingLook = look:
    minHeight = 70vh
    paddingBlock = clamp(90px, 14vw, 180px)

const missingCodeLook = look:
    margin = 0
    color = sea
    font = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.76rem

const missingTitleLook = look:
    maxWidth = 900px
    margin = 0
    marginTop = 16px
    fontSize = clamp(4rem, 10vw, 9rem)
    lineHeight = 0.9
    letterSpacing = -0.07em

const missingMessageLook = look:
    margin = 0
    marginTop = 26px
    color = inkSoft
    fontSize = 1.1rem

component NotFound(route: RouteContext):
    const locale = useLocale()
    return <main class="missing" look={missingLook} data-not-found><Head title={locale.text("Page not found · VelarScript", "页面不存在 · VelarScript")} description={locale.text("The requested VelarScript documentation page does not exist.", "请求的 VelarScript 文档页面不存在。")} /><Container><span class="code" look={missingCodeLook}>404 / {locale.text("UNKNOWN ROUTE", "未知路由")}</span><h1 look={missingTitleLook}>{locale.text("Nothing is written here yet.", "这里还没有内容。")}</h1><p look={missingMessageLook}>{locale.text("No VelarScript page matches", "没有 VelarScript 页面匹配")} {route.path}.</p></Container></main>

const routes = [
    route("/", Home),
    route("/learn", Learn),
    route("/docs", DocsOverview),
    route("/docs/getting-started", DocsGettingStarted),
    route("/docs/project", DocsProject),
    route("/docs/language", LanguageDocs),
    route("/docs/language/types", LanguageTypes),
    route("/docs/language/functions", LanguageFunctions),
    route("/docs/language/collections", LanguageCollections),
    route("/docs/language/classes", LanguageClasses),
    route("/docs/language/modules", LanguageModules),
    route("/docs/web", WebDocs),
    route("/docs/web/components", WebComponents),
    route("/docs/web/reactivity", WebReactivity),
    route("/docs/web/routing", WebRouting),
    route("/docs/web/data", WebData),
    route("/docs/web/browser", WebBrowser),
    route("/docs/core", CoreLibrary),
    route("/docs/testing", TestingDeployment),
    route("/examples", Examples),
]

export component App:
    const locale = useLocale()
    return <SiteFoundation><Head title={locale.text("VelarScript — Write the Web clearly", "VelarScript — 清晰地书写 Web")} language={locale.languageTag()} /><SiteHeader items={primaryNav} repositoryUrl={config.repositoryUrl} version={config.languageVersion} /><div id="main-content" tabindex="-1"><Router routes={routes} fallback={NotFound} /></div><SiteFooter repositoryUrl={config.repositoryUrl} version={config.languageVersion} /></SiteFoundation>
