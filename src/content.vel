import {DocsNavGroup} from "@velarscript/docs-kit"

export type SiteRuntimeConfig:
    repositoryUrl: string
    releaseChannel: string
    languageVersion: string
    webApiVersion: string

export type NavItem:
    path: string
    label: string

export type Feature:
    number: string
    title: string
    summary: string
    detail: string

export type LearningStep:
    number: string
    title: string
    summary: string
    path: string

export type ExampleSummary:
    slug: string
    eyebrow: string
    title: string
    summary: string
    code: string
    traits: List<string>

export const primaryNav: List<NavItem> = [
    {path: "/learn", label: "Learn"},
    {path: "/docs", label: "Docs"},
    {path: "/examples", label: "Examples"},
]

