// Declared once, walked by DocsPager on every guide page.
export const guideOrder: List<DocsNavItem> = guideNav.flatMap(group => group.items)

export const referenceOrder: List<DocsNavItem> = referenceNav.flatMap(group => group.items)

export def guidePrevious(path: string) -> DocsNavItem?:
    let seen: DocsNavItem? = null
    for item in guideOrder:
        if item.path == path:
            return seen
        seen = item
    return null

export def guideNext(path: string) -> DocsNavItem?:
    let passed = false
    for item in guideOrder:
        if passed:
            return item
        if item.path == path:
            passed = true
    return null

export def pageTitle(path: string) -> PageTitle:
    for item in guideOrder:
        if item.path == path:
            return {en: item.label, zh: item.labelZh}
    for item in referenceOrder:
        if item.path == path:
            return {en: item.label, zh: item.labelZh}
    if path == "/":
        return {en: "VelarScript", zh: "VelarScript"}
    if path == "/examples":
        return {en: "Examples", zh: "示例"}
    if path == "/evidence":
        return {en: "Evidence", zh: "证据"}
    if path == "/participate":
        return {en: "Participate", zh: "参与"}
    return {en: "Page not found", zh: "页面不存在"}

// Every page head reads the same format, so no page spells the suffix itself.
// The home page is the one exception: its title is already the site name.
export def headTitle(path: string, chinese: bool) -> string:
    if path == "/":
        return "VelarScript"
    const title = pageTitle(path)
    return chinese ? f"{title.zh} · VelarScript" : f"{title.en} · VelarScript"
