import {DocsNavGroup, DocsNavItem} from "@velarscript/docs-kit"

export type SiteRuntimeConfig:
    repositoryUrl: string
    releaseChannel: string
    languageVersion: string
    webApiVersion: string

export type NavItem:
    path: string
    label: string
    labelZh: string

export type PageTitle:
    en: string
    zh: string

