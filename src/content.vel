export const features: List<Feature> = [
    {
        number: "01",
        title: "Familiar, without the baggage.",
        titleZh: "熟悉，但不背负历史包袱。",
        summary: "Keep JavaScript's runtime model. Replace its accidental complexity with one clear language surface.",
        summaryZh: "保留 JavaScript 的运行时模型，用一套清晰的语言表面替代偶然累积的复杂性。",
        detail: "let and const stay. Loose equality, implicit globals, prototype mutation, and ambient browser APIs do not.",
        detailZh: "保留 let 与 const；去掉宽松相等、隐式全局变量、原型修改和无边界的浏览器 API。",
    },
    {
        number: "02",
        title: "Useful types, not a second language.",
        titleZh: "有用的类型，而不是第二门语言。",
        summary: "Types document data boundaries and catch ordinary mistakes without turning application code into type gymnastics.",
        summaryZh: "类型用于说明数据边界并捕获常见错误，不把应用代码变成类型体操。",
        detail: "One type declaration validates compile-time use and runtime data. No duplicate schema system.",
        detailZh: "同一个 type 声明同时检查编译期使用和运行时数据，不再维护重复的 schema。",
    },
    {
        number: "03",
        title: "The Web belongs in the language.",
        titleZh: "Web 能力属于语言的一部分。",
        summary: "Components, JSX, controlled Look values, state, resources, routing, forms, and browser services share one coherent model.",
        summaryZh: "组件、JSX、受控 Look、状态、资源、路由、表单和浏览器服务共享同一套模型。",
        detail: "No virtual DOM and no React-style effect cleanup. mounted and cleanup remain explicit lifecycle siblings.",
        detailZh: "没有虚拟 DOM，也没有 React 式 effect 清理；mounted 与 cleanup 是明确、并列的生命周期。",
    },
]

export const learningSteps: List<LearningStep> = [
    {number: "01", title: "Read VelarScript", titleZh: "读懂 VelarScript", summary: "Learn values, functions, control flow, data types, classes, and modules through small examples.", summaryZh: "通过小型示例学习值、函数、控制流、数据类型、类和模块。", path: "/learn"},
    {number: "02", title: "Build a component", titleZh: "构建一个组件", summary: "Mix checked data, native JSX, controlled Look values, and direct state updates in one readable unit.", summaryZh: "把受检查的数据、原生 JSX、受控 Look 和直接状态更新放进一个易读单元。", path: "/docs/language"},
    {number: "03", title: "Ship a web app", titleZh: "交付 Web 应用", summary: "Add routes, forms, HTTP, storage, tests, and a production build through @velarscript/web.", summaryZh: "通过 @velarscript/web 加入路由、表单、HTTP、存储、测试和生产构建。", path: "/docs/web"},
]

export const examples: List<ExampleSummary> = [
    {
        slug: "counter",
        eyebrow: "State",
        eyebrowZh: "状态",
        title: "A counter without ceremony",
        titleZh: "没有仪式感的计数器",
        summary: "State is local, updates are ordinary assignments, and cleanup is not hidden inside an effect callback.",
        summaryZh: "状态保持局部，更新就是普通赋值，清理逻辑不会藏在 effect 回调里。",
        code: "component Counter:\n    state count = 0\n\n    return <button on:click={() => count += 1}>\n        Count: {count}\n    </button>",
        traits: ["state", "events", "JSX"],
        traitsZh: ["状态", "事件", "JSX"],
    },
    {
        slug: "profile",
        eyebrow: "Data",
        eyebrowZh: "数据",
        title: "One type, end to end",
        titleZh: "一个类型贯穿端到端",
        summary: "The same readable declaration checks your source and validates the response entering your application.",
        summaryZh: "同一个易读声明既检查源代码，也验证进入应用的响应数据。",
        code: "type Profile:\n    id: string\n    name: string\n\nasync def loadProfile() -> Profile:\n    return await http.get(\"/api/profile\").parse(Profile)",
        traits: ["types", "HTTP", "runtime validation"],
        traitsZh: ["类型", "HTTP", "运行时验证"],
    },
    {
        slug: "lifecycle",
        eyebrow: "Lifecycle",
        eyebrowZh: "生命周期",
        title: "Cleanup has one obvious home",
        titleZh: "清理逻辑只有一个明确归宿",
        summary: "Start browser subscriptions during setup and release them in the sibling cleanup block.",
        summaryZh: "在初始化时启动浏览器订阅，并在并列的 cleanup 块中释放。",
        code: "component OnlineStatus:\n    state online = environment().online\n    const stop = watchOnline(value => online = value)\n\n    cleanup:\n        stop()\n\n    return <span>{online ? \"Online\" : \"Offline\"}</span>",
        traits: ["cleanup", "browser", "reactivity"],
        traitsZh: ["清理", "浏览器", "响应式"],
    },
]

export def pageTitle(path: string) -> string:
    if path == "/":
        return "The Web, written clearly"
    if path == "/learn":
        return "Learn VelarScript"
    if path == "/docs":
        return "Documentation"
    if path == "/docs/getting-started":
        return "Getting started"
    if path == "/docs/project":
        return "Project and CLI"
    if path == "/docs/language":
        return "Syntax and values"
    if path == "/docs/language/types":
        return "Types and data"
    if path == "/docs/language/functions":
        return "Functions and flow"
    if path == "/docs/language/collections":
        return "Collections"
    if path == "/docs/language/classes":
        return "Classes"
    if path == "/docs/language/modules":
        return "Modules and JavaScript"
    if path == "/docs/web":
        return "Web framework"
    if path == "/docs/web/components":
        return "Components and JSX"
    if path == "/docs/web/reactivity":
        return "State and lifecycle"
    if path == "/docs/web/routing":
        return "Routing and metadata"
    if path == "/docs/web/data":
        return "Forms, HTTP and storage"
    if path == "/docs/web/browser":
        return "Browser capabilities"
    if path == "/docs/core":
        return "Core modules"
    if path == "/docs/testing":
        return "Testing and deployment"
    if path == "/examples":
        return "Examples"
    return "Page not found"
