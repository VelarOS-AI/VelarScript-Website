import {DocsNavGroup} from "@velarscript/docs-kit"

export type SiteRuntimeConfig:
    repositoryUrl: string
    releaseChannel: string
    languageVersion: string
    webApiVersion: string

export type NavItem:
    path: string
    label: string
    labelZh: string

export type Feature:
    number: string
    title: string
    titleZh: string
    summary: string
    summaryZh: string
    detail: string
    detailZh: string

export type LearningStep:
    number: string
    title: string
    titleZh: string
    summary: string
    summaryZh: string
    path: string

export type ExampleSummary:
    slug: string
    eyebrow: string
    eyebrowZh: string
    title: string
    titleZh: string
    summary: string
    summaryZh: string
    code: string
    traits: List<string>
    traitsZh: List<string>

