{
  "formatVersion": 2,
  "entry": "src/main.vel",
  "outDir": "dist-netlify",
  "publicDir": "public",
  "extensions": ["@velarscript/web"],
  "web": {
    "title": "Velar — The Web, written clearly",
    "base": "/",
    "publicConfig": {
      "repositoryUrl": "https://github.com/VelarOS-AI/VelarScript",
      "releaseChannel": "preview",
      "languageVersion": "0.9.0-dev",
      "webApiVersion": "0.8"
    },
    "build": {
      "sourceMaps": false
    },
    "security": {
      "contentSecurityPolicy": true,
      "connectSources": [],
      "imageSources": []
    },
    "deployment": {
      "spaFallback": true,
      "adapter": "netlify"
    }
  }
}
