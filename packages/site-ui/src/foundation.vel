export component FoundationFrame(children: WebNode):
    style global:
        :root {
            color-scheme: light;
            font-family: Inter, "SF Pro Display", "SF Pro Text", "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", ui-sans-serif, system-ui, sans-serif;
            color: #111216;
            background: #f7f5f0;
            --velar-paper: #f7f5f0;
            --velar-paper-pure: #fbfaf7;
            --velar-ink: #111216;
            --velar-ink-soft: #5e6066;
            --velar-ink-faint: #8b8d92;
            --velar-line: rgba(17, 18, 22, 0.14);
            --velar-line-strong: rgba(17, 18, 22, 0.26);
            --velar-sea: #447b9f;
            --velar-sea-soft: rgba(68, 123, 159, 0.12);
            --velar-success: #177744;
            --velar-danger: #a33a2b;
            --velar-page: clamp(20px, 4vw, 56px);
            --velar-content: 1320px;
            --velar-radius-small: 12px;
            --velar-radius-large: 20px;
            --velar-ease: cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-width: 320px;
            background: var(--velar-paper);
        }

        button, input, textarea, select {
            font: inherit;
        }

        button, a {
            -webkit-tap-highlight-color: transparent;
        }

        a {
            color: inherit;
        }

        ::selection {
            color: var(--velar-paper-pure);
            background: var(--velar-sea);
        }

        :focus-visible {
            outline: 3px solid rgba(68, 123, 159, 0.38);
            outline-offset: 3px;
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

    return <>{children}</>
