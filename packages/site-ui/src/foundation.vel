import {rgb, rgba} from "velar/look"

export const paper = rgb(247, 245, 240)
export const paperPure = rgb(251, 250, 247)
export const ink = rgb(17, 18, 22)
export const inkSoft = rgb(94, 96, 102)
export const inkFaint = rgb(110, 112, 117)
export const rule = rgba(17, 18, 22, 0.14)
export const ruleStrong = rgba(17, 18, 22, 0.26)
export const sea = rgb(63, 115, 150)
export const seaSoft = rgba(63, 115, 150, 0.12)
export const success = rgb(23, 119, 68)
export const danger = rgb(163, 58, 43)
export const codeInk = rgb(243, 240, 232)

export const foundationLook = look:
    minWidth = 320px
    minHeight = 100vh
    color = ink
    background = paper
    fontFamily = "Inter, SF Pro Display, SF Pro Text, PingFang SC, Noto Sans CJK SC, Microsoft YaHei, ui-sans-serif, system-ui, sans-serif"

    @selection:
        color = paperPure
        background = sea

export component FoundationFrame(children: WebNode):
    return <div look={foundationLook}>{children}</div>
