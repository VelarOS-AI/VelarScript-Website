import {Link, NavLink} from "velar/web"
import {Brand, Container, Eyebrow, SyntaxCode, Tag, foundationInk as ink, foundationInkFaint as inkFaint, foundationInkSoft as inkSoft, foundationPaperPure as paperPure, foundationRule as rule, foundationSea as sea, foundationSeaSoft as seaSoft, useLocale} from "@velarscript/site-ui"
import {Inline, Stack} from "@velarscript/ui"
import {border, clamp, color, minmax, rgb, spacing, tracks} from "velar/look"

export type DocsNavItem:
    path: string
    label: string
    labelZh: string

export type DocsNavGroup:
    label: string
    labelZh: string
    items: List<DocsNavItem>

export type DocsSection:
    id: string
    label: string
    labelZh: string

export type MemberRow:
    name: string
    signature: string
    summary: string
    summaryZh: string

// A code block's longest line does not wrap, which makes it the one thing on
// the site that can push a grid track wider than the viewport. That is why
// every single-column track here and on the pages is spelled
// tracks(minmax(0px, 1fr)) rather than tracks(1fr): a bare 1fr floors the track
// at its content's minimum width, and when the content is code that minimum is
// a whole line of it.
const codeBlockLook = look:
    overflow = "auto"
    maxWidth = 100%
    margin = 0
    padding = 20px
    border = border(1px, rule)
    borderRadius = 9px
    color = rgb(243, 240, 232)
    background = rgb(17, 18, 22)
    fontFamily = "SFMono-Regular, Consolas, Liberation Mono, monospace"
    fontSize = 0.9rem
    lineHeight = 1.72

export component CodeBlock(code: string):
    return <pre look={codeBlockLook}><SyntaxCode code={code} /></pre>

const docsLook = look:
    display = "grid"
    gridTemplateColumns = tracks(248px, minmax(0px, 1fr))
    minHeight = 100vh - 66px

    if viewport.width <= 840px:
        gridTemplateColumns = tracks(minmax(0px, 1fr))

const asideLook = look:
    position = "sticky"
    top = 66px
    alignSelf = "start"
    height = 100vh - 66px
    overflow = "auto"
    padding = spacing(30px, 22px)
    borderRight = border(1px, rule)
    background = paperPure

    if viewport.width <= 840px:
        position = "relative"
        top = 0px
        width = 100%
        height = "auto"
        paddingBlock = 18px
        borderRight = border(0px, color("transparent"))
        borderBottom = border(1px, rule)

const asideBrandLook = look:
    if viewport.width <= 840px:
        display = "none"

const navLook = look:
    display = "grid"
    gap = 24px
    marginTop = 28px

const navGroupLook = look:
    display = "grid"
    gap = 9px

const navLabelLook = look:
    paddingInline = 10px
    color = inkSoft
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.68rem
    fontWeight = 700
    letterSpacing = 0.11em
    textTransform = "uppercase"

const navItemsLook = look:
    display = "grid"
    gap = 5px

const navItemLook = look:
    display = "grid"

const navLinkLook = look:
    padding = spacing(8px, 10px)
    borderRadius = 8px
    color = inkSoft
    textDecoration = "none"

    if @current:
        color = ink
        background = seaSoft

const desktopNavLook = look:
    if viewport.width <= 840px:
        display = "none"

const mobileNavLook = look:
    display = "none"

    if viewport.width <= 840px:
        display = "block"

const mobileSummaryLook = look:
    padding = spacing(11px, 12px)
    border = border(1px, rule)
    borderRadius = 10px
    color = ink
    background = paperPure
    fontWeight = 700
    cursor = "pointer"

const mobileNavListLook = look:
    display = "grid"
    gap = 24px
    maxHeight = 62vh
    marginTop = 14px
    overflow = "auto"
    padding = 4px

const contentLook = look:
    minWidth = 0
    paddingBlock = clamp(48px, 8vw, 96px)

// Each label is chosen where it is rendered, not prepared in setup. A `const`
// that calls locale.text() reads the language once, at construction, and then
// holds that answer forever — the sidebar stayed in whichever language the page
// first loaded in while the body of the page switched around it. Reading inside
// the JSX puts the read in the render observer, which is what makes the switch
// reach it.
component DocsNavigation(items: List<DocsNavGroup>, label: string, mobile: bool = false):
    const locale = useLocale()
    return <nav class="nav" look={mobile ? mobileNavListLook : navLook} aria-label={label}>
        {items.map(group => <section key={group.label} class="nav-group" look={navGroupLook}><span class="nav-label" look={navLabelLook}>{locale.text(group.label, group.labelZh)}</span><div class="nav-items" look={navItemsLook}>{group.items.map(item => <span key={item.path} class="nav-item" look={navItemLook}><NavLink to={item.path} exact={true} look={navLinkLook}>{locale.text(item.label, item.labelZh)}</NavLink></span>)}</div></section>)}
    </nav>

export component DocsShell(items: List<DocsNavGroup>, children: WebNode):
    const locale = useLocale()
    return <div class="docs" look={docsLook}>
        <aside look={asideLook}>
            <div look={asideBrandLook}><Brand compact={true} /></div>
            <div class="desktop-docs-nav" look={desktopNavLook}>
                <DocsNavigation items={items} label={locale.text("Documentation sections", "文档章节")} />
            </div>
            <details class="mobile-docs-nav" look={mobileNavLook}>
                <summary look={mobileSummaryLook}>{locale.text("Browse documentation", "浏览文档目录")}</summary>
                <DocsNavigation
                    items={items}
                    label={locale.text("Mobile documentation sections", "移动端文档章节")}
                    mobile={true}
                />
            </details>
        </aside>
        <section class="content" look={contentLook}><Container narrow={true}>{children}</Container></section>
    </div>

const pageHeaderLook = look:
    display = "grid"
    gap = 16px
    paddingBottom = 44px
    borderBottom = border(1px, rule)

const pageTitleLook = look:
    maxWidth = 850px
    margin = 0
    fontSize = clamp(2rem, 4.4vw, 3.6rem)
    lineHeight = 1.06
    letterSpacing = -0.04em

const pageSummaryLook = look:
    maxWidth = 720px
    margin = 0
    color = inkSoft
    fontSize = clamp(1.02rem, 1.6vw, 1.16rem)
    lineHeight = 1.65

export component PageHeader(kicker: string, title: string, summary: string, tags: List<string> = []):
    return <header class="header" look={pageHeaderLook}>
        <Eyebrow label={kicker} />
        <h1 look={pageTitleLook}>{title}</h1>
        <p class="summary" look={pageSummaryLook}>{summary}</p>
        {tags.size > 0 ? <Inline>{tags.map(tag => <Tag key={tag} label={tag} />)}</Inline> : null}
    </header>

// Prose owns the vertical rhythm of a documentation page, and owns it alone.
// Every block below declares margin = 0, so this one gap decides how far apart
// any two blocks sit. Changing the rhythm of the whole site is changing this
// number, not forty hand-written margins spread across the pages.
const proseLook = look:
    display = "grid"
    gridTemplateColumns = tracks(minmax(0px, 1fr))
    gap = 22px
    paddingBlock = 42px
    color = inkSoft
    fontSize = 1.02rem
    lineHeight = 1.75

    if viewport.width <= 620px:
        paddingTop = 32px
        fontSize = 0.98rem

export component Prose(children: WebNode):
    return <article class="velar-docs-prose" look={proseLook}>{children}</article>

// Each block carries a class so that a browser test can ask the running page
// whether anything inside Prose was hand-written instead of taken from here.
// The browser test surface reads nodes, not computed style, so the class is how
// the rhythm's owner is made visible to the gate.
const paragraphLook = look:
    margin = 0

export component Paragraph(children: WebNode):
    return <p class="velar-docs-paragraph" look={paragraphLook}>{children}</p>

// The one exception to the uniform gap. A heading belongs to the section it
// opens, so the space above it has to be larger than the space below it;
// with a single gap the two would be equal and the heading would read as if it
// belonged to the paragraph before it. The extra breath is declared here, on
// the block that needs it, and nowhere else.
const sectionHeadingLook = look:
    margin = 0
    marginTop = 20px

export component SectionHeading(id: string, children: WebNode):
    return <h2 class="velar-docs-heading" look={sectionHeadingLook} id={id}>{children}</h2>

const subheadingLook = look:
    margin = 0
    marginTop = 10px

export component Subheading(children: WebNode):
    return <h3 class="velar-docs-subheading" look={subheadingLook}>{children}</h3>

const bulletListLook = look:
    display = "grid"
    gap = 8px
    margin = 0
    paddingInlineStart = 20px

export component BulletList(children: WebNode):
    return <ul class="velar-docs-points" look={bulletListLook}>{children}</ul>

// A gate note names the gate that keeps the block above it true, or says plainly
// that the block is a quoted excerpt with no gate behind it. It is a component
// because the alternative — a page handing its own look to Paragraph — is how a
// page reintroduces a spacing of its own, which is the defect this vocabulary
// exists to remove. It declares no margin: the rhythm stays Prose's. It keeps
// the paragraph class alongside its own, so the gate still sees an owned block.
const gateNoteLook = look:
    margin = 0
    padding = spacing(10px, 12px)
    borderLeft = border(2px, rule)
    color = inkFaint
    fontSize = 0.84rem
    lineHeight = 1.6

export component GateNote(children: WebNode):
    return <p class="velar-docs-paragraph velar-docs-gate-note" look={gateNoteLook}>{children}</p>

const calloutLook = look:
    padding = spacing(18px, 20px)
    borderLeft = border(3px, sea)
    borderRadius = 9px
    background = seaSoft

const calloutTitleLook = look:
    color = ink

export component Callout(title: string, children: WebNode):
    return <aside class="velar-docs-callout" look={calloutLook}>
        <Stack tight={true}><strong look={calloutTitleLook}>{title}</strong>{children}</Stack>
    </aside>

const sectionListLook = look:
    display = "grid"
    gap = 12px
    marginTop = 36px
    padding = spacing(18px, 20px)
    border = border(1px, rule)
    borderRadius = 10px
    background = paperPure

const sectionListLabelLook = look:
    color = inkSoft
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.68rem
    fontWeight = 700
    letterSpacing = 0.11em
    textTransform = "uppercase"

const sectionListItemsLook = look:
    display = "grid"
    gap = 7px
    margin = 0
    padding = 0
    listStyle = "none"

const sectionListLinkLook = look:
    color = sea
    fontSize = 0.95rem
    textDecoration = "none"

    if @hover:
        textDecoration = "underline"

export component SectionList(items: List<DocsSection>):
    const locale = useLocale()
    return <nav class="velar-docs-sections" look={sectionListLook} aria-label={locale.text("On this page", "本页内容")}>
        <span look={sectionListLabelLook}>{locale.text("On this page", "本页内容")}</span>
        <ul look={sectionListItemsLook}>
            {items.map(item => <li key={item.id}><a look={sectionListLinkLook} href={f"#{item.id}"}>{locale.text(item.label, item.labelZh)}</a></li>)}
        </ul>
    </nav>

const pagerLook = look:
    display = "grid"
    gridTemplateColumns = tracks(minmax(0px, 1fr), minmax(0px, 1fr))
    gap = 14px
    marginTop = 48px
    paddingTop = 32px
    borderTop = border(1px, rule)

    if viewport.width <= 620px:
        gridTemplateColumns = tracks(minmax(0px, 1fr))

def pagerLinkLook(forward: bool) -> Look:
    return look:
        display = "grid"
        gap = 6px
        padding = spacing(16px, 18px)
        border = border(1px, rule)
        borderRadius = 10px
        color = ink
        background = paperPure
        textDecoration = "none"

        if forward:
            textAlign = "end"

        if @hover:
            background = seaSoft

const pagerDirectionLook = look:
    color = inkFaint
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.68rem
    fontWeight = 700
    letterSpacing = 0.11em
    textTransform = "uppercase"

const pagerTitleLook = look:
    fontSize = 1.02rem
    fontWeight = 700

export component DocsPager(previous: DocsNavItem? = null, next: DocsNavItem? = null):
    const locale = useLocale()
    return <nav class="velar-docs-pager" look={pagerLook} aria-label={locale.text("Chapter navigation", "章节导航")}>
        {previous != null ? <Link to={previous.path} look={pagerLinkLook(false)}><span look={pagerDirectionLook}>{locale.text("Previous", "上一章")}</span><span look={pagerTitleLook}>{locale.text(previous.label, previous.labelZh)}</span></Link> : <span />}
        {next != null ? <Link to={next.path} look={pagerLinkLook(true)}><span look={pagerDirectionLook}>{locale.text("Next", "下一章")}</span><span look={pagerTitleLook}>{locale.text(next.label, next.labelZh)}</span></Link> : <span />}
    </nav>

const memberTableWrapLook = look:
    overflow = "auto"
    maxWidth = 100%
    margin = 0
    border = border(1px, rule)
    borderRadius = 10px

const memberTableLook = look:
    width = 100%
    fontSize = 0.92rem
    textAlign = "start"

const memberCaptionLook = look:
    padding = spacing(12px, 16px)
    borderBottom = border(1px, rule)
    color = inkSoft
    fontSize = 0.78rem
    fontWeight = 700
    textAlign = "start"

const memberHeadCellLook = look:
    padding = spacing(10px, 16px)
    borderBottom = border(1px, rule)
    color = inkFaint
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.68rem
    fontWeight = 700
    letterSpacing = 0.09em
    textAlign = "start"
    textTransform = "uppercase"

const memberNameCellLook = look:
    padding = spacing(12px, 16px)
    borderTop = border(1px, rule)
    color = ink
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.86rem
    fontWeight = 700
    textAlign = "start"
    whiteSpace = "nowrap"

const memberSignatureCellLook = look:
    padding = spacing(12px, 16px)
    borderTop = border(1px, rule)
    color = inkSoft
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.82rem

const memberSummaryCellLook = look:
    padding = spacing(12px, 16px)
    borderTop = border(1px, rule)
    color = inkSoft
    lineHeight = 1.6

export component MemberTable(rows: List<MemberRow>, caption: string = "", nameLabel: string = "", signatureLabel: string = "", summaryLabel: string = ""):
    const locale = useLocale()
    return <div class="velar-docs-members" look={memberTableWrapLook}>
        <table look={memberTableLook}>
            {caption != "" ? <caption look={memberCaptionLook}>{caption}</caption> : null}
            <thead>
                <tr>
                    <th scope="col" look={memberHeadCellLook}>
                        {nameLabel == "" ? locale.text("Name", "名称") : nameLabel}
                    </th>
                    <th scope="col" look={memberHeadCellLook}>
                        {signatureLabel == "" ? locale.text("Signature", "签名") : signatureLabel}
                    </th>
                    <th scope="col" look={memberHeadCellLook}>
                        {summaryLabel == "" ? locale.text("Summary", "说明") : summaryLabel}
                    </th>
                </tr>
            </thead>
            <tbody>
                {rows.map(row => <tr key={row.name}><th scope="row" look={memberNameCellLook}>{row.name}</th><td look={memberSignatureCellLook}>{row.signature}</td><td look={memberSummaryCellLook}>{locale.text(row.summary, row.summaryZh)}</td></tr>)}
            </tbody>
        </table>
    </div>
