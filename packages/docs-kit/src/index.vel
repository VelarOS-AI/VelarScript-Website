import {NavLink} from "velar/web"
import {Brand, Container, Eyebrow, SyntaxCode, Tag, foundationInk as ink, foundationInkSoft as inkSoft, foundationPaperPure as paperPure, foundationRule as rule, foundationSea as sea, foundationSeaSoft as seaSoft, useLocale} from "@velarscript/site-ui"
import {Inline, Stack} from "@velarscript/ui"

export type DocsNavItem:
    path: string
    label: string
    labelZh: string

export type DocsNavGroup:
    label: string
    labelZh: string
    items: List<DocsNavItem>

const codeBlockLook = look:
    overflow = "auto"
    maxWidth = 100%
    margin = 0
    padding = 20px
    border = border(1px, rule)
    borderRadius = 9px
    color = rgb(243, 240, 232)
    background = rgb(17, 18, 22)
    fontFamily = "SFMono-Regular, Consolas, Liberation Mono, monospace"
    fontSize = 0.9rem
    lineHeight = 1.72

export component CodeBlock(code: string):
    return <pre look={codeBlockLook}><SyntaxCode code={code} /></pre>

const docsLook = look:
    display = "grid"
    gridTemplateColumns = tracks(248px, minmax(0px, 1fr))
    minHeight = 100vh - 66px

    if viewport.width <= 840px:
        gridTemplateColumns = tracks(1fr)

const asideLook = look:
    position = "sticky"
    top = 66px
    alignSelf = "start"
    height = 100vh - 66px
    overflow = "auto"
    padding = spacing(30px, 22px)
    borderRight = border(1px, rule)
    background = paperPure

    if viewport.width <= 840px:
        position = "relative"
        top = 0px
        width = 100%
        height = "auto"
        paddingBlock = 18px
        borderRight = border(0px, color("transparent"))
        borderBottom = border(1px, rule)

const asideBrandLook = look:
    if viewport.width <= 840px:
        display = "none"

const navLook = look:
    display = "grid"
    gap = 24px
    marginTop = 28px

const navGroupLook = look:
    display = "grid"
    gap = 9px

const navLabelLook = look:
    paddingInline = 10px
    color = inkSoft
    fontFamily = "SFMono-Regular, Consolas, monospace"
    fontSize = 0.68rem
    fontWeight = 700
    letterSpacing = 0.11em
    textTransform = "uppercase"

const navItemsLook = look:
    display = "grid"
    gap = 5px

const navItemLook = look:
    display = "grid"

const navLinkLook = look:
    padding = spacing(8px, 10px)
    borderRadius = 8px
    color = inkSoft
    textDecoration = "none"

    if @current:
        color = ink
        background = seaSoft

const desktopNavLook = look:
    if viewport.width <= 840px:
        display = "none"

const mobileNavLook = look:
    display = "none"

    if viewport.width <= 840px:
        display = "block"

const mobileSummaryLook = look:
    padding = spacing(11px, 12px)
    border = border(1px, rule)
    borderRadius = 10px
    color = ink
    background = paperPure
    fontWeight = 700
    cursor = "pointer"

const mobileNavListLook = look:
    display = "grid"
    gap = 24px
    maxHeight = 62vh
    marginTop = 14px
    overflow = "auto"
    padding = 4px

const contentLook = look:
    minWidth = 0
    paddingBlock = clamp(48px, 8vw, 96px)

component DocsNavigation(items: List<DocsNavGroup>, label: string, mobile: bool = false):
    return <nav class="nav" look={mobile ? mobileNavListLook : navLook} aria-label={label}>{items.map(group => <section key={group.label} class="nav-group" look={navGroupLook}><span class="nav-label" look={navLabelLook}>{group.label}</span><div class="nav-items" look={navItemsLook}>{group.items.map(item => <span key={item.path} class="nav-item" look={navItemLook}><NavLink to={item.path} exact={true} look={navLinkLook}>{item.label}</NavLink></span>)}</div></section>)}</nav>

export component DocsShell(items: List<DocsNavGroup>, children: WebNode):
    const locale = useLocale()
    const localized = items.map(group => {
        label: locale.text(group.label, group.labelZh),
        labelZh: group.labelZh,
        items: group.items.map(item => {
            path: item.path,
            label: locale.text(item.label, item.labelZh),
            labelZh: item.labelZh,
        }),
    })
    return <div class="docs" look={docsLook}><aside look={asideLook}><div look={asideBrandLook}><Brand compact={true} /></div><div look={desktopNavLook}><DocsNavigation items={localized} label={locale.text("Documentation sections", "文档章节")} /></div><details class="mobile-docs-nav" look={mobileNavLook}><summary look={mobileSummaryLook}>{locale.text("Browse documentation", "浏览文档目录")}</summary><DocsNavigation items={localized} label={locale.text("Mobile documentation sections", "移动端文档章节")} mobile={true} /></details></aside><section class="content" look={contentLook}><Container narrow={true}>{children}</Container></section></div>

const pageHeaderLook = look:
    display = "grid"
    gap = 16px
    paddingBottom = 44px
    borderBottom = border(1px, rule)

const pageTitleLook = look:
    maxWidth = 850px
    margin = 0
    fontSize = clamp(3rem, 8vw, 6.5rem)
    lineHeight = 0.94
    letterSpacing = -0.065em

const pageSummaryLook = look:
    maxWidth = 720px
    margin = 0
    color = inkSoft
    fontSize = clamp(1.08rem, 2vw, 1.3rem)
    lineHeight = 1.65

export component PageHeader(kicker: string, title: string, summary: string, tags: List<string> = []):
    return <header class="header" look={pageHeaderLook}><Eyebrow label={kicker} /><h1 look={pageTitleLook}>{title}</h1><p class="summary" look={pageSummaryLook}>{summary}</p>{tags.size > 0 ? <Inline>{tags.map(tag => <Tag key={tag} label={tag} />)}</Inline> : null}</header>

const proseLook = look:
    paddingBlock = 42px
    color = inkSoft
    fontSize = 1.02rem
    lineHeight = 1.75

    if viewport.width <= 620px:
        paddingTop = 32px
        fontSize = 0.98rem

export component Prose(children: WebNode):
    return <article class="velar-docs-prose" look={proseLook}>{children}</article>

const calloutLook = look:
    padding = spacing(18px, 20px)
    borderLeft = border(3px, sea)
    borderRadius = 9px
    background = seaSoft

const calloutTitleLook = look:
    color = ink

export component Callout(title: string, children: WebNode):
    return <aside class="velar-docs-callout" look={calloutLook}><Stack tight={true}><strong look={calloutTitleLook}>{title}</strong>{children}</Stack></aside>
