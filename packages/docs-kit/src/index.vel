import {NavLink} from "velar/web"
import {Brand, Container, Eyebrow, Tag} from "@velarscript/site-ui"
import {Inline, Stack} from "@velarscript/ui"

export type DocsNavItem:
    path: string
    label: string

export type DocsNavGroup:
    label: string
    items: List<DocsNavItem>

export component DocsShell(items: List<DocsNavGroup>, children: WebNode):
    style:
        .docs {
            display: grid;
            grid-template-columns: 248px minmax(0, 1fr);
            min-height: calc(100vh - 66px);
        }

        aside {
            position: sticky;
            top: 66px;
            align-self: start;
            height: calc(100vh - 66px);
            overflow: auto;
            padding: 30px 22px;
            border-right: 1px solid var(--velar-line);
            background: var(--velar-paper-pure);
        }

        .nav, .nav-group, .nav-items {
            display: grid;
        }

        .nav {
            gap: 24px;
            margin-top: 28px;
        }

        .nav-group {
            gap: 9px;
        }

        .nav-label {
            padding-inline: 10px;
            color: var(--velar-ink-faint);
            font: 0.68rem "SFMono-Regular", Consolas, monospace;
            font-weight: 700;
            letter-spacing: 0.11em;
            text-transform: uppercase;
        }

        .nav-items {
            gap: 5px;
        }

        .nav-item {
            display: grid;
        }

        .nav-item a {
            padding: 8px 10px;
            border-radius: 8px;
            color: var(--velar-ink-soft);
            text-decoration: none;
        }

        .nav-item a[aria-current="page"] {
            color: var(--velar-ink);
            background: var(--velar-sea-soft);
        }

        .mobile-docs-nav {
            display: none;
        }

        .content {
            min-width: 0;
            padding: clamp(48px, 8vw, 96px) 0;
        }

        @media (max-width: 840px) {
            .docs {
                grid-template-columns: 1fr;
            }

            aside {
                position: static;
                width: 100%;
                height: auto;
                padding-block: 18px;
                border-right: 0;
                border-bottom: 1px solid var(--velar-line);
            }

            aside .brand {
                display: none;
            }

            .desktop-docs-nav {
                display: none;
            }

            .mobile-docs-nav {
                display: block;
            }

            .mobile-docs-nav summary {
                padding: 11px 12px;
                border: 1px solid var(--velar-line);
                border-radius: 10px;
                color: var(--velar-ink);
                background: var(--velar-paper-pure);
                font-weight: 700;
                cursor: pointer;
            }

            .mobile-docs-nav .nav {
                max-height: 62vh;
                margin-top: 14px;
                overflow: auto;
                padding: 4px;
            }

            .mobile-docs-nav .nav-group {
                gap: 6px;
            }
        }

    return <div class="docs"><aside><Brand compact={true} /><nav class="nav desktop-docs-nav" aria-label="Documentation sections">{items.map(group => <section key={group.label} class="nav-group"><span class="nav-label">{group.label}</span><div class="nav-items">{group.items.map(item => <span key={item.path} class="nav-item"><NavLink to={item.path} exact={true}>{item.label}</NavLink></span>)}</div></section>)}</nav><details class="mobile-docs-nav"><summary>Browse documentation</summary><nav class="nav" aria-label="Mobile documentation sections">{items.map(group => <section key={group.label} class="nav-group"><span class="nav-label">{group.label}</span><div class="nav-items">{group.items.map(item => <span key={item.path} class="nav-item"><NavLink to={item.path} exact={true}>{item.label}</NavLink></span>)}</div></section>)}</nav></details></aside><section class="content"><Container narrow={true}>{children}</Container></section></div>

export component PageHeader(kicker: string, title: string, summary: string, tags: List<string> = []):
    style:
        .header {
            display: grid;
            gap: 16px;
            padding-bottom: 44px;
            border-bottom: 1px solid var(--velar-line);
        }

        h1 {
            max-width: 850px;
            margin: 0;
            font-size: clamp(3rem, 8vw, 6.5rem);
            line-height: 0.94;
            letter-spacing: -0.065em;
        }

        .summary {
            max-width: 720px;
            margin: 0;
            color: var(--velar-ink-soft);
            font-size: clamp(1.08rem, 2vw, 1.3rem);
            line-height: 1.65;
        }

    return <header class="header"><Eyebrow label={kicker} /><h1>{title}</h1><p class="summary">{summary}</p>{tags.length > 0 ? <Inline>{tags.map(tag => <Tag key={tag} label={tag} />)}</Inline> : none}</header>

export component Prose(children: WebNode):
    style global:
        .velar-docs-prose {
            display: grid;
            gap: 22px;
            padding: 42px 0;
            color: var(--velar-ink-soft);
            font-size: 1.02rem;
            line-height: 1.75;
        }

        .velar-docs-prose h2, .velar-docs-prose h3, .velar-docs-prose p, .velar-docs-prose ul, .velar-docs-prose ol, .velar-docs-prose pre {
            margin: 0;
        }

        .velar-docs-prose h2, .velar-docs-prose h3 {
            scroll-margin-top: 92px;
        }

        .velar-docs-prose h2, .velar-docs-prose h3 {
            color: var(--velar-ink);
            letter-spacing: -0.035em;
        }

        .velar-docs-prose h2 {
            margin-top: 24px;
            font-size: clamp(1.8rem, 4vw, 2.7rem);
        }

        .velar-docs-prose h3 {
            font-size: 1.25rem;
        }

        .velar-docs-prose p, .velar-docs-prose li {
            max-width: 800px;
        }

        .velar-docs-prose ul, .velar-docs-prose ol {
            display: grid;
            gap: 8px;
            padding-left: 1.3rem;
        }

        .velar-docs-prose a {
            color: var(--velar-sea);
            font-weight: 680;
        }

        .velar-docs-prose code {
            font-family: "SFMono-Regular", Consolas, monospace;
            font-size: 0.9em;
        }

        .velar-docs-prose pre {
            overflow: auto;
            max-width: 100%;
            padding: 20px;
            border: 1px solid var(--velar-line);
            border-radius: var(--velar-radius-small);
            color: #f3f0e8;
            background: #111216;
        }

        .velar-docs-prose :not(pre) > code {
            padding: 0.16em 0.42em;
            border: 1px solid var(--velar-line);
            border-radius: 6px;
            color: var(--velar-ink);
            background: var(--velar-paper-pure);
        }

        .velar-docs-prose table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.94rem;
        }

        .velar-docs-prose th, .velar-docs-prose td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--velar-line);
            text-align: left;
            vertical-align: top;
        }

        .velar-docs-prose th {
            color: var(--velar-ink);
            background: var(--velar-paper-pure);
        }

        .velar-docs-prose .next-links {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-top: 30px;
        }

        .velar-docs-prose .next-links a {
            display: grid;
            gap: 5px;
            padding: 18px;
            border: 1px solid var(--velar-line);
            border-radius: var(--velar-radius-small);
            color: var(--velar-ink);
            background: var(--velar-paper-pure);
            text-decoration: none;
        }

        @media (max-width: 620px) {
            .velar-docs-prose {
                padding-top: 32px;
                font-size: 0.98rem;
            }

            .velar-docs-prose .next-links {
                grid-template-columns: 1fr;
            }
        }

    return <article class="velar-docs-prose">{children}</article>

export component Callout(title: string, children: WebNode):
    style global:
        .velar-docs-callout {
            padding: 18px 20px;
            border-left: 3px solid var(--velar-sea);
            border-radius: 0 var(--velar-radius-small) var(--velar-radius-small) 0;
            background: var(--velar-sea-soft);
        }

        .velar-docs-callout strong {
            color: var(--velar-ink);
        }

        .velar-docs-callout p {
            margin: 0;
        }

    return <aside class="velar-docs-callout"><Stack tight={true}><strong>{title}</strong>{children}</Stack></aside>
